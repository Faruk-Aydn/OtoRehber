@model IEnumerable<OtoRehber.Domain.DTOs.CarListDto>
@{
    ViewData["Title"] = "Araç Yönetimi";
}

<div class="mb-6 flex justify-between items-center flex-wrap gap-3">
    <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Araç Yönetim Paneli</h1>
        <p class="text-gray-500 mt-1">Sistemde kayıtlı tüm araçları buradan yönetebilirsiniz.</p>
    </div>
    <div class="flex items-center flex-wrap gap-2">
        <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg shadow transition flex items-center">
            <i class="fa-solid fa-plus mr-2"></i> Yeni Araç Ekle
        </a>
        <a asp-action="ImportFromYoutube" class="bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded-lg shadow transition flex items-center">
            <i class="fa-brands fa-youtube mr-2"></i> YouTube'dan AI İle Ekle
        </a>
        <a asp-controller="AdminReview" asp-action="Index" class="bg-gray-700 hover:bg-gray-800 text-white font-medium py-2 px-4 rounded-lg shadow transition flex items-center">
            <i class="fa-solid fa-comments mr-2"></i> Yorum Moderasyonu
        </a>
    </div>
</div>


<!-- Analitik Dashboard -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <!-- Toplam Araç -->
    <div class="backdrop-blur-md bg-white/80 dark:bg-gray-800/80 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white/40 dark:border-gray-700/50 p-6 flex items-center transition hover:-translate-y-1 hover:shadow-lg duration-300">
        <div class="p-3 rounded-full bg-blue-100/80 text-blue-600 mr-4 text-xl shadow-inner">
            <i class="fa-solid fa-car-side"></i>
        </div>
        <div>
            <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">Toplam Araç</p>
            <p class="text-3xl font-black text-gray-900 dark:text-white tracking-tight">@ViewBag.TotalCars</p>
        </div>
    </div>

    <!-- Toplam Yorum -->
    <div class="backdrop-blur-md bg-white/80 dark:bg-gray-800/80 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white/40 dark:border-gray-700/50 p-6 flex items-center transition hover:-translate-y-1 hover:shadow-lg duration-300">
        <div class="p-3 rounded-full bg-green-100/80 text-green-600 mr-4 text-xl shadow-inner">
            <i class="fa-solid fa-comments"></i>
        </div>
        <div>
            <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">Toplam Yorum</p>
            <p class="text-3xl font-black text-gray-900 dark:text-white tracking-tight">@ViewBag.TotalReviews</p>
        </div>
    </div>

    <!-- Ort. Güvenilirlik -->
    <div class="backdrop-blur-md bg-white/80 dark:bg-gray-800/80 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white/40 dark:border-gray-700/50 p-6 flex items-center transition hover:-translate-y-1 hover:shadow-lg duration-300">
        <div class="p-3 rounded-full bg-yellow-100/80 text-yellow-600 mr-4 text-xl shadow-inner">
            <i class="fa-solid fa-star"></i>
        </div>
        <div>
            <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">Ort. Güvenilirlik</p>
            <p class="text-3xl font-black text-gray-900 dark:text-white tracking-tight">@ViewBag.AvgReliability</p>
        </div>
    </div>

    <!-- En İyi Araç -->
    <div class="backdrop-blur-md bg-white/80 dark:bg-gray-800/80 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white/40 dark:border-gray-700/50 p-6 flex items-center transition hover:-translate-y-1 hover:shadow-lg duration-300">
        <div class="p-3 rounded-full bg-purple-100/80 text-purple-600 mr-4 text-xl shadow-inner">
            <i class="fa-solid fa-trophy"></i>
        </div>
        <div>
            <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">En Yüksek Puanlı</p>
            <p class="text-lg font-bold text-gray-900 dark:text-white truncate w-32" title="@ViewBag.TopCarName">@ViewBag.TopCarName</p>
        </div>
    </div>
</div>

<!-- Grafikler -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
        <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-4">Segment Dağılımı</h3>
        <div class="h-64"><canvas id="segmentChart"></canvas></div>
    </div>
    <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
        <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-4">En Çok Araç Bulunan Markalar</h3>
        <div class="h-64"><canvas id="brandChart"></canvas></div>
    </div>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden border border-gray-200 dark:border-gray-700 p-4">
    <div class="overflow-x-auto">
        <table id="carsTable" class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                        Marka / Model
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                        Motor / Segment
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                        Güvenilirlik
                    </th>
                    <th scope="col" class="px-6 py-3 text-center text-xs font-bold text-gray-500 uppercase tracking-wider">
                        İşlemler
                    </th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @foreach (var item in Model) {
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <div class="flex-shrink-0 h-10 w-10 bg-gray-100 rounded-full flex items-center justify-center text-gray-500 overflow-hidden border border-gray-200">
                                @if(!string.IsNullOrEmpty(item.ImageUrl)) {
                                    <img src="@item.ImageUrl" alt="@item.Brand" class="h-full w-full object-cover" />
                                } else {
                                    <i class="fa-solid fa-car"></i>
                                }
                            </div>
                            <div class="ml-4">
                                <div class="text-sm font-bold text-gray-900">@item.Brand @item.ModelName</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900">@item.Engine</div>
                        <div class="text-sm text-gray-500">@item.Segment Segmenti</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                            @item.ReliabilityScore / 10
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                        <div class="flex justify-center space-x-3">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-indigo-600 hover:text-indigo-900 transition" title="Düzenle">
                                <i class="fa-solid fa-pen-to-square text-lg"></i>
                            </a>
                            <a asp-controller="Car" asp-action="Details" asp-route-id="@item.Id" class="text-blue-600 hover:text-blue-900 transition" title="Görüntüle" target="_blank">
                                <i class="fa-solid fa-eye text-lg"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-red-600 hover:text-red-900 transition" title="Sil">
                                <i class="fa-solid fa-trash text-lg"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                }
                
                @if(!Model.Any()) {
                    <tr>
                        <td colspan="4" class="px-6 py-8 text-center text-gray-500">
                            <i class="fa-solid fa-inbox text-3xl mb-2 text-gray-300"></i>
                            <p>Henüz hiçbir araç eklenmemiş.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/css/responsive.dataTables.min.css" asp-append-version="true" />
    <style>
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 0.25em 0.75em;
            border-radius: 0.375rem;
        }
        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            padding: 0.25rem 0.5rem;
            margin-left: 0.5rem;
        }
        
        /* DataTables Dark Mode Overrides */
        html.dark .dataTables_wrapper .dataTables_length select {
            background-color: #374151;
            color: #f3f4f6;
            border: 1px solid #4b5563;
        }
        html.dark .dataTables_wrapper .dataTables_filter input {
            background-color: #374151;
            color: #f3f4f6;
            border: 1px solid #4b5563;
        }
        html.dark .dataTables_wrapper .dataTables_info,
        html.dark .dataTables_wrapper .dataTables_length,
        html.dark .dataTables_wrapper .dataTables_filter {
            color: #d1d5db;
        }
        html.dark table.dataTable tbody tr {
            background-color: transparent;
        }
        html.dark table.dataTable.stripe tbody tr.odd,
        html.dark table.dataTable.display tbody tr.odd {
            background-color: rgba(255, 255, 255, 0.05);
        }
        html.dark table.dataTable.hover tbody tr:hover,
        html.dark table.dataTable.display tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }
        html.dark .dataTables_wrapper .dataTables_paginate .paginate_button.current, 
        html.dark .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
            background-color: #374151;
            color: white !important;
            border-color: #4b5563;
        }
        html.dark .dataTables_wrapper .dataTables_paginate .paginate_button {
            color: #9ca3af !important;
        }
        html.dark .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background-color: #4b5563;
            color: white !important;
            border-color: #6b7280;
        }
        html.dark table.dataTable thead th, html.dark table.dataTable thead td {
            border-bottom: 1px solid #374151;
            color: #d1d5db;
        }
        html.dark table.dataTable.no-footer {
            border-bottom: 1px solid #374151;
        }
        /* Custom Table text color for Dark Mode */
        html.dark #carsTable {
            color: #e5e7eb;
        }
    </style>
    
    <!-- Chart.js & DataTables JS -->
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/js/dataTables.responsive.min.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            $('#carsTable').DataTable({
                responsive: true,
                language: {
                    url: '/lib/datatables/i18n/tr.json',
                },
                pageLength: 25,
                columnDefs: [
                    { orderable: false, targets: 3 } // İşlemler sütunu sıralanamaz
                ]
            });

            // Segment Chart
            const segmentCtx = document.getElementById('segmentChart').getContext('2d');
            new Chart(segmentCtx, {
                type: 'pie',
                data: {
                    labels: @Html.Raw(ViewBag.SegmentLabels),
                    datasets: [{
                        data: @Html.Raw(ViewBag.SegmentCounts),
                        backgroundColor: [
                            '#4f46e5', '#10b981', '#f59e0b', '#ef4444', 
                            '#8b5cf6', '#06b6d4', '#ec4899', '#f97316'
                        ],
                        borderWidth: 1
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            // Brand Chart
            const brandCtx = document.getElementById('brandChart').getContext('2d');
            new Chart(brandCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(ViewBag.BrandLabels),
                    datasets: [{
                        label: 'Araç Sayısı',
                        data: @Html.Raw(ViewBag.BrandCounts),
                        backgroundColor: '#3b82f6',
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });
        });
    </script>
}
