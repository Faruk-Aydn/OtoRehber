@model OtoRehber.Domain.DTOs.CarCreateDto
@{
    ViewData["Title"] = "Araç Düzenle";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
        <h1 class="text-3xl font-bold text-gray-900">Araç Düzenle: @Model.Brand @Model.ModelName</h1>
        <a asp-action="Index" class="text-gray-500 hover:text-primary transition flex items-center">
            <i class="fa-solid fa-arrow-left mr-2"></i> Listeye Dön
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-200">
        <form asp-action="Edit" enctype="multipart/form-data" class="p-6 md:p-8">
            <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4 text-sm"></div>
            <!-- ID Gizli Alanı -->
            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <!-- Marka -->
                <div>
                    <label asp-for="Brand" class="block text-sm font-medium text-gray-700 mb-2">Marka</label>
                    <input asp-for="Brand" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" />
                    <span asp-validation-for="Brand" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Model -->
                <div>
                    <label asp-for="ModelName" class="block text-sm font-medium text-gray-700 mb-2">Model</label>
                    <input asp-for="ModelName" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" />
                    <span asp-validation-for="ModelName" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Motor -->
                <div>
                    <label asp-for="Engine" class="block text-sm font-medium text-gray-700 mb-2">Motor</label>
                    <input asp-for="Engine" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" />
                    <span asp-validation-for="Engine" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <!-- Segment -->
                <div>
                    <label asp-for="Segment" class="block text-sm font-medium text-gray-700 mb-2">Segment</label>
                    <select asp-for="Segment" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5">
                        <option value="">Seçin…</option>
                        @foreach (var seg in OtoRehber.Domain.CarSegments.All)
                        {
                            <option value="@seg">@seg</option>
                        }
                    </select>
                    <span asp-validation-for="Segment" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="FuelType" class="block text-sm font-medium text-gray-700 mb-2">Yakıt tipi</label>
                    <select asp-for="FuelType" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5">
                        <option value="">Otomatik türet</option>
                        @foreach (var v in OtoRehber.Domain.CarSpecs.FuelTypes) { <option value="@v">@v</option> }
                    </select>
                </div>
                <div>
                    <label asp-for="Transmission" class="block text-sm font-medium text-gray-700 mb-2">Vites</label>
                    <select asp-for="Transmission" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5">
                        <option value="">Otomatik türet</option>
                        @foreach (var v in OtoRehber.Domain.CarSpecs.Transmissions) { <option value="@v">@v</option> }
                    </select>
                </div>
                <div>
                    <label asp-for="BodyType" class="block text-sm font-medium text-gray-700 mb-2">Kasa tipi</label>
                    <select asp-for="BodyType" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5">
                        <option value="">Belirtilmedi</option>
                        @foreach (var v in OtoRehber.Domain.CarSpecs.BodyTypes) { <option value="@v">@v</option> }
                    </select>
                </div>
                <div>
                    <label asp-for="Drivetrain" class="block text-sm font-medium text-gray-700 mb-2">Çekiş</label>
                    <select asp-for="Drivetrain" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5">
                        <option value="">Belirtilmedi</option>
                        @foreach (var v in OtoRehber.Domain.CarSpecs.Drivetrains) { <option value="@v">@v</option> }
                    </select>
                </div>
                <div>
                    <label asp-for="Condition" class="block text-sm font-medium text-gray-700 mb-2">Araç durumu</label>
                    <select asp-for="Condition" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5">
                        <option value="">İkinci El</option>
                        @foreach (var v in OtoRehber.Domain.CarSpecs.Conditions) { <option value="@v">@v</option> }
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="PowerHp" class="block text-sm font-medium text-gray-700 mb-2">Güç (HP)</label>
                        <input asp-for="PowerHp" type="number" min="0" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" placeholder="Otomatik türet" />
                    </div>
                    <div>
                        <label asp-for="EngineDisplacementCc" class="block text-sm font-medium text-gray-700 mb-2">Hacim (cm³)</label>
                        <input asp-for="EngineDisplacementCc" type="number" min="0" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" placeholder="Otomatik türet" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="YearStart" class="block text-sm font-medium text-gray-700 mb-2">Yıl (başlangıç)</label>
                        <input asp-for="YearStart" type="number" min="1950" max="2100" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" />
                    </div>
                    <div>
                        <label asp-for="YearEnd" class="block text-sm font-medium text-gray-700 mb-2">Yıl (bitiş)</label>
                        <input asp-for="YearEnd" type="number" min="1950" max="2100" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" />
                    </div>
                </div>

                <!-- Fiyat Skalası -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="MinPrice" class="block text-sm font-medium text-gray-700 mb-2">Minimum Fiyat</label>
                        <input asp-for="MinPrice" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" />
                        <span asp-validation-for="MinPrice" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="MaxPrice" class="block text-sm font-medium text-gray-700 mb-2">Maksimum Fiyat</label>
                        <input asp-for="MaxPrice" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" />
                        <span asp-validation-for="MaxPrice" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                </div>

                <!-- Güvenilirlik -->
                <div>
                    <label asp-for="ReliabilityScore" class="block text-sm font-medium text-gray-700 mb-2">Güvenilirlik Puanı (1-10)</label>
                    <input asp-for="ReliabilityScore" type="number" step="0.1" min="1" max="10" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" />
                    <span asp-validation-for="ReliabilityScore" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                
                <!-- Tahmini Masraf -->
                <div>
                    <label asp-for="EstimatedMaintenanceCostEUR" class="block text-sm font-medium text-gray-700 mb-2">Tahmini Yıllık Masraf (€)</label>
                    <input asp-for="EstimatedMaintenanceCostEUR" type="number" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" />
                    <span asp-validation-for="EstimatedMaintenanceCostEUR" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                
                <!-- Araç Görseli -->
                <div class="md:col-span-2 flex flex-col md:flex-row gap-4 items-start">
                    <div class="w-full md:w-2/3">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Yeni Araç Görseli Yükle (Değiştirmek İsterseniz)</label>
                        <input type="file" name="imageFile" accept="image/*" class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none" />
                        <p class="mt-1 text-xs text-gray-500">PNG, JPG veya WEBP (Max. 5MB).</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="w-full md:w-1/3">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Mevcut Görsel</label>
                            <img src="@Model.ImageUrl" alt="Mevcut Görsel" class="w-full h-32 object-cover rounded-lg border border-gray-200 shadow-sm" />
                        </div>
                    }
                </div>

                <!-- Resim URL -->
                <div class="md:col-span-2">
                    <label asp-for="ImageUrl" class="block text-sm font-medium text-gray-700 mb-2">Alternatif: Resim URL (Görsel Linki)</label>
                    <input asp-for="ImageUrl" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5" placeholder="https://example.com/arac-resmi.jpg" />
                    <span asp-validation-for="ImageUrl" class="text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- Uzman Özeti -->
            <div class="mb-8">
                <label asp-for="ExpertSummary" class="block text-sm font-medium text-gray-700 mb-2">Uzman Özeti</label>
                <textarea asp-for="ExpertSummary" rows="4" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5">@Model.ExpertSummary</textarea>
                <span asp-validation-for="ExpertSummary" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="flex justify-end pt-4 border-t border-gray-100 space-x-3">
                <a asp-action="Index" class="text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 focus:ring-4 focus:outline-none focus:ring-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 text-center transition">
                    İptal
                </a>
                <button type="submit" class="text-white bg-indigo-600 hover:bg-indigo-700 focus:ring-4 focus:outline-none focus:ring-indigo-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center transition flex items-center">
                    <i class="fa-solid fa-check mr-2"></i> Güncelle
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
