@model IEnumerable<OtoRehber.Domain.DTOs.CarListDto>
@{
    ViewData["Title"] = "Otomobil Vitrini";
    ViewData["Description"] = "İkinci el araba alırken daha doğru karar vermene yardımcı olur: kronik sorunlar, gerçek bakım maliyetleri, piyasa verileri ve OtoRehber Skoru'nu tek yerde incele.";
}

<!-- Hero -->
<section class="rounded-2xl bg-slate-900 border border-slate-800 overflow-hidden mb-10 px-5 py-10 sm:px-10 sm:py-16 text-center">
    <h1 class="text-2xl sm:text-4xl font-bold text-white tracking-tight max-w-3xl mx-auto">
        İkinci el araba alırken daha doğru karar vermene yardımcı olur
    </h1>
    <p class="text-sm sm:text-base text-slate-300 mt-4 max-w-xl mx-auto">
        Kronik sorunları, bakım maliyetlerini, piyasa verilerini ve OtoRehber Skoru'nu tek yerde incele.
    </p>

    <form method="get" action="/araclar" class="mt-8 max-w-xl mx-auto flex flex-col sm:flex-row gap-2.5">
        <div class="relative flex-grow">
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
            <input type="text" name="searchQuery" autocomplete="off"
                   class="w-full rounded-lg border border-slate-700 bg-slate-800 pl-11 pr-4 py-3 text-sm text-white placeholder:text-slate-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30"
                   placeholder="Marka veya model ara (Örn: Golf, Corolla)" />
        </div>
        <button type="submit" class="btn-primary btn-lg justify-center">
            <i class="fa-solid fa-arrow-right"></i> Ara
        </button>
    </form>
    <div class="mt-4 flex flex-wrap justify-center gap-2 text-xs">
        <a href="/araclar" class="text-slate-300 hover:text-white transition-colors">Tüm araçlar</a>
        <span class="text-slate-600">·</span>
        <a asp-controller="AiWizard" asp-action="Index" class="text-slate-300 hover:text-white transition-colors">AI Sihirbaz ile öneri al</a>
        <span class="text-slate-600">·</span>
        <a asp-controller="Compare" asp-action="Index" class="text-slate-300 hover:text-white transition-colors">Araç karşılaştır</a>
    </div>
</section>

<!-- İlan Analizi CTA -->
<a href="/ilan-analizi" class="card card-hover card-pad mb-10 flex items-center gap-4 group" data-aos="fade-up">
    <div class="w-12 h-12 rounded-xl bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-300 flex items-center justify-center shrink-0">
        <i class="fa-solid fa-magnifying-glass-dollar text-lg"></i>
    </div>
    <div class="flex-1">
        <h2 class="font-semibold text-content group-hover:text-brand-600 transition-colors">Bir ilan mı buldun? Mantıklı mı, bakalım.</h2>
        <p class="text-sm text-content-muted">İlandaki aracı seç, fiyat–kilometre–kronik sorunları OtoRehber verileriyle değerlendir.</p>
    </div>
    <i class="fa-solid fa-arrow-right text-content-muted group-hover:text-brand-600 group-hover:translate-x-1 transition-all"></i>
</a>

<!-- Leaderboard -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12">
    <div class="card overflow-hidden" data-aos="fade-up">
        <div class="px-5 py-4 border-b border-border flex items-center gap-2">
            <i class="fa-solid fa-fire text-content-muted"></i>
            <h2 class="section-title">En çok yorum alan araçlar</h2>
        </div>
        <div class="p-3">
            @if (ViewBag.TopReviewed != null && ((IList<dynamic>)ViewBag.TopReviewed).Count > 0)
            {
                <ul class="divide-y divide-border">
                    @{ int rank1 = 1; }
                    @foreach (var item in ViewBag.TopReviewed)
                    {
                        <li class="py-2.5 px-2 flex justify-between items-center hover:bg-surface-3 rounded-lg transition-colors">
                            <div class="flex items-center gap-3">
                                <span class="flex items-center justify-center w-6 h-6 rounded-full text-xs font-semibold @(rank1 <= 3 ? "bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-300" : "bg-surface-3 text-content-muted")">@rank1</span>
                                <span class="font-medium text-content text-sm">@item.Label</span>
                            </div>
                            <span class="text-xs text-content-muted">@item.Count yorum</span>
                        </li>
                        rank1++;
                    }
                </ul>
            }
            else
            {
                <div class="py-8 text-center text-content-muted text-sm">
                    <i class="fa-regular fa-comment-dots text-2xl mb-2 block"></i>
                    @(ViewBag.CommunityLimited == true
                        ? "Topluluk verisi henüz sınırlı."
                        : "Henüz yorum yapılmamış. İlk yorumu siz yapın!")
                </div>
            }
        </div>
    </div>

    <div class="card overflow-hidden" data-aos="fade-up">
        <div class="px-5 py-4 border-b border-border flex items-center gap-2">
            <i class="fa-solid fa-trophy text-content-muted"></i>
            <h2 class="section-title">En yüksek OtoRehber Skoru</h2>
        </div>
        <div class="p-3">
            @if (ViewBag.TopByScore != null)
            {
                <ul class="divide-y divide-border">
                    @{ int rank2 = 1; }
                    @foreach (var item in ViewBag.TopByScore)
                    {
                        <li class="py-2.5 px-2 flex justify-between items-center hover:bg-surface-3 rounded-lg transition-colors">
                            <div class="flex items-center gap-3">
                                <span class="flex items-center justify-center w-6 h-6 rounded-full text-xs font-semibold @(rank2 <= 3 ? "bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-300" : "bg-surface-3 text-content-muted")">@rank2</span>
                                <span class="font-medium text-content text-sm">@item.Label</span>
                            </div>
                            <span class="badge-warning"><i class="fa-solid fa-star"></i>@item.Score</span>
                        </li>
                        rank2++;
                    }
                </ul>
            }
        </div>
    </div>
</div>

<!-- Araç listesi -->
@{
    ViewData["Ratings"] = ViewBag.CarRatings;
    ViewData["Scores"] = ViewBag.CarScores;
    ViewData["ShowCompare"] = true;
}
<div class="flex items-center justify-between mb-4">
    <h2 class="section-title">Araçlar</h2>
    <a href="/araclar" class="text-sm text-brand-600 hover:underline">Gelişmiş filtre →</a>
</div>
<div id="car-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    @foreach (var car in Model)
    {
        <partial name="_CarCard" model="car" />
    }
</div>

@if (!Model.Any())
{
    <div class="card card-pad text-center py-16 mt-6">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-surface-3 mb-4">
            <i class="fa-solid fa-car-burst text-2xl text-content-muted"></i>
        </div>
        <h3 class="text-lg font-semibold text-content mb-2">Araç bulunamadı</h3>
        <p class="text-content-muted max-w-md mx-auto">Arama kriterlerinize uygun bir araç sistemimizde yer almıyor.</p>
        <a asp-action="Index" class="btn-secondary btn-sm mt-6"><i class="fa-solid fa-rotate-left"></i> Filtreleri temizle</a>
    </div>
}

@if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
{
    int currentPage = (int)ViewBag.CurrentPage;
    int totalPages  = (int)ViewBag.TotalPages;
    // Home'da marka/segment filtre formu yok (hero = sade arama → /araclar). Sayfalama sadece arama + sıralama taşır.
    string searchQuery = ViewData["CurrentSearch"]?.ToString() ?? "";
    string sortBy      = ViewData["CurrentSort"]?.ToString()   ?? "";
    int startPage = Math.Max(1, currentPage - 2);
    int endPage   = Math.Min(totalPages, currentPage + 2);

    <nav class="mt-12 mb-4 flex items-center justify-center gap-1.5 flex-wrap" aria-label="Sayfalama">
        @if (currentPage > 1)
        {
            <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchQuery="@searchQuery" asp-route-sortBy="@sortBy"
               class="w-10 h-10 flex items-center justify-center rounded-lg border border-border bg-surface text-content-muted hover:text-content hover:border-brand-300 transition-colors text-sm">
                <i class="fa-solid fa-angle-left"></i>
            </a>
        }
        @if (startPage > 1)
        {
            <span class="w-8 text-center text-content-muted text-sm select-none">…</span>
        }
        @for (int p = startPage; p <= endPage; p++)
        {
            if (p == currentPage)
            {
                <span class="w-10 h-10 flex items-center justify-center rounded-lg bg-brand-600 text-white text-sm font-semibold select-none">@p</span>
            }
            else
            {
                <a asp-action="Index" asp-route-page="@p" asp-route-searchQuery="@searchQuery" asp-route-sortBy="@sortBy"
                   class="w-10 h-10 flex items-center justify-center rounded-lg border border-border bg-surface text-content text-sm font-medium hover:border-brand-300 transition-colors">@p</a>
            }
        }
        @if (endPage < totalPages)
        {
            <span class="w-8 text-center text-content-muted text-sm select-none">…</span>
        }
        @if (currentPage < totalPages)
        {
            <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchQuery="@searchQuery" asp-route-sortBy="@sortBy"
               class="w-10 h-10 flex items-center justify-center rounded-lg border border-border bg-surface text-content-muted hover:text-content hover:border-brand-300 transition-colors text-sm">
                <i class="fa-solid fa-angle-right"></i>
            </a>
        }
    </nav>
}

<!-- Kıyaslama widget'ı -->
<div id="compare-widget" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-6 py-4 rounded-full shadow-xl flex items-center gap-5 transition-all duration-300 translate-y-32 opacity-0 z-50 border border-slate-700">
    <div class="flex flex-col">
        <span class="text-sm font-semibold tracking-wide">Kıyaslama modu</span>
        <span id="compare-count" class="text-xs text-slate-400">0 / 2 seçildi</span>
    </div>
    <button id="compare-btn" class="bg-brand-600 hover:bg-brand-700 px-5 py-2 rounded-full font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2" disabled>
        <i class="fa-solid fa-code-compare"></i> Karşılaştır
    </button>
</div>

@section Scripts {
    <script>
        (function () {
            const params = new URLSearchParams(window.location.search);
            if (params.has('page') && parseInt(params.get('page')) > 1) {
                const grid = document.getElementById('car-grid');
                if (grid) setTimeout(() => grid.scrollIntoView({ behavior: 'smooth', block: 'start' }), 80);
            }
        })();
        document.addEventListener('DOMContentLoaded', function () {
            const checkboxes = document.querySelectorAll('.compare-checkbox');
            const widget = document.getElementById('compare-widget');
            const compareBtn = document.getElementById('compare-btn');
            const countText = document.getElementById('compare-count');
            let selectedCars = [];
            checkboxes.forEach(cb => {
                cb.addEventListener('change', function () {
                    const carId = this.value;
                    if (this.checked) {
                        if (selectedCars.length >= 2) { this.checked = false; alert('En fazla 2 araç karşılaştırabilirsiniz!'); return; }
                        selectedCars.push(carId);
                    } else {
                        selectedCars = selectedCars.filter(id => id !== carId);
                    }
                    widget.classList.toggle('translate-y-32', selectedCars.length === 0);
                    widget.classList.toggle('opacity-0', selectedCars.length === 0);
                    countText.textContent = `${selectedCars.length} / 2 seçildi`;
                    compareBtn.disabled = selectedCars.length !== 2;
                });
            });
            compareBtn.addEventListener('click', function () {
                if (selectedCars.length === 2)
                    window.location.href = `/Compare/Result?car1Id=${selectedCars[0]}&car2Id=${selectedCars[1]}`;
            });
        });
    </script>
}
