@model IEnumerable<OtoRehber.Domain.Entities.UserGarage>

@{
    ViewData["Title"] = "Benim Garajım";
}

<div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="mb-8" data-aos="fade-down">
        <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white flex items-center gap-3">
            <i class="fa-solid fa-heart text-red-500"></i> Benim Garajım
        </h1>
        <p class="text-gray-500 dark:text-gray-400 mt-2">Favoriye eklediğiniz araçları buradan yönetebilirsiniz.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 p-12 text-center" data-aos="fade-up">
            <div class="w-24 h-24 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-6 text-gray-400 dark:text-gray-500">
                <i class="fa-solid fa-heart-crack text-4xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Garajınız Boş</h2>
            <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-md mx-auto">Henüz hiçbir aracı favorilerinize eklememişsiniz. Hemen vitrindeki araçları inceleyip beğendiklerinizi garajınıza ekleyebilirsiniz.</p>
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center px-6 py-3 text-sm font-bold text-white bg-indigo-600 rounded-xl hover:bg-indigo-700 transition-colors shadow-md hover:shadow-lg">
                <i class="fa-solid fa-magnifying-glass mr-2"></i> Araçları İncele
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            @foreach (var item in Model)
            {
                <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-xl overflow-hidden hover:-translate-y-1 transition-all duration-300 flex flex-col h-full border border-gray-200 dark:border-gray-700" data-aos="fade-up">
                    
                    <div class="relative h-48 bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-800 flex items-center justify-center text-gray-400 dark:text-gray-500 group border-b border-gray-100 dark:border-gray-700">
                        <i class="fa-solid fa-car-side text-6xl group-hover:scale-110 transition-transform duration-300"></i>
                        <button onclick="toggleGarage(@item.CarId, this)" class="absolute top-4 right-4 bg-white/90 dark:bg-gray-900/90 w-10 h-10 rounded-full flex items-center justify-center shadow-sm hover:scale-110 transition-transform text-red-500 hover:text-gray-400 z-10" title="Garajdan Çıkar">
                            <i class="fa-solid fa-heart text-lg"></i>
                        </button>
                    </div>

                    <div class="p-6 flex-grow flex flex-col">
                        <div class="flex justify-between items-start mb-2">
                            <div>
                                <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-1 block">@item.Car.Brand</span>
                                <h3 class="text-xl font-bold text-gray-900 dark:text-white leading-tight">@item.Car.ModelName</h3>
                            </div>
                        </div>

                        <div class="mt-4 flex flex-wrap gap-2 mb-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-300">
                                @item.Car.Segment Segment
                            </span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-400">
                                <i class="fa-solid fa-star text-green-600 dark:text-green-500 mr-1 text-[10px]"></i> @item.Car.ReliabilityScore
                            </span>
                        </div>
                        
                        <div class="mt-auto pt-4 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between">
                            <span class="text-sm font-bold text-gray-900 dark:text-gray-200">@item.Car.MinPrice.ToString("N0") - @item.Car.MaxPrice.ToString("N0") TL</span>
                            <a asp-controller="Car" asp-action="Details" asp-route-id="@item.CarId" class="text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 text-sm font-medium flex items-center group-hover:underline">
                                Detaylar <i class="fa-solid fa-arrow-right ml-1 text-xs"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        async function toggleGarage(carId, btnElement) {
            try {
                const response = await fetch('/Garage/Toggle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: carId
                });

                if (response.ok) {
                    const data = await response.json();
                    
                    // Garaj sayfasındaysak ve çıkartıldıysa kartı gizle
                    if (!data.added) {
                        const card = btnElement.closest('.bg-white');
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.9)';
                        setTimeout(() => {
                            card.remove();
                            // Eğer son araç silindiyse sayfayı yenile (boş durumunu göstermek için)
                            if(document.querySelectorAll('.bg-white.rounded-2xl').length === 0) {
                                window.location.reload();
                            }
                        }, 300);
                    }
                } else if (response.status === 401) {
                    window.location.href = '/Account/Login';
                }
            } catch (error) {
                console.error("Hata:", error);
            }
        }
    </script>
}
