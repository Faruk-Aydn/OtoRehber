@model IEnumerable<OtoRehber.Domain.Entities.UserGarage>

@{
    ViewData["Title"] = "Benim Garajım";
}

<div class="max-w-7xl mx-auto py-10">
    <div class="mb-8" data-aos="fade-down">
        <h1 class="text-2xl sm:text-3xl font-bold text-content tracking-tight flex items-center gap-3">
            <i class="fa-solid fa-heart text-red-500"></i> Benim garajım
        </h1>
        <p class="text-content-muted mt-2">Favoriye eklediğiniz araçları buradan yönetebilirsiniz.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-pad text-center py-12" data-aos="fade-up">
            <div class="w-20 h-20 bg-surface-3 rounded-full flex items-center justify-center mx-auto mb-6 text-content-muted">
                <i class="fa-solid fa-heart-crack text-3xl"></i>
            </div>
            <h2 class="text-xl font-semibold text-content mb-2">Garajınız boş</h2>
            <p class="text-content-muted mb-8 max-w-md mx-auto">Henüz hiçbir aracı favorilerinize eklememişsiniz. Araçları inceleyip beğendiklerinizi garajınıza ekleyebilirsiniz.</p>
            <a href="/araclar" class="btn-primary"><i class="fa-solid fa-magnifying-glass"></i> Araçları incele</a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="garage-grid">
            @foreach (var item in Model)
            {
                <div class="garage-card card card-hover overflow-hidden flex flex-col h-full transition-all duration-300" data-aos="fade-up">
                    <div class="relative h-40 bg-surface-3 flex items-center justify-center text-content-muted/40 border-b border-border">
                        @if (!string.IsNullOrEmpty(item.Car.ImageUrl))
                        {
                            <img src="@item.Car.ImageUrl" alt="@item.Car.Brand @item.Car.ModelName" class="absolute inset-0 w-full h-full object-cover" />
                        }
                        else
                        {
                            <i class="fa-solid fa-car-side text-5xl"></i>
                        }
                        <button onclick="toggleGarage(@item.CarId, this)" class="absolute top-3 right-3 bg-surface/95 w-9 h-9 rounded-full flex items-center justify-center border border-border text-red-500 hover:text-content-muted transition-colors z-10" title="Garajdan çıkar">
                            <i class="fa-solid fa-heart"></i>
                        </button>
                    </div>

                    <div class="p-5 flex-grow flex flex-col">
                        <span class="text-xs font-semibold text-content-muted uppercase tracking-wider">@item.Car.Brand</span>
                        <h3 class="text-lg font-semibold text-content leading-tight">@item.Car.ModelName</h3>

                        <div class="mt-3 flex flex-wrap gap-2">
                            <span class="badge-muted">@item.Car.Segment segmenti</span>
                            <span class="badge-warning"><i class="fa-solid fa-star"></i> @item.Car.ReliabilityScore</span>
                        </div>

                        <div class="mt-auto pt-4 border-t border-border flex items-center justify-between gap-2">
                            <span class="text-sm font-semibold text-content">@item.Car.MinPrice.ToString("N0") – @item.Car.MaxPrice.ToString("N0") ₺</span>
                            <a asp-controller="Car" asp-action="Details" asp-route-id="@item.CarId" class="text-brand-600 hover:underline text-sm font-medium flex items-center gap-1">
                                Detaylar <i class="fa-solid fa-arrow-right text-xs"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        async function toggleGarage(carId, btnElement) {
            try {
                const response = await postJson('/Garage/Toggle', carId);
                if (response.ok) {
                    const data = await response.json();
                    if (!data.added) {
                        const card = btnElement.closest('.garage-card');
                        card.style.opacity = '0';
                        card.style.transform = 'scale(0.95)';
                        setTimeout(() => {
                            card.remove();
                            if (document.querySelectorAll('.garage-card').length === 0) window.location.reload();
                        }, 300);
                    }
                } else if (response.status === 401) {
                    window.location.href = '/Account/Login';
                }
            } catch (error) {
                console.error("Hata:", error);
            }
        }
    </script>
}
