@model IEnumerable<OtoRehber.Domain.DTOs.CarListDto>
@{
    ViewData["Ratings"] = ViewBag.CarRatings;
    ViewData["ShowCompare"] = false;
    var cs = ViewData["CurrentSearch"] as string;
    var cseg = ViewData["CurrentSegment"] as string[] ?? Array.Empty<string>();
    var cbr = ViewData["CurrentBrand"] as string[] ?? Array.Empty<string>();
    var csort = ViewData["CurrentSort"] as string;
    var cpMin = ViewData["CurrentPriceMin"] as long?;
    var cpMax = ViewData["CurrentPriceMax"] as long?;
    var cScore = ViewData["CurrentMinScore"] as double?;

    var routeBase = new Dictionary<string, string?>
    {
        ["searchQuery"] = cs,
        ["sortBy"] = csort,
        ["priceMin"] = cpMin?.ToString(),
        ["priceMax"] = cpMax?.ToString(),
        ["minScore"] = cScore?.ToString(System.Globalization.CultureInfo.InvariantCulture),
    };
    
    // For pagination we need a string representation that includes arrays, but Dictionary<string, string> doesn't support arrays nicely. 
    // We will build query strings manually for chips and pagination.
    
    var hasAnyFilter = !string.IsNullOrEmpty(cs) || cbr.Any() || cseg.Any()
        || cpMin is > 0 || cpMax is > 0 || cScore is > 0;
        
    string BuildQuery(Dictionary<string, string?> dict, string[]? brands = null, string[]? segments = null)
    {
        var q = new List<string>();
        foreach (var kv in dict)
        {
            if (!string.IsNullOrEmpty(kv.Value))
                q.Add($"{kv.Key}={Uri.EscapeDataString(kv.Value)}");
        }
        if (brands != null)
        {
            foreach (var b in brands)
                q.Add($"brand={Uri.EscapeDataString(b)}");
        }
        if (segments != null)
        {
            foreach (var s in segments)
                q.Add($"segment={Uri.EscapeDataString(s)}");
        }
        return "?" + string.Join("&", q);
    }
    
    var baseQueryWithArrays = BuildQuery(routeBase, cbr, cseg);
}

<div class="max-w-7xl mx-auto py-8">
    <div class="mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold text-content tracking-tight">Tüm araçlar</h1>
        <p class="text-content-muted mt-1">@ViewBag.Total araç bulundu</p>
    </div>

    <div class="lg:grid lg:grid-cols-[280px_1fr] lg:gap-8">
        <!-- Filtre paneli -->
        <aside class="mb-6 lg:mb-0">
            <details class="lg:hidden card mb-4" @(hasAnyFilter ? "open" : "")>
                <summary class="card-pad cursor-pointer font-semibold text-content flex items-center justify-between">
                    <span><i class="fa-solid fa-sliders mr-2 text-content-muted"></i>Filtreler</span>
                    <i class="fa-solid fa-chevron-down text-content-muted text-sm"></i>
                </summary>
                <div class="px-5 pb-5">
                    @await Html.PartialAsync("_CatalogFilterForm")
                </div>
            </details>
            <div class="hidden lg:block lg:sticky lg:top-20">
                <div class="card card-pad">
                    <h2 class="section-title mb-4"><i class="fa-solid fa-sliders mr-2 text-content-muted"></i>Filtreler</h2>
                    @await Html.PartialAsync("_CatalogFilterForm")
                </div>
            </div>
        </aside>

        <!-- Sonuçlar -->
        <div>
            @if (hasAnyFilter)
            {
                <div class="flex flex-wrap items-center gap-2 mb-5">
                    @if (!string.IsNullOrEmpty(cs))
                    {
                        var d = new Dictionary<string, string?>(routeBase) { ["searchQuery"] = null };
                        <a href="/araclar@(BuildQuery(d, cbr, cseg))" class="chip">Arama: @cs <span aria-hidden="true">✕</span></a>
                    }
                    @foreach (var brand in cbr)
                    {
                        var newBrands = cbr.Where(b => b != brand).ToArray();
                        <a href="/araclar@(BuildQuery(routeBase, newBrands, cseg))" class="chip">Marka: @brand <span aria-hidden="true">✕</span></a>
                    }
                    @foreach (var segment in cseg)
                    {
                        var newSegments = cseg.Where(s => s != segment).ToArray();
                        <a href="/araclar@(BuildQuery(routeBase, cbr, newSegments))" class="chip">Segment: @segment <span aria-hidden="true">✕</span></a>
                    }
                    @if (cpMin is > 0)
                    {
                        var d = new Dictionary<string, string?>(routeBase) { ["priceMin"] = null };
                        <a href="/araclar@(BuildQuery(d, cbr, cseg))" class="chip">Min @cpMin.Value.ToString("N0") ₺ <span aria-hidden="true">✕</span></a>
                    }
                    @if (cpMax is > 0)
                    {
                        var d = new Dictionary<string, string?>(routeBase) { ["priceMax"] = null };
                        <a href="/araclar@(BuildQuery(d, cbr, cseg))" class="chip">Maks @cpMax.Value.ToString("N0") ₺ <span aria-hidden="true">✕</span></a>
                    }
                    @if (cScore is > 0)
                    {
                        var d = new Dictionary<string, string?>(routeBase) { ["minScore"] = null };
                        <a href="/araclar@(BuildQuery(d, cbr, cseg))" class="chip">Puan @cScore.Value.ToString("0.#")+ <span aria-hidden="true">✕</span></a>
                    }
                    <a href="/araclar" class="text-xs font-medium text-brand-600 hover:underline ml-1">Tümünü temizle</a>
                </div>
            }

            @if (Model.Any())
            {
                <div id="car-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                    @foreach (var car in Model)
                    {
                        <partial name="_CarCard" model="car" />
                    }
                </div>
            }
            else
            {
                <div class="card card-pad text-center py-16">
                    <i class="fa-solid fa-car-burst text-3xl text-content-muted mb-3"></i>
                    <p class="text-content-muted">Filtrenize uygun araç bulunamadı.</p>
                    <a href="/araclar" class="btn-secondary btn-sm mt-4">Filtreleri temizle</a>
                </div>
            }

            @if (ViewBag.TotalPages > 1)
            {
                <nav class="mt-8 flex justify-center gap-1.5 flex-wrap" aria-label="Sayfalama">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        var pageRoute = new Dictionary<string, string?>(routeBase) { ["page"] = i.ToString() };
                        var pageUrl = "/araclar" + BuildQuery(pageRoute, cbr, cseg);
                        if (i == ViewBag.Page)
                        {
                            <span class="w-10 h-10 flex items-center justify-center rounded-lg bg-brand-600 text-white text-sm font-semibold">@i</span>
                        }
                        else
                        {
                            <a href="@pageUrl" class="w-10 h-10 flex items-center justify-center rounded-lg border border-border bg-surface text-content text-sm font-medium hover:border-brand-300 transition-colors">@i</a>
                        }
                    }
                </nav>
            }
        </div>
    </div>
</div>
