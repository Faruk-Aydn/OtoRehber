@using OtoRehber.Services
@model IEnumerable<OtoRehber.Domain.DTOs.CarListDto>
@{
    ViewData["Ratings"] = ViewBag.CarRatings;
    ViewData["ShowCompare"] = false;
    var f = (ViewBag.Filter as CarFilter) ?? new CarFilter();

    // Tüm aktif filtreyi (anahtar, değer) çiftleri olarak topla — çipler ve sayfalama bundan üretilir.
    var pairs = new List<(string Key, string Val, string Label)>();
    void AddArr(string key, string[]? arr, string labelPrefix)
    {
        foreach (var v in CarFilter.Clean(arr))
            pairs.Add((key, v, $"{labelPrefix}: {v}"));
    }
    void AddNum(string key, long? val, string label)
    {
        if (val is > 0) pairs.Add((key, val.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), label));
    }
    if (!string.IsNullOrWhiteSpace(f.SearchQuery)) pairs.Add(("searchQuery", f.SearchQuery.Trim(), $"Arama: {f.SearchQuery.Trim()}"));
    AddArr("brand", f.Brand, "Marka");
    AddArr("fuel", f.Fuel, "Yakıt");
    AddArr("transmission", f.Transmission, "Vites");
    AddArr("bodyType", f.BodyType, "Kasa");
    AddArr("drivetrain", f.Drivetrain, "Çekiş");
    foreach (var id in CarFilter.Clean(f.Power))
        pairs.Add(("power", id, $"Güç: {OtoRehber.Domain.CarSpecs.PowerLabel(id) ?? id}"));
    foreach (var id in CarFilter.Clean(f.Cc))
        pairs.Add(("cc", id, $"Hacim: {OtoRehber.Domain.CarSpecs.CcLabel(id) ?? id}"));
    AddNum("priceMin", f.PriceMin, $"Min {f.PriceMin?.ToString("N0")} ₺");
    AddNum("priceMax", f.PriceMax, $"Maks {f.PriceMax?.ToString("N0")} ₺");
    AddNum("minScore", (long?)(f.MinScore is > 0 ? (long)f.MinScore : null), $"Puan {f.MinScore?.ToString("0.#")}+");
    AddNum("yearMin", f.YearMin, $"{f.YearMin} ve sonrası");
    AddNum("yearMax", f.YearMax, $"{f.YearMax} ve öncesi");

    string Build(IEnumerable<(string Key, string Val, string Label)> ps, int? page = null)
    {
        var parts = ps.Select(p => $"{p.Key}={Uri.EscapeDataString(p.Val)}").ToList();
        if (!string.IsNullOrEmpty(f.SortBy)) parts.Add($"sortBy={Uri.EscapeDataString(f.SortBy)}");
        if (page is > 1) parts.Add($"page={page}");
        return parts.Count == 0 ? "" : "?" + string.Join("&", parts);
    }
}

<div class="max-w-7xl mx-auto py-8">
    <div class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-content tracking-tight">Tüm araçlar</h1>
            <p class="text-content-muted mt-1">@ViewBag.Total araç bulundu</p>
        </div>
        <form method="get" action="/araclar" class="flex items-center gap-2 shrink-0">
            @foreach (var p in pairs)
            {
                <input type="hidden" name="@p.Key" value="@p.Val" />
            }
            <label for="sort" class="text-sm text-content-muted whitespace-nowrap">Sırala</label>
            <select id="sort" name="sortBy" class="select py-1.5 text-sm w-auto" onchange="this.form.submit()">
                <option value="" selected="@string.IsNullOrEmpty(f.SortBy)">En yeni</option>
                <option value="score_desc" selected="@(f.SortBy == "score_desc")">Güvenilirlik (yüksek → düşük)</option>
                <option value="score_asc" selected="@(f.SortBy == "score_asc")">Güvenilirlik (düşük → yüksek)</option>
                <option value="price_asc" selected="@(f.SortBy == "price_asc")">Fiyat (artan)</option>
                <option value="price_desc" selected="@(f.SortBy == "price_desc")">Fiyat (azalan)</option>
                <option value="year_desc" selected="@(f.SortBy == "year_desc")">Model yılı (yeni → eski)</option>
            </select>
        </form>
    </div>

    <div class="lg:grid lg:grid-cols-[280px_1fr] lg:gap-8">
        <aside class="mb-6 lg:mb-0">
            <details class="lg:hidden card mb-4"@(f.HasAny ? " open" : "")>
                <summary class="card-pad cursor-pointer font-semibold text-content flex items-center justify-between">
                    <span><i class="fa-solid fa-sliders mr-2 text-content-muted"></i>Filtreler</span>
                    <i class="fa-solid fa-chevron-down text-content-muted text-sm"></i>
                </summary>
                <div class="px-5 pb-5">
                    @await Html.PartialAsync("_CatalogFilterForm")
                </div>
            </details>
            <div class="hidden lg:block lg:sticky lg:top-20">
                <div class="card card-pad">
                    <h2 class="section-title mb-4"><i class="fa-solid fa-sliders mr-2 text-content-muted"></i>Filtreler</h2>
                    @await Html.PartialAsync("_CatalogFilterForm")
                </div>
            </div>
        </aside>

        <div>
            @if (pairs.Any())
            {
                <div class="flex flex-wrap items-center gap-2 mb-5">
                    @for (int i = 0; i < pairs.Count; i++)
                    {
                        var without = pairs.Where((_, idx) => idx != i);
                        <a href="/araclar@(Build(without))" class="chip">@pairs[i].Label <span aria-hidden="true">✕</span></a>
                    }
                    <a href="/araclar" class="text-xs font-medium text-brand-600 hover:underline ml-1">Tümünü temizle</a>
                </div>
            }

            @if (Model.Any())
            {
                <div id="car-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                    @foreach (var car in Model)
                    {
                        <partial name="_CarCard" model="car" />
                    }
                </div>
            }
            else
            {
                <div class="card card-pad text-center py-16">
                    <i class="fa-solid fa-car-burst text-3xl text-content-muted mb-3"></i>
                    <p class="text-content-muted">Filtrenize uygun araç bulunamadı.</p>
                    <a href="/araclar" class="btn-secondary btn-sm mt-4">Filtreleri temizle</a>
                </div>
            }

            @if (ViewBag.TotalPages > 1)
            {
                <nav class="mt-8 flex justify-center gap-1.5 flex-wrap" aria-label="Sayfalama">
                    @for (int p = 1; p <= ViewBag.TotalPages; p++)
                    {
                        if (p == ViewBag.Page)
                        {
                            <span class="w-10 h-10 flex items-center justify-center rounded-lg bg-brand-600 text-white text-sm font-semibold">@p</span>
                        }
                        else
                        {
                            <a href="/araclar@(Build(pairs, p))" class="w-10 h-10 flex items-center justify-center rounded-lg border border-border bg-surface text-content text-sm font-medium hover:border-brand-300 transition-colors">@p</a>
                        }
                    }
                </nav>
            }
        </div>
    </div>
</div>
