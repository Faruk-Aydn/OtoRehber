@model IEnumerable<OtoRehber.Domain.DTOs.CarListDto>
@{
    ViewData["Ratings"] = ViewBag.CarRatings;
    ViewData["ShowCompare"] = false;
}
<div class="max-w-7xl mx-auto py-8">
    <nav class="text-sm text-content-muted mb-4 flex items-center gap-2">
        <a href="/araclar" class="hover:text-content">Tüm araçlar</a>
        <i class="fa-solid fa-chevron-right text-[10px]"></i>
        <span class="text-content">@ViewBag.Heading</span>
    </nav>

    <h1 class="text-2xl sm:text-3xl font-bold text-content tracking-tight mb-2">@ViewBag.Heading</h1>
    <p class="text-content-muted mb-8">@ViewData["Description"]</p>

    @if (Model.Any())
    {
        <partial name="_CarGrid" model="Model" />
    }
    else
    {
        <div class="card card-pad text-center py-16">
            <i class="fa-solid fa-car-burst text-3xl text-content-muted mb-3"></i>
            <p class="text-content-muted">Bu @ViewBag.Kind için henüz araç eklenmemiş.</p>
        </div>
    }

    <div class="mt-10">
        <a href="/araclar" class="inline-flex items-center text-content-muted hover:text-content font-medium transition-colors">
            <i class="fa-solid fa-arrow-left mr-2"></i> Tüm araçlara dön
        </a>
    </div>
</div>
