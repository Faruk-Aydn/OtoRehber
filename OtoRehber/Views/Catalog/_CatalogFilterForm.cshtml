@using OtoRehber.Services
@{
    var f = (ViewBag.Filter as CarFilter) ?? new CarFilter();
    var brands = (ViewBag.Brands as IEnumerable<string>) ?? System.Array.Empty<string>();

    var selBrand = CarFilter.Clean(f.Brand);
    var selFuel = CarFilter.Clean(f.Fuel);
    var selTrans = CarFilter.Clean(f.Transmission);
    var selBody = CarFilter.Clean(f.BodyType);
    var selDrive = CarFilter.Clean(f.Drivetrain);
    var selPower = CarFilter.Clean(f.Power);
    var selCc = CarFilter.Clean(f.Cc);
}

@{
    Func<string, string, IEnumerable<string>, string[], bool, Microsoft.AspNetCore.Html.IHtmlContent> Section =
        (title, name, options, selected, open) =>
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"<details class=\"group [&_summary::-webkit-details-marker]:hidden\"{(open ? " open" : "")}>");
        sb.Append("<summary class=\"flex cursor-pointer items-center justify-between font-semibold text-content border-b border-border pb-2\">");
        sb.Append(System.Net.WebUtility.HtmlEncode(title));
        sb.Append("<span class=\"transition group-open:-rotate-180 text-content-muted\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9l6 6 6-6\"/></svg></span></summary>");
        sb.Append("<div class=\"mt-3 max-h-48 overflow-y-auto space-y-2 pr-1 custom-scrollbar\">");
        foreach (var o in options)
        {
            var enc = System.Net.WebUtility.HtmlEncode(o);
            var chk = System.Array.IndexOf(selected, o) >= 0 ? " checked" : "";
            sb.Append($"<label class=\"flex items-center gap-2 cursor-pointer text-sm text-content hover:text-brand-600 transition-colors\"><input type=\"checkbox\" name=\"{name}\" value=\"{enc}\"{chk} class=\"rounded border-border accent-brand-600 focus:ring-brand-600\" />{enc}</label>");
        }
        sb.Append("</div></details>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    };

    Func<string, string, (string Id, string Label, int Min, int Max)[], string[], Microsoft.AspNetCore.Html.IHtmlContent> BucketSection =
        (title, name, buckets, selected) =>
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<details class=\"group [&_summary::-webkit-details-marker]:hidden\">");
        sb.Append("<summary class=\"flex cursor-pointer items-center justify-between font-semibold text-content border-b border-border pb-2\">");
        sb.Append(System.Net.WebUtility.HtmlEncode(title));
        sb.Append("<span class=\"transition group-open:-rotate-180 text-content-muted\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9l6 6 6-6\"/></svg></span></summary>");
        sb.Append("<div class=\"mt-3 max-h-48 overflow-y-auto space-y-2 pr-1 custom-scrollbar\">");
        foreach (var b in buckets)
        {
            var chk = System.Array.IndexOf(selected, b.Id) >= 0 ? " checked" : "";
            sb.Append($"<label class=\"flex items-center gap-2 cursor-pointer text-sm text-content hover:text-brand-600 transition-colors\"><input type=\"checkbox\" name=\"{name}\" value=\"{b.Id}\"{chk} class=\"rounded border-border accent-brand-600 focus:ring-brand-600\" />{System.Net.WebUtility.HtmlEncode(b.Label)}</label>");
        }
        sb.Append("</div></details>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    };
}

<form method="get" action="/araclar" class="space-y-3">
    <div>
        <label class="label" for="f-search">Arama</label>
        <input id="f-search" type="text" name="searchQuery" value="@f.SearchQuery" placeholder="Marka veya model" class="input" />
    </div>

    <input type="hidden" name="sortBy" value="@f.SortBy" />

    @Section("Marka", "brand", brands, selBrand, true)
    @Section("Yakıt / Motor tipi", "fuel", OtoRehber.Domain.CarSpecs.FuelTypes, selFuel, false)
    @Section("Vites", "transmission", OtoRehber.Domain.CarSpecs.Transmissions, selTrans, false)
    @Section("Kasa tipi", "bodyType", OtoRehber.Domain.CarSpecs.BodyTypes, selBody, false)
    @Section("Çekiş", "drivetrain", OtoRehber.Domain.CarSpecs.Drivetrains, selDrive, false)

    <details class="group [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer items-center justify-between font-semibold text-content border-b border-border pb-2">
            Fiyat &amp; puan
            <span class="transition group-open:-rotate-180 text-content-muted"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
        </summary>
        <div class="mt-3 space-y-3">
            <div>
                <label class="label text-xs">Fiyat aralığı (₺)</label>
                <div class="flex items-center gap-2">
                    <input type="number" name="priceMin" value="@f.PriceMin" min="0" step="50000" placeholder="Min" class="input py-1.5" />
                    <span class="text-content-muted">–</span>
                    <input type="number" name="priceMax" value="@f.PriceMax" min="0" step="50000" placeholder="Maks" class="input py-1.5" />
                </div>
            </div>
            <div>
                <label class="label text-xs" for="f-score">Min. güvenilirlik</label>
                <select id="f-score" name="minScore" class="select py-1.5">
                    <option value="">Farketmez</option>
                    <option value="6" selected="@(f.MinScore == 6)">6+</option>
                    <option value="7" selected="@(f.MinScore == 7)">7+</option>
                    <option value="8" selected="@(f.MinScore == 8)">8+</option>
                    <option value="9" selected="@(f.MinScore == 9)">9+</option>
                </select>
            </div>
        </div>
    </details>

    @BucketSection("Motor gücü", "power", OtoRehber.Domain.CarSpecs.PowerBuckets, selPower)
    @BucketSection("Motor hacmi", "cc", OtoRehber.Domain.CarSpecs.CcBuckets, selCc)

    <details class="group [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer items-center justify-between font-semibold text-content border-b border-border pb-2">
            Model yılı
            <span class="transition group-open:-rotate-180 text-content-muted"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
        </summary>
        <div class="mt-3">
            <div class="flex items-center gap-2">
                <input type="number" name="yearMin" value="@f.YearMin" min="1990" max="2030" placeholder="Min" class="input py-1.5" />
                <span class="text-content-muted">–</span>
                <input type="number" name="yearMax" value="@f.YearMax" min="1990" max="2030" placeholder="Maks" class="input py-1.5" />
            </div>
        </div>
    </details>

    <div class="flex gap-2 pt-1">
        <button type="submit" class="btn-primary flex-1"><i class="fa-solid fa-filter"></i> Uygula</button>
        <a href="/araclar" class="btn-ghost" title="Temizle"><i class="fa-solid fa-rotate-left"></i></a>
    </div>
</form>
