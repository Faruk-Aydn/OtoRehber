@model IEnumerable<OtoRehber.Controllers.AdminUserController.UserRow>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="mb-6 flex justify-between items-center flex-wrap gap-3">
    <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Kullanıcı Yönetimi</h1>
        <p class="text-gray-500 mt-1">Toplam @ViewBag.Total kullanıcı.</p>
    </div>
    <a asp-controller="AdminCar" asp-action="Index" class="text-gray-600 dark:text-gray-300 hover:text-primary font-medium flex items-center gap-2">
        <i class="fa-solid fa-arrow-left"></i> Araç Paneli
    </a>
</div>

<form method="get" class="mb-4">
    <input type="search" name="q" value="@ViewBag.Query" placeholder="E-posta ara..."
           class="w-full max-w-sm p-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900 rounded-lg text-sm focus:ring-primary focus:border-primary" />
</form>

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-x-auto">
    <table class="w-full text-sm text-left">
        <thead class="text-xs uppercase text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-900/50 border-b border-gray-200 dark:border-gray-700">
            <tr>
                <th class="px-4 py-3">E-posta</th>
                <th class="px-4 py-3">Durum</th>
                <th class="px-4 py-3 text-center">Yorum</th>
                <th class="px-4 py-3 text-center">Garaj</th>
                <th class="px-4 py-3 text-right">İşlemler</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
            @foreach (var u in Model)
            {
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-900/40">
                    <td class="px-4 py-3">
                        <span class="text-gray-800 dark:text-gray-200 font-medium">@u.Email</span>
                        @if (u.IsSelf) { <span class="ml-1 text-xs text-gray-400">(siz)</span> }
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap space-x-1">
                        @if (u.IsAdmin) { <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full font-semibold">Admin</span> }
                        @if (u.EmailConfirmed) { <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full">doğrulandı</span> }
                        else { <span class="text-xs bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded-full">doğrulanmadı</span> }
                        @if (u.LockedOut) { <span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded-full">kilitli</span> }
                    </td>
                    <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-300">@u.ReviewCount</td>
                    <td class="px-4 py-3 text-center text-gray-600 dark:text-gray-300">@u.GarageCount</td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                        @if (!u.IsSelf)
                        {
                            <div class="inline-flex items-center gap-2">
                                <form asp-action="ToggleAdmin" asp-route-id="@u.Id" method="post" class="inline">
                                    <button type="submit" class="text-xs font-semibold @(u.IsAdmin ? "text-gray-500 hover:text-gray-700" : "text-primary hover:underline")">
                                        @(u.IsAdmin ? "Admin'i kaldır" : "Admin yap")
                                    </button>
                                </form>
                                @if (u.LockedOut)
                                {
                                    <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="inline">
                                        <button type="submit" class="text-xs font-semibold text-green-600 hover:underline">Kilidi aç</button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="inline"
                                      onsubmit="return confirm('@u.Email hesabını ve tüm verilerini kalıcı olarak silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="text-red-600 hover:text-red-800" title="Sil"><i class="fa-solid fa-trash-can"></i></button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <span class="text-xs text-gray-400">—</span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="px-4 py-10 text-center text-gray-400">Kullanıcı bulunamadı.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.TotalPages > 1)
{
    <div class="mt-6 flex justify-center gap-2 flex-wrap">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a asp-route-page="@i" asp-route-q="@ViewBag.Query" class="px-3 py-1.5 rounded-lg text-sm font-medium @(i == ViewBag.Page ? "bg-primary text-white" : "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:border-primary")">@i</a>
        }
    </div>
}
