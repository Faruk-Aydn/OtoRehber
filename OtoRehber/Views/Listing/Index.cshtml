@{
    var carGroups = ViewBag.CarGroups as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="max-w-2xl mx-auto py-8">
    <div class="text-center mb-8" data-aos="fade-down">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-brand-600 text-white mb-4">
            <i class="fa-solid fa-magnifying-glass-dollar text-2xl"></i>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-content tracking-tight mb-2">İlan Analizi</h1>
        <p class="text-content-muted max-w-lg mx-auto">
            İkinci el bir ilan mı buldun? Aracı seç, ilandaki bilgileri gir; fiyat, kilometre, kronik
            sorunlar ve bakım açısından OtoRehber verileriyle değerlendirelim. Eksik bilgi tahmin edilmez.
        </p>
    </div>

    <div class="card card-pad" data-aos="fade-up">
        @if (ViewBag.Error != null)
        {
            <div class="card border-l-4 border-l-red-500 p-4 mb-6 flex items-center gap-3">
                <i class="fa-solid fa-triangle-exclamation text-red-500"></i>
                <p class="text-sm text-content">@ViewBag.Error</p>
            </div>
        }

        <form method="post" action="/ilan-analizi" class="space-y-6">
            <div>
                <label class="label" for="carId">İlandaki araç <span class="text-red-500">*</span></label>
                <select id="carId" name="carId" required class="select">
                    <option value="">Katalogdan seçin…</option>
                    @foreach (var g in carGroups)
                    {
                        <optgroup label="@g.Brand">
                            @foreach (var c in g.Cars)
                            {
                                <option value="@c.Id">@c.Label</option>
                            }
                        </optgroup>
                    }
                </select>
                <p class="text-xs text-content-muted mt-1">Motor/nesil dahil en yakın varyantı seçin — analiz buna göre yapılır.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="label" for="year">İlan yılı</label>
                    <input id="year" name="year" type="number" min="1990" max="2100" class="input" placeholder="2016" />
                </div>
                <div>
                    <label class="label" for="mileage">Kilometre</label>
                    <input id="mileage" name="mileage" type="number" min="0" max="2000000" step="1000" class="input" placeholder="145000" />
                </div>
                <div>
                    <label class="label" for="price">İlan fiyatı (₺)</label>
                    <input id="price" name="price" type="number" min="0" step="10000" class="input" placeholder="950000" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="label">Tramer / hasar kaydı</label>
                    <div class="flex gap-2 mt-1">
                        @foreach (var (val, txt) in new[] { ("", "Bilinmiyor"), ("yok", "Yok"), ("var", "Var") })
                        {
                            <label class="cursor-pointer">
                                <input type="radio" name="damage" value="@val" class="peer sr-only" @(val == "" ? "checked" : "") />
                                <span class="chip peer-checked:bg-brand-600 peer-checked:text-white peer-checked:border-brand-600">@txt</span>
                            </label>
                        }
                    </div>
                </div>
                <div>
                    <label class="label" for="paintedPanels">Boyalı / değişen parça sayısı</label>
                    <input id="paintedPanels" name="paintedPanels" type="number" min="0" max="20" class="input" placeholder="(biliniyorsa)" />
                </div>
            </div>

            <div>
                <label class="label" for="notes">Not (opsiyonel)</label>
                <textarea id="notes" name="notes" rows="2" maxlength="500" class="textarea" placeholder="İlan açıklamasından dikkat çeken bir şey…"></textarea>
            </div>

            <div class="pt-4 border-t border-border flex justify-end">
                <button type="submit" class="btn-primary btn-lg"><i class="fa-solid fa-clipboard-check"></i> İlanı değerlendir</button>
            </div>
        </form>
    </div>

    <p class="text-xs text-content-muted text-center mt-4">
        Bu analiz bilgilendirme amaçlıdır; kesin karar için bağımsız ekspertiz ve resmi tramer sorgusu şarttır.
    </p>
</div>
