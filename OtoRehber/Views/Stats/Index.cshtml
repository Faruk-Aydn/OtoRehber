@{
    ViewData["Title"] = "Veritabanı İstatistikleri";
    ViewData["Description"] = "OtoRehber veritabanındaki araçların segment dağılımı, marka bazlı ortalama OtoRehber Skoru ve genel istatistikler.";
    var segLabels = System.Text.Json.JsonSerializer.Serialize(ViewBag.SegmentLabels ?? new List<string>());
    var segCounts = System.Text.Json.JsonSerializer.Serialize(ViewBag.SegmentCounts ?? new List<int>());
    var brandLabels = System.Text.Json.JsonSerializer.Serialize(ViewBag.BrandLabels ?? new List<string>());
    var brandScores = System.Text.Json.JsonSerializer.Serialize(ViewBag.BrandAvgScores ?? new List<double>());
    var brandCounts = System.Text.Json.JsonSerializer.Serialize(ViewBag.BrandCarCounts ?? new List<int>());
}

<div class="mb-8" data-aos="fade-down">
    <h1 class="text-2xl sm:text-3xl font-bold text-content tracking-tight">Veritabanı istatistikleri</h1>
    <p class="text-content-muted mt-2">Sistemdeki tüm araçların gerçek zamanlı analizi ve özeti.</p>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10" data-aos="fade-up">
    <div class="stat">
        <div class="stat-value">@ViewBag.TotalCars</div>
        <div class="stat-label"><i class="fa-solid fa-car mr-1"></i>Toplam araç</div>
    </div>
    <div class="stat">
        <div class="stat-value">@ViewBag.TotalReviews</div>
        <div class="stat-label"><i class="fa-solid fa-star mr-1"></i>Toplam yorum</div>
    </div>
    <div class="stat">
        <div class="stat-value">@ViewBag.TotalGarage</div>
        <div class="stat-label"><i class="fa-solid fa-heart mr-1"></i>Garaj kaydı</div>
    </div>
    <div class="stat">
        <div class="stat-value">@ViewBag.AvgScore</div>
        <div class="stat-label"><i class="fa-solid fa-gauge mr-1"></i>Ort. OtoRehber Skoru</div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">
    <div class="card card-pad" data-aos="fade-up">
        <h2 class="section-title mb-4 flex items-center gap-2"><i class="fa-solid fa-chart-pie text-content-muted"></i> Segment dağılımı</h2>
        <div class="relative h-64"><canvas id="segmentChart"></canvas></div>
    </div>
    <div class="card card-pad" data-aos="fade-up">
        <h2 class="section-title mb-4 flex items-center gap-2"><i class="fa-solid fa-chart-bar text-content-muted"></i> Marka bazlı ort. OtoRehber Skoru</h2>
        <div class="relative h-64"><canvas id="brandChart"></canvas></div>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
    <div class="card overflow-hidden" data-aos="fade-up">
        <div class="px-5 py-4 border-b border-border flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-content-muted"></i>
            <h2 class="section-title">En yüksek OtoRehber Skoru (5 araç)</h2>
        </div>
        <div class="p-4 space-y-3">
            @if (ViewBag.Top5Cars != null)
            {
                int tr = 1;
                foreach (var c in ViewBag.Top5Cars)
                {
                    <div class="flex items-center justify-between p-3 rounded-lg bg-surface-2 border border-border">
                        <div class="flex items-center gap-3">
                            <span class="w-7 h-7 rounded-full bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-300 font-semibold text-sm flex items-center justify-center">@tr</span>
                            <div>
                                <p class="font-medium text-content text-sm">@c.Name</p>
                                <p class="text-xs text-content-muted">@c.Segment segmenti</p>
                            </div>
                        </div>
                        <span class="badge-warning"><i class="fa-solid fa-star"></i>@c.Score</span>
                    </div>
                    tr++;
                }
            }
        </div>
    </div>

    <div class="card overflow-hidden" data-aos="fade-up" data-aos-delay="100">
        <div class="px-5 py-4 border-b border-border flex items-center gap-2">
            <i class="fa-solid fa-screwdriver-wrench text-content-muted"></i>
            <h2 class="section-title">En yüksek bakım maliyeti</h2>
        </div>
        <div class="p-4 space-y-3">
            @if (ViewBag.HighCostCars != null)
            {
                int hc = 1;
                foreach (var c in ViewBag.HighCostCars)
                {
                    <div class="flex items-center justify-between p-3 rounded-lg bg-surface-2 border border-border">
                        <div class="flex items-center gap-3">
                            <span class="w-7 h-7 rounded-full bg-red-50 text-red-700 dark:bg-red-500/15 dark:text-red-300 font-semibold text-sm flex items-center justify-center">@hc</span>
                            <div>
                                <p class="font-medium text-content text-sm">@c.Name</p>
                                <p class="text-xs text-content-muted">@c.Segment segmenti</p>
                            </div>
                        </div>
                        <span class="badge bg-red-50 text-red-700 dark:bg-red-500/15 dark:text-red-300">~@c.Cost € / yıl</span>
                    </div>
                    hc++;
                }
            }
        </div>
    </div>
</div>

<div class="card overflow-hidden mb-6" data-aos="fade-up">
    <div class="p-5 border-b border-border flex items-center gap-2">
        <i class="fa-solid fa-table text-content-muted"></i>
        <h2 class="section-title">Marka özet tablosu</h2>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead class="bg-surface-2 text-content-muted uppercase text-xs tracking-wider">
                <tr>
                    <th class="px-3 sm:px-6 py-3">#</th>
                    <th class="px-3 sm:px-6 py-3">Marka</th>
                    <th class="px-3 sm:px-6 py-3 hidden sm:table-cell">Araç sayısı</th>
                    <th class="px-3 sm:px-6 py-3">Ort. OtoRehber Skoru</th>
                    <th class="px-3 sm:px-6 py-3 hidden md:table-cell">Ort. bakım/yıl</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border">
                @if (ViewBag.BrandLabels != null)
                {
                    var labels = (List<string>)ViewBag.BrandLabels;
                    var scores = (List<double>)ViewBag.BrandAvgScores;
                    var counts = (List<int>)ViewBag.BrandCarCounts;
                    var costs = (List<int>)ViewBag.BrandAvgCosts;
                    for (int i = 0; i < labels.Count; i++)
                    {
                        <tr class="hover:bg-surface-2 transition-colors">
                            <td class="px-3 sm:px-6 py-4 text-content-muted font-medium">@(i + 1)</td>
                            <td class="px-3 sm:px-6 py-4 font-semibold text-content">@labels[i]</td>
                            <td class="px-3 sm:px-6 py-4 text-content-muted hidden sm:table-cell">@counts[i] araç</td>
                            <td class="px-3 sm:px-6 py-4">
                                <span class="font-semibold text-amber-600 dark:text-amber-400"><i class="fa-solid fa-star mr-1"></i>@scores[i]</span>
                            </td>
                            <td class="px-3 sm:px-6 py-4 text-red-500 font-medium hidden md:table-cell">~@costs[i] €</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script>
        const segLabels = @Html.Raw(segLabels);
        const segCounts = @Html.Raw(segCounts);
        const brandLabels = @Html.Raw(brandLabels);
        const brandScores = @Html.Raw(brandScores);
        const dark = document.documentElement.classList.contains('dark');
        const tick = dark ? '#94a3b8' : '#64748b';
        const grid = dark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';

        // Marka rengi tonları + nötr gri destek tonları
        const palette = ['#2563eb', '#3b76f6', '#6096fa', '#93bbfd', '#64748b', '#94a3b8', '#1d4ed8', '#1e40af', '#bfd7fe', '#cbd5e1'];

        new Chart(document.getElementById('segmentChart'), {
            type: 'doughnut',
            data: { labels: segLabels, datasets: [{ data: segCounts, backgroundColor: palette, borderWidth: 2, borderColor: dark ? '#0f172a' : '#ffffff' }] },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'right', labels: { font: { size: 12 }, color: dark ? '#e2e8f0' : '#1e293b' } } }
            }
        });

        new Chart(document.getElementById('brandChart'), {
            type: 'bar',
            data: { labels: brandLabels, datasets: [{ label: 'Ort. OtoRehber Skoru', data: brandScores, backgroundColor: 'rgba(37,99,235,0.8)', borderColor: '#2563eb', borderWidth: 1, borderRadius: 6 }] },
            options: {
                responsive: true, maintainAspectRatio: false, indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { min: 0, max: 10, ticks: { font: { size: 11 }, color: tick }, grid: { color: grid } },
                    y: { ticks: { font: { size: 11 }, color: tick }, grid: { display: false } }
                }
            }
        });
    </script>
}
