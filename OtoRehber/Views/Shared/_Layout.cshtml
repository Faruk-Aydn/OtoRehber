<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OtoRehber</title>
    <!-- PWA (Progressive Web App) Meta Etiketleri -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="apple-touch-icon" href="~/favicon.ico" />
    <!-- FontAwesome & AOS (self-hosted) -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/aos/aos.css" asp-append-version="true" />
    <!-- Derlenmiş Tailwind — EN SON (utility'ler FontAwesome'ı geçsin, örn .hidden) -->
    <link rel="stylesheet" href="~/css/app.min.css" asp-append-version="true" />
    <script>
        // FOUC önlemek için sayfa render edilmeden önce temayı kontrol et
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 font-sans min-h-screen flex flex-col overflow-x-hidden selection:bg-primary selection:text-white transition-colors duration-300">

    <!-- Glassmorphism Navbar -->
    <header class="bg-white/80 dark:bg-gray-800/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50 shadow-sm transition-all duration-300">
        <nav class="container mx-auto px-4 py-3 md:py-4">
            <div class="flex justify-between items-center gap-3">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-xl md:text-2xl font-extrabold tracking-tight text-primary dark:text-blue-400 flex items-center gap-2 shrink-0">
                    <i class="fa-solid fa-car-side"></i>OtoRehber
                </a>

                @{
                    var linkCls = "text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 font-medium transition flex items-center gap-1";
                }

                <!-- MASAÜSTÜ menü (lg+) -->
                <div class="hidden lg:flex items-center gap-x-4 xl:gap-x-6">
                    <button id="theme-toggle" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2.5 transition-colors">
                        <i id="theme-toggle-dark-icon" class="fa-solid fa-moon hidden text-lg"></i>
                        <i id="theme-toggle-light-icon" class="fa-solid fa-sun hidden text-lg text-yellow-400"></i>
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="@linkCls">Ana Sayfa</a>
                    <a asp-controller="Compare" asp-action="Index" class="@linkCls"><i class="fa-solid fa-scale-balanced"></i> Karşılaştırma</a>
                    <a asp-controller="AiWizard" asp-action="Index" class="@linkCls"><i class="fa-solid fa-wand-magic-sparkles text-purple-500"></i> AI Sihirbaz</a>
                    <a asp-controller="Stats" asp-action="Index" class="@linkCls"><i class="fa-solid fa-chart-pie text-indigo-500"></i> İstatistikler</a>

                    <div class="relative" id="navbar-search-wrap">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
                        <input id="navbar-search-input" type="text" placeholder="Araç ara..." autocomplete="off"
                               class="bg-gray-100 dark:bg-gray-700 border-0 rounded-xl pl-9 pr-4 py-2 text-sm text-gray-800 dark:text-gray-200 placeholder-gray-400 focus:ring-2 focus:ring-primary outline-none w-40 lg:w-44 transition-all focus:w-52 lg:focus:w-56" />
                        <div id="navbar-search-results" class="hidden absolute top-full right-0 mt-1 w-72 bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 z-50 overflow-hidden"></div>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Garage" asp-action="Index" class="@linkCls"><i class="fa-solid fa-heart text-red-500"></i> Garajım</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="AdminCar" asp-action="Index" class="bg-primary hover:bg-blue-700 text-white px-3 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 shadow-md"><i class="fa-solid fa-gear"></i> Admin</a>
                        }
                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                            <button type="submit" class="@linkCls text-sm"><i class="fa-solid fa-arrow-right-from-bracket"></i> Çıkış</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="@linkCls text-sm"><i class="fa-solid fa-user-plus"></i> Kayıt Ol</a>
                        <a asp-controller="Account" asp-action="Login" class="@linkCls text-sm"><i class="fa-solid fa-lock"></i> Giriş</a>
                    }
                </div>

                <!-- MOBİL/TABLET: tema + hamburger -->
                <div class="flex lg:hidden items-center gap-1">
                    <button id="theme-toggle-m" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2.5">
                        <i class="theme-dark-icon fa-solid fa-moon hidden text-lg"></i>
                        <i class="theme-light-icon fa-solid fa-sun hidden text-lg text-yellow-400"></i>
                    </button>
                    <button id="mobile-menu-btn" aria-label="Menü" class="text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2.5">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                </div>
            </div>

            <!-- MOBİL menü paneli -->
            <div id="mobile-menu" class="hidden lg:hidden mt-3 pb-2 space-y-1 border-t border-gray-200 dark:border-gray-700 pt-3">
                <div class="relative mb-2">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
                    <input id="navbar-search-input-m" type="text" placeholder="Araç ara..." autocomplete="off"
                           class="w-full bg-gray-100 dark:bg-gray-700 border-0 rounded-xl pl-9 pr-4 py-2.5 text-sm text-gray-800 dark:text-gray-200 placeholder-gray-400 focus:ring-2 focus:ring-primary outline-none" />
                    <div id="navbar-search-results-m" class="hidden mt-1 bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden"></div>
                </div>
                <a asp-controller="Home" asp-action="Index" class="block px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @linkCls">Ana Sayfa</a>
                <a asp-controller="Compare" asp-action="Index" class="block px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @linkCls"><i class="fa-solid fa-scale-balanced"></i> Karşılaştırma</a>
                <a asp-controller="AiWizard" asp-action="Index" class="block px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @linkCls"><i class="fa-solid fa-wand-magic-sparkles text-purple-500"></i> AI Sihirbaz</a>
                <a asp-controller="Stats" asp-action="Index" class="block px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @linkCls"><i class="fa-solid fa-chart-pie text-indigo-500"></i> İstatistikler</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Garage" asp-action="Index" class="block px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @linkCls"><i class="fa-solid fa-heart text-red-500"></i> Garajım</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="AdminCar" asp-action="Index" class="block px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @linkCls"><i class="fa-solid fa-gear"></i> Admin Panel</a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @linkCls"><i class="fa-solid fa-arrow-right-from-bracket"></i> Çıkış</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="block px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 @linkCls"><i class="fa-solid fa-lock"></i> Giriş Yap</a>
                    <a asp-controller="Account" asp-action="Register" class="block mt-1 bg-primary text-white text-center px-3 py-2.5 rounded-lg font-semibold"><i class="fa-solid fa-user-plus mr-1"></i> Kayıt Ol</a>
                }
            </div>
        </nav>
    </header>
    
    @Html.AntiForgeryToken()

    <main role="main" class="container mx-auto px-4 py-8 flex-grow">
        @RenderBody()
    </main>

    <!-- ===== GLOBAL TOAST BİLDİRİM SİSTEMİ ===== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="toast-success" class="fixed top-4 right-4 left-4 sm:left-auto z-[200] flex items-center gap-3 bg-white dark:bg-gray-800 border-l-4 border-green-500 shadow-2xl rounded-xl px-5 py-4 sm:max-w-sm transition-all duration-500" role="alert">
            <div class="flex-shrink-0 w-9 h-9 bg-green-100 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-circle-check text-green-600"></i>
            </div>
            <div>
                <p class="text-sm font-semibold text-gray-800 dark:text-gray-100">Başarılı!</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@TempData["SuccessMessage"]</p>
            </div>
            <button onclick="closeToast('toast-success')" class="ml-auto text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="toast-error" class="fixed top-4 right-4 left-4 sm:left-auto z-[200] flex items-center gap-3 bg-white dark:bg-gray-800 border-l-4 border-red-500 shadow-2xl rounded-xl px-5 py-4 sm:max-w-sm transition-all duration-500" role="alert">
            <div class="flex-shrink-0 w-9 h-9 bg-red-100 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-circle-xmark text-red-600"></i>
            </div>
            <div>
                <p class="text-sm font-semibold text-gray-800 dark:text-gray-100">Hata!</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@TempData["ErrorMessage"]</p>
            </div>
            <button onclick="closeToast('toast-error')" class="ml-auto text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div id="toast-info" class="fixed top-4 right-4 left-4 sm:left-auto z-[200] flex items-center gap-3 bg-white dark:bg-gray-800 border-l-4 border-blue-500 shadow-2xl rounded-xl px-5 py-4 sm:max-w-sm transition-all duration-500" role="alert">
            <div class="flex-shrink-0 w-9 h-9 bg-blue-100 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-circle-info text-blue-600"></i>
            </div>
            <div>
                <p class="text-sm font-semibold text-gray-800 dark:text-gray-100">Bilgi</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@TempData["InfoMessage"]</p>
            </div>
            <button onclick="closeToast('toast-info')" class="ml-auto text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <footer class="bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 py-8 mt-auto transition-colors duration-300">
        <div class="container mx-auto px-4 text-center text-gray-500 dark:text-gray-400 text-sm">
            <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2 mb-4">
                <a asp-controller="Home" asp-action="Hakkimizda" class="hover:text-primary dark:hover:text-blue-400 transition">Hakkımızda</a>
                <a asp-controller="Home" asp-action="Iletisim" class="hover:text-primary dark:hover:text-blue-400 transition">İletişim</a>
                <a asp-controller="Home" asp-action="Privacy" class="hover:text-primary dark:hover:text-blue-400 transition">Gizlilik Politikası</a>
                <a asp-controller="Home" asp-action="Kvkk" class="hover:text-primary dark:hover:text-blue-400 transition">KVKK Aydınlatma Metni</a>
                <a asp-controller="Home" asp-action="KullanimKosullari" class="hover:text-primary dark:hover:text-blue-400 transition">Kullanım Koşulları</a>
                <a asp-controller="Home" asp-action="Cerez" class="hover:text-primary dark:hover:text-blue-400 transition">Çerez Politikası</a>
            </nav>
            <p>&copy; @DateTime.UtcNow.Year OtoRehber. İçerikler bilgilendirme amaçlıdır, bağlayıcı değildir.</p>
        </div>
    </footer>

    <!-- Çerez onay bildirimi -->
    <div id="cookie-banner" class="hidden fixed bottom-0 inset-x-0 z-[150] bg-gray-900 text-gray-100 text-sm">
        <div class="container mx-auto px-4 py-3 flex flex-col sm:flex-row items-center gap-3">
            <p class="flex-1 text-center sm:text-left">
                Yalnızca sitenin çalışması için gerekli çerezleri kullanıyoruz.
                <a asp-controller="Home" asp-action="Cerez" class="underline hover:text-white">Detaylı bilgi</a>.
            </p>
            <button onclick="acceptCookies()" class="bg-primary hover:bg-blue-700 text-white font-semibold px-4 py-1.5 rounded-lg whitespace-nowrap">Tamam</button>
        </div>
    </div>
    <script>
        (function () {
            try {
                if (localStorage.getItem('cookie-consent') !== 'ok') {
                    document.getElementById('cookie-banner').classList.remove('hidden');
                }
            } catch (e) { }
        })();
        function acceptCookies() {
            try { localStorage.setItem('cookie-consent', 'ok'); } catch (e) { }
            document.getElementById('cookie-banner').classList.add('hidden');
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- AOS Animation Script (self-hosted) -->
    <script src="~/lib/aos/aos.js" asp-append-version="true"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true,
            offset: 50
        });

        // ===== TOAST SİSTEMİ =====
        function closeToast(id) {
            const el = document.getElementById(id);
            if (el) {
                el.style.opacity = '0';
                el.style.transform = 'translateX(120%)';
                setTimeout(() => el.remove(), 500);
            }
        }

        // Sayfada toast varsa 4 saniye sonra otomatik kapat
        document.addEventListener('DOMContentLoaded', function () {
            ['toast-success', 'toast-error', 'toast-info'].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) {
                    // Slide-in animasyonu
                    el.style.transform = 'translateX(120%)';
                    el.style.transition = 'all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                    setTimeout(() => { el.style.transform = 'translateX(0)'; }, 50);
                    // 4 saniye sonra kapat
                    setTimeout(() => closeToast(id), 4000);
                }
            });
        });
    </script>

    <!-- AI Chatbot Asistanı (V3) -->
    <div id="aiChatWidget" class="fixed bottom-4 right-4 z-[100]">
        <!-- Chat Butonu -->
        <button id="aiChatBtn" onclick="toggleChat()" class="bg-indigo-600 hover:bg-indigo-700 text-white rounded-full w-14 h-14 flex items-center justify-center shadow-lg hover:shadow-2xl transition-all transform hover:scale-110">
            <i class="fa-solid fa-robot text-2xl"></i>
        </button>

        <!-- Chat Penceresi -->
        <div id="aiChatWindow" class="hidden absolute bottom-16 right-0 w-[calc(100vw-2rem)] max-w-sm bg-white/95 dark:bg-gray-800/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 overflow-hidden flex flex-col transition-all origin-bottom-right h-[70vh] max-h-[500px] min-h-[360px]">
            <!-- Header -->
            <div class="bg-indigo-600 p-4 flex justify-between items-center text-white">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-sm">OtoRehber AI</h3>
                        <p class="text-xs text-indigo-200">Araç Öneri Asistanı</p>
                    </div>
                </div>
                <button onclick="toggleChat()" class="text-white hover:text-gray-200 focus:outline-none">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Messages Box -->
            <div id="aiChatMessages" class="flex-1 p-4 overflow-y-auto bg-gray-50/50 dark:bg-gray-900/50 space-y-4">
                <!-- Karşılama Mesajı -->
                <div class="flex items-start gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-robot text-indigo-600 text-xs"></i>
                    </div>
                    <div class="flex flex-col gap-1 w-full max-w-[85%]">
                        <div class="bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-800 dark:text-gray-100 p-3 rounded-e-xl rounded-es-xl text-sm shadow-sm">
                            Merhaba! Ben OtoRehber AI Asistanı. Sana sistemimizdeki araçlar arasından en uygununu önerebilirim. Bütçen veya aradığın özellikler neler?
                        </div>
                    </div>
                </div>
            </div>

            <!-- Input Box -->
            <div class="p-3 bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
                <form id="aiChatForm" onsubmit="sendAiMessage(event)" class="flex gap-2">
                    <input type="text" id="aiChatInput" autocomplete="off" placeholder="Mesajınızı yazın..." class="flex-1 bg-gray-100 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 text-sm border-0 rounded-full px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none">
                    <button type="submit" id="aiChatSubmit" class="w-10 h-10 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white flex items-center justify-center transition-colors">
                        <i class="fa-solid fa-paper-plane text-sm"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- AI Chatbot Javascript -->
    <script>
        // ===== ANTIFORGERY YARDIMCISI =====
        // Sunucudaki AutoValidateAntiforgeryToken filtresi tüm POST'larda token bekler.
        function antiForgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }
        function postJson(url, bodyObj) {
            return fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': antiForgeryToken()
                },
                body: JSON.stringify(bodyObj)
            });
        }

        function toggleChat() {
            const chatWindow = document.getElementById('aiChatWindow');
            chatWindow.classList.toggle('hidden');
            if(!chatWindow.classList.contains('hidden')) {
                document.getElementById('aiChatInput').focus();
            }
        }

        async function sendAiMessage(e) {
            e.preventDefault();
            const input = document.getElementById('aiChatInput');
            const message = input.value.trim();
            if (!message) return;

            appendMessage('user', message);
            input.value = '';
            
            // Yükleniyor animasyonu göster
            const loadingId = 'loading-' + Date.now();
            appendLoading(loadingId);
            scrollToBottom();

            try {
                const response = await postJson('/api/AiChat/send', { message: message });

                const data = await response.json();
                
                // Yükleniyor animasyonunu kaldır
                removeElement(loadingId);

                if (response.ok) {
                    appendMessage('ai', data.response);
                } else {
                    appendMessage('ai', "Hata: " + (data.error || "Sunucuya ulaşılamadı."));
                }
            } catch (error) {
                removeElement(loadingId);
                appendMessage('ai', "Bağlantı hatası oluştu. Lütfen tekrar deneyin.");
            }
            scrollToBottom();
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function appendMessage(sender, text) {
            const msgBox = document.getElementById('aiChatMessages');

            // Önce HTML olarak yorumlanabilecek her şeyi escape et (XSS koruması),
            // sonra sadece kendi eklediğimiz basit markdown biçimlendirmesini uygula.
            let formattedText = escapeHtml(text);
            formattedText = formattedText.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            formattedText = formattedText.replace(/\n/g, '<br/>');

            let html = '';
            if (sender === 'user') {
                html = `
                <div class="flex items-start gap-2.5 justify-end">
                    <div class="flex flex-col gap-1 w-full max-w-[85%] items-end">
                        <div class="bg-indigo-600 text-white p-3 rounded-s-xl rounded-ee-xl text-sm shadow-sm">
                            ${formattedText}
                        </div>
                    </div>
                </div>`;
            } else {
                html = `
                <div class="flex items-start gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-robot text-indigo-600 text-xs"></i>
                    </div>
                    <div class="flex flex-col gap-1 w-full max-w-[85%]">
                        <div class="bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-800 dark:text-gray-100 p-3 rounded-e-xl rounded-es-xl text-sm shadow-sm">
                            ${formattedText}
                        </div>
                    </div>
                </div>`;
            }
            msgBox.insertAdjacentHTML('beforeend', html);
        }

        function appendLoading(id) {
            const msgBox = document.getElementById('aiChatMessages');
            const html = `
            <div id="${id}" class="flex items-start gap-2.5">
                <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-robot text-indigo-600 text-xs"></i>
                </div>
                <div class="bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 p-3 rounded-e-xl rounded-es-xl shadow-sm flex gap-1 items-center h-10">
                    <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce"></div>
                    <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
                    <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                </div>
            </div>`;
            msgBox.insertAdjacentHTML('beforeend', html);
        }

        function removeElement(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        function scrollToBottom() {
            const msgBox = document.getElementById('aiChatMessages');
            msgBox.scrollTop = msgBox.scrollHeight;
        }

        async function toggleGarageHome(carId, btnElement) {
            try {
                const response = await postJson('/Garage/Toggle', carId);

                if (response.ok) {
                    const data = await response.json();
                    const icon = btnElement.querySelector('i');
                    if (data.added) {
                        icon.classList.remove('text-gray-400');
                        icon.classList.add('text-red-500');
                    } else {
                        icon.classList.remove('text-red-500');
                        icon.classList.add('text-gray-400');
                    }
                } else if (response.status === 401) {
                    window.location.href = '/Account/Login';
                }
            } catch (error) {
                console.error("Hata:", error);
            }
        }

        // ===== TEMA + MOBİL MENÜ =====
        document.addEventListener('DOMContentLoaded', () => {
            // Tema ikonlarını (masaüstü id + mobil class) güncelle
            function syncThemeIcons() {
                const dark = document.documentElement.classList.contains('dark');
                document.querySelectorAll('#theme-toggle-dark-icon, .theme-dark-icon')
                    .forEach(el => el.classList.toggle('hidden', dark));
                document.querySelectorAll('#theme-toggle-light-icon, .theme-light-icon')
                    .forEach(el => el.classList.toggle('hidden', !dark));
            }
            syncThemeIcons();

            function toggleTheme() {
                const nowDark = !document.documentElement.classList.contains('dark');
                document.documentElement.classList.toggle('dark', nowDark);
                try { localStorage.setItem('theme', nowDark ? 'dark' : 'light'); } catch (e) {}
                syncThemeIcons();
            }
            ['theme-toggle', 'theme-toggle-m'].forEach(id => {
                document.getElementById(id)?.addEventListener('click', toggleTheme);
            });

            // Mobil hamburger
            const menuBtn = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            function setMenu(open) {
                menu.classList.toggle('hidden', !open);
                menuBtn.querySelector('i').className = open ? 'fa-solid fa-xmark text-xl' : 'fa-solid fa-bars text-xl';
            }
            menuBtn?.addEventListener('click', () => setMenu(menu.classList.contains('hidden')));
            // Menüdeki bir bağlantıya tıklanınca kapat
            menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
        });
    </script>

    <!-- ===== AUTOCOMPLETE ARAMA (masaüstü + mobil) ===== -->
    <script>
        function wireAutocomplete(inputId, resultsId) {
            const input = document.getElementById(inputId);
            const results = document.getElementById(resultsId);
            if (!input || !results) return;
            let debounceTimer;

            input.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const q = this.value.trim();
                if (q.length < 2) { results.classList.add('hidden'); results.innerHTML = ''; return; }
                debounceTimer = setTimeout(async () => {
                    try {
                        const res = await fetch(`/api/Search/suggest?q=${encodeURIComponent(q)}`);
                        const data = await res.json();
                        if (!data.length) {
                            results.innerHTML = '<div class="p-4 text-sm text-gray-400 text-center">Sonuç bulunamadı</div>';
                            results.classList.remove('hidden'); return;
                        }
                        results.innerHTML = data.map(item => `
                            <a href="/Car/Details/${item.id}"
                               class="flex items-center justify-between px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 border-b border-gray-100 dark:border-gray-700 last:border-0 transition group">
                                <div>
                                    <p class="text-sm font-semibold text-gray-800 dark:text-gray-200 group-hover:text-primary">${item.label}</p>
                                    <p class="text-xs text-gray-400">${item.segment} Segmenti</p>
                                </div>
                                <span class="text-xs font-bold text-yellow-600 bg-yellow-50 dark:bg-yellow-900/20 px-2 py-0.5 rounded">⭐ ${item.score}</span>
                            </a>`).join('');
                        results.classList.remove('hidden');
                    } catch (e) { results.classList.add('hidden'); }
                }, 250);
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { const f = results.querySelector('a'); if (f) f.click(); }
            });
        }
        wireAutocomplete('navbar-search-input', 'navbar-search-results');
        wireAutocomplete('navbar-search-input-m', 'navbar-search-results-m');

        document.addEventListener('click', (e) => {
            if (!document.getElementById('navbar-search-wrap')?.contains(e.target))
                document.getElementById('navbar-search-results')?.classList.add('hidden');
        });

        // PWA Service Worker Registration
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('/service-worker.js').then(function(registration) {
                    console.log('ServiceWorker registration successful with scope: ', registration.scope);
                }, function(err) {
                    console.log('ServiceWorker registration failed: ', err);
                });
            });
        }
    </script>
</body>
</html>
