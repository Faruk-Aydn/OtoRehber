                    <a asp-controller="Home" asp-action="Index" class="@linkCls">Ana Sayfa</a>
                    <a href="/araclar" class="@linkCls">Tüm Araçlar</a>
                    <a asp-controller="Compare" asp-action="Index" class="@linkCls">Karşılaştırma</a>
                    <a asp-controller="AiWizard" asp-action="Index" class="@linkCls">AI Sihirbaz</a>
                    <a href="/ilan-analizi" class="@linkCls">İlan Analizi</a>
                    <a asp-controller="Stats" asp-action="Index" class="@linkCls">İstatistikler</a>

