@{
    var _seoTitle = ViewData["Title"] != null ? $"{ViewData["Title"]} - OtoRehber" : "OtoRehber — Yapay Zeka Destekli Araç Rehberi";
    var _seoDesc = (ViewData["Description"] as string)
        ?? "Türkiye ikinci el otomobil piyasası için yapay zeka destekli araç inceleme, karşılaştırma ve öneri platformu. Kronik sorunlar, bakım maliyetleri ve dürüst analizler.";
    var _canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var _ogImage = (ViewData["OgImage"] as string) is { Length: > 0 } img
        ? (img.StartsWith("http") ? img : $"{Context.Request.Scheme}://{Context.Request.Host}{img}")
        : $"{Context.Request.Scheme}://{Context.Request.Host}/icons/icon-512.png";
    var _ogType = (ViewData["OgType"] as string) ?? "website";
    var _pathLower = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    var _noindex = (ViewData["NoIndex"] as bool? ?? false)
        || _pathLower.StartsWith("/account")
        || _pathLower.StartsWith("/manage")
        || _pathLower.StartsWith("/admin")
        || _pathLower.StartsWith("/garage");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@_seoTitle</title>
    <meta name="description" content="@_seoDesc" />
    <link rel="canonical" href="@_canonical" />
    <meta name="robots" content="@(_noindex ? "noindex,nofollow" : "index,follow")" />
    <!-- Open Graph / Twitter Card (link önizlemeleri) -->
    <meta property="og:site_name" content="OtoRehber" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content="@_ogType" />
    <meta property="og:title" content="@_seoTitle" />
    <meta property="og:description" content="@_seoDesc" />
    <meta property="og:url" content="@_canonical" />
    <meta property="og:image" content="@_ogImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@_seoTitle" />
    <meta name="twitter:description" content="@_seoDesc" />
    <meta name="twitter:image" content="@_ogImage" />
    <!-- PWA (Progressive Web App) Meta Etiketleri -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="OtoRehber" />
    <!-- Yazı tipi (self-host, variable) -->
    <link rel="preload" href="~/lib/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/lib/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <!-- FontAwesome & AOS (self-hosted) -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/aos/aos.css" asp-append-version="true" />
    <!-- Derlenmiş Tailwind — EN SON (utility'ler FontAwesome'ı geçsin, örn .hidden) -->
    <link rel="stylesheet" href="~/css/app.min.css" asp-append-version="true" />
    <script>
        // FOUC önlemek için sayfa render edilmeden önce temayı kontrol et
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</head>
<body class="bg-surface-2 text-content font-sans min-h-screen flex flex-col overflow-x-hidden">

    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[300] focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg">
        İçeriğe geç
    </a>

    <header class="bg-surface border-b border-border sticky top-0 z-50">
        <nav class="container mx-auto px-4 py-3">
            <div class="flex justify-between items-center gap-3">
