                                <i class="fa-solid fa-circle-user text-lg"></i>
                                <i class="fa-solid fa-chevron-down text-xs"></i>
                            </button>
                            <div id="account-menu" class="hidden absolute top-full right-0 mt-1 w-48 bg-surface rounded-lg shadow-lg border border-border z-50 overflow-hidden py-1">
                                <a asp-controller="Garage" asp-action="Index" class="block px-4 py-2.5 text-sm text-content hover:bg-surface-3 transition-colors"><i class="fa-solid fa-heart w-4 text-content-muted"></i> Garajım</a>
                                <a asp-controller="Manage" asp-action="Index" class="block px-4 py-2.5 text-sm text-content hover:bg-surface-3 transition-colors"><i class="fa-solid fa-gear w-4 text-content-muted"></i> Hesabım</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-controller="AdminCar" asp-action="Index" class="block px-4 py-2.5 text-sm text-content hover:bg-surface-3 transition-colors"><i class="fa-solid fa-toolbox w-4 text-content-muted"></i> Admin Panel</a>
                                }
