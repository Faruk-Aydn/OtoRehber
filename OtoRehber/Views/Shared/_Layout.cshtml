<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OtoRehber</title>
    <!-- PWA (Progressive Web App) Meta Etiketleri -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="apple-touch-icon" href="~/favicon.ico" />
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#2563eb', // Blue-600
                        success: '#10b981', // Emerald-500
                        danger: '#ef4444' // Red-500
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome & AOS CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script>
        // FOUC önlemek için sayfa render edilmeden önce temayı kontrol et
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 font-sans min-h-screen flex flex-col selection:bg-primary selection:text-white transition-colors duration-300">
    
    <!-- Glassmorphism Navbar -->
    <header class="bg-white/80 dark:bg-gray-800/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50 shadow-sm transition-all duration-300">
        <nav class="container mx-auto px-4 py-4 flex justify-between items-center">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-2xl font-extrabold tracking-tight text-primary dark:text-blue-400 flex items-center gap-2 hover:scale-105 transition-transform">
                <i class="fa-solid fa-car-side"></i>OtoRehber
            </a>
            <div class="space-x-6 flex items-center">
                
                <!-- Theme Toggle Button -->
                <button id="theme-toggle" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none rounded-lg text-sm p-2.5 transition-colors">
                    <i id="theme-toggle-dark-icon" class="fa-solid fa-moon hidden text-lg"></i>
                    <i id="theme-toggle-light-icon" class="fa-solid fa-sun hidden text-lg text-yellow-400"></i>
                </button>

                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 font-medium transition">Ana Sayfa</a>
                <a asp-area="" asp-controller="Compare" asp-action="Index" class="text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition">
                    <i class="fa-solid fa-scale-balanced mr-1"></i> Karşılaştırma
                </a>
                
                <!-- AI Sihirbaz -->
                <a asp-area="" asp-controller="AiWizard" asp-action="Index" class="text-gray-600 dark:text-gray-300 hover:text-purple-600 dark:hover:text-purple-400 font-medium transition flex items-center">
                    <i class="fa-solid fa-wand-magic-sparkles mr-1 text-purple-500"></i> AI Sihirbaz
                </a>

                <!-- İstatistikler -->
                <a asp-area="" asp-controller="Stats" asp-action="Index" class="text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 font-medium transition flex items-center">
                    <i class="fa-solid fa-chart-pie mr-1 text-indigo-500"></i> İstatistikler
                </a>

                <!-- Autocomplete Arama -->
                <div class="relative" id="navbar-search-wrap">
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
                        <input id="navbar-search-input" type="text" placeholder="Araç ara..." autocomplete="off"
                               class="bg-gray-100 dark:bg-gray-700 border-0 rounded-xl pl-9 pr-4 py-2 text-sm text-gray-800 dark:text-gray-200 placeholder-gray-400 focus:ring-2 focus:ring-primary outline-none w-44 transition-all focus:w-56" />
                    </div>
                    <!-- Öneri Dropdown -->
                    <div id="navbar-search-results" class="hidden absolute top-full left-0 mt-1 w-72 bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 z-50 overflow-hidden"></div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Garage" asp-action="Index" class="text-gray-600 dark:text-gray-300 hover:text-red-500 dark:hover:text-red-400 font-medium transition flex items-center">
                        <i class="fa-solid fa-heart mr-1 text-red-500"></i> Garajım
                    </a>
                    
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="" asp-controller="AdminCar" asp-action="Index" class="bg-primary hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center shadow-md hover:shadow-lg">
                            <i class="fa-solid fa-gear mr-2"></i> Admin Panel
                        </a>
                    }
                    
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        <button type="submit" class="text-gray-600 dark:text-gray-300 hover:text-red-500 dark:hover:text-red-400 transition text-sm font-medium flex items-center">
                            <i class="fa-solid fa-arrow-right-from-bracket mr-1"></i> Çıkış
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Register" class="text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 font-medium transition text-sm flex items-center">
                        <i class="fa-solid fa-user-plus mr-2"></i> Kayıt Ol
                    </a>
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-blue-400 font-medium transition text-sm flex items-center">
                        <i class="fa-solid fa-lock mr-2"></i> Giriş Yap
                    </a>
                }
            </div>
        </nav>
    </header>
    
    <main role="main" class="container mx-auto px-4 py-8 flex-grow">
        @RenderBody()
    </main>

    <!-- ===== GLOBAL TOAST BİLDİRİM SİSTEMİ ===== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="toast-success" class="fixed top-6 right-6 z-[200] flex items-center gap-3 bg-white dark:bg-gray-800 border-l-4 border-green-500 shadow-2xl rounded-xl px-5 py-4 max-w-sm transition-all duration-500" role="alert">
            <div class="flex-shrink-0 w-9 h-9 bg-green-100 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-circle-check text-green-600"></i>
            </div>
            <div>
                <p class="text-sm font-semibold text-gray-800 dark:text-gray-100">Başarılı!</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@TempData["SuccessMessage"]</p>
            </div>
            <button onclick="closeToast('toast-success')" class="ml-auto text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="toast-error" class="fixed top-6 right-6 z-[200] flex items-center gap-3 bg-white dark:bg-gray-800 border-l-4 border-red-500 shadow-2xl rounded-xl px-5 py-4 max-w-sm transition-all duration-500" role="alert">
            <div class="flex-shrink-0 w-9 h-9 bg-red-100 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-circle-xmark text-red-600"></i>
            </div>
            <div>
                <p class="text-sm font-semibold text-gray-800 dark:text-gray-100">Hata!</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@TempData["ErrorMessage"]</p>
            </div>
            <button onclick="closeToast('toast-error')" class="ml-auto text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div id="toast-info" class="fixed top-6 right-6 z-[200] flex items-center gap-3 bg-white dark:bg-gray-800 border-l-4 border-blue-500 shadow-2xl rounded-xl px-5 py-4 max-w-sm transition-all duration-500" role="alert">
            <div class="flex-shrink-0 w-9 h-9 bg-blue-100 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-circle-info text-blue-600"></i>
            </div>
            <div>
                <p class="text-sm font-semibold text-gray-800 dark:text-gray-100">Bilgi</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">@TempData["InfoMessage"]</p>
            </div>
            <button onclick="closeToast('toast-info')" class="ml-auto text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <footer class="bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 py-6 mt-auto transition-colors duration-300">
        <div class="container mx-auto px-4 text-center text-gray-500 dark:text-gray-400 text-sm">
            &copy; 2026 - OtoRehber - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="hover:text-primary dark:hover:text-blue-400 transition">Gizlilik Sözleşmesi</a>
        </div>
    </footer>
    
    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- AOS Animation Script -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true,
            offset: 50
        });

        // ===== TOAST SİSTEMİ =====
        function closeToast(id) {
            const el = document.getElementById(id);
            if (el) {
                el.style.opacity = '0';
                el.style.transform = 'translateX(120%)';
                setTimeout(() => el.remove(), 500);
            }
        }

        // Sayfada toast varsa 4 saniye sonra otomatik kapat
        document.addEventListener('DOMContentLoaded', function () {
            ['toast-success', 'toast-error', 'toast-info'].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) {
                    // Slide-in animasyonu
                    el.style.transform = 'translateX(120%)';
                    el.style.transition = 'all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                    setTimeout(() => { el.style.transform = 'translateX(0)'; }, 50);
                    // 4 saniye sonra kapat
                    setTimeout(() => closeToast(id), 4000);
                }
            });
        });
    </script>

    <!-- AI Chatbot Asistanı (V3) -->
    <div id="aiChatWidget" class="fixed bottom-6 right-6 z-[100]">
        <!-- Chat Butonu -->
        <button id="aiChatBtn" onclick="toggleChat()" class="bg-indigo-600 hover:bg-indigo-700 text-white rounded-full w-14 h-14 flex items-center justify-center shadow-lg hover:shadow-2xl transition-all transform hover:scale-110">
            <i class="fa-solid fa-robot text-2xl"></i>
        </button>

        <!-- Chat Penceresi -->
        <div id="aiChatWindow" class="hidden absolute bottom-16 right-0 w-80 sm:w-96 bg-white/95 dark:bg-gray-800/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 overflow-hidden flex flex-col transition-all origin-bottom-right" style="height: 500px;">
            <!-- Header -->
            <div class="bg-indigo-600 p-4 flex justify-between items-center text-white">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-sm">OtoRehber AI</h3>
                        <p class="text-xs text-indigo-200">Araç Öneri Asistanı</p>
                    </div>
                </div>
                <button onclick="toggleChat()" class="text-white hover:text-gray-200 focus:outline-none">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Messages Box -->
            <div id="aiChatMessages" class="flex-1 p-4 overflow-y-auto bg-gray-50/50 dark:bg-gray-900/50 space-y-4">
                <!-- Karşılama Mesajı -->
                <div class="flex items-start gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-robot text-indigo-600 text-xs"></i>
                    </div>
                    <div class="flex flex-col gap-1 w-full max-w-[85%]">
                        <div class="bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-800 dark:text-gray-100 p-3 rounded-e-xl rounded-es-xl text-sm shadow-sm">
                            Merhaba! Ben OtoRehber AI Asistanı. Sana sistemimizdeki araçlar arasından en uygununu önerebilirim. Bütçen veya aradığın özellikler neler?
                        </div>
                    </div>
                </div>
            </div>

            <!-- Input Box -->
            <div class="p-3 bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
                <form id="aiChatForm" onsubmit="sendAiMessage(event)" class="flex gap-2">
                    <input type="text" id="aiChatInput" autocomplete="off" placeholder="Mesajınızı yazın..." class="flex-1 bg-gray-100 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 text-sm border-0 rounded-full px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none">
                    <button type="submit" id="aiChatSubmit" class="w-10 h-10 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white flex items-center justify-center transition-colors">
                        <i class="fa-solid fa-paper-plane text-sm"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- AI Chatbot Javascript -->
    <script>
        function toggleChat() {
            const chatWindow = document.getElementById('aiChatWindow');
            chatWindow.classList.toggle('hidden');
            if(!chatWindow.classList.contains('hidden')) {
                document.getElementById('aiChatInput').focus();
            }
        }

        async function sendAiMessage(e) {
            e.preventDefault();
            const input = document.getElementById('aiChatInput');
            const message = input.value.trim();
            if (!message) return;

            appendMessage('user', message);
            input.value = '';
            
            // Yükleniyor animasyonu göster
            const loadingId = 'loading-' + Date.now();
            appendLoading(loadingId);
            scrollToBottom();

            try {
                const response = await fetch('/api/AiChat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });

                const data = await response.json();
                
                // Yükleniyor animasyonunu kaldır
                removeElement(loadingId);

                if (response.ok) {
                    appendMessage('ai', data.response);
                } else {
                    appendMessage('ai', "Hata: " + (data.error || "Sunucuya ulaşılamadı."));
                }
            } catch (error) {
                removeElement(loadingId);
                appendMessage('ai', "Bağlantı hatası oluştu. Lütfen tekrar deneyin.");
            }
            scrollToBottom();
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function appendMessage(sender, text) {
            const msgBox = document.getElementById('aiChatMessages');

            // Önce HTML olarak yorumlanabilecek her şeyi escape et (XSS koruması),
            // sonra sadece kendi eklediğimiz basit markdown biçimlendirmesini uygula.
            let formattedText = escapeHtml(text);
            formattedText = formattedText.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            formattedText = formattedText.replace(/\n/g, '<br/>');

            let html = '';
            if (sender === 'user') {
                html = `
                <div class="flex items-start gap-2.5 justify-end">
                    <div class="flex flex-col gap-1 w-full max-w-[85%] items-end">
                        <div class="bg-indigo-600 text-white p-3 rounded-s-xl rounded-ee-xl text-sm shadow-sm">
                            ${formattedText}
                        </div>
                    </div>
                </div>`;
            } else {
                html = `
                <div class="flex items-start gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-robot text-indigo-600 text-xs"></i>
                    </div>
                    <div class="flex flex-col gap-1 w-full max-w-[85%]">
                        <div class="bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-800 dark:text-gray-100 p-3 rounded-e-xl rounded-es-xl text-sm shadow-sm">
                            ${formattedText}
                        </div>
                    </div>
                </div>`;
            }
            msgBox.insertAdjacentHTML('beforeend', html);
        }

        function appendLoading(id) {
            const msgBox = document.getElementById('aiChatMessages');
            const html = `
            <div id="${id}" class="flex items-start gap-2.5">
                <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-robot text-indigo-600 text-xs"></i>
                </div>
                <div class="bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 p-3 rounded-e-xl rounded-es-xl shadow-sm flex gap-1 items-center h-10">
                    <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce"></div>
                    <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
                    <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                </div>
            </div>`;
            msgBox.insertAdjacentHTML('beforeend', html);
        }

        function removeElement(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        function scrollToBottom() {
            const msgBox = document.getElementById('aiChatMessages');
            msgBox.scrollTop = msgBox.scrollHeight;
        }

        async function toggleGarageHome(carId, btnElement) {
            try {
                const response = await fetch('/Garage/Toggle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: carId
                });

                if (response.ok) {
                    const data = await response.json();
                    const icon = btnElement.querySelector('i');
                    if (data.added) {
                        icon.classList.remove('text-gray-400');
                        icon.classList.add('text-red-500');
                    } else {
                        icon.classList.remove('text-red-500');
                        icon.classList.add('text-gray-400');
                    }
                } else if (response.status === 401) {
                    window.location.href = '/Account/Login';
                }
            } catch (error) {
                console.error("Hata:", error);
            }
        }

        // Theme Toggle Logic
        document.addEventListener('DOMContentLoaded', () => {
            const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
            const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
            const themeToggleBtn = document.getElementById('theme-toggle');

            // Set initial icon based on applied theme
            if (document.documentElement.classList.contains('dark')) {
                themeToggleLightIcon.classList.remove('hidden');
            } else {
                themeToggleDarkIcon.classList.remove('hidden');
            }

            themeToggleBtn.addEventListener('click', function() {
                // Toggle icons
                themeToggleDarkIcon.classList.toggle('hidden');
                themeToggleLightIcon.classList.toggle('hidden');

                // If is set in localStorage
                if (localStorage.getItem('theme')) {
                    if (localStorage.getItem('theme') === 'light') {
                        document.documentElement.classList.add('dark');
                        localStorage.setItem('theme', 'dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                        localStorage.setItem('theme', 'light');
                    }
                // If NOT set via local storage previously
                } else {
                    if (document.documentElement.classList.contains('dark')) {
                        document.documentElement.classList.remove('dark');
                        localStorage.setItem('theme', 'light');
                    } else {
                        document.documentElement.classList.add('dark');
                        localStorage.setItem('theme', 'dark');
                    }
                }
            });
        });
    </script>

    <!-- ===== AUTOCOMPLETE ARAMA ===== -->
    <script>
        (function () {
            const input   = document.getElementById('navbar-search-input');
            const results = document.getElementById('navbar-search-results');
            if (!input || !results) return;

            let debounceTimer;

            input.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const q = this.value.trim();

                if (q.length < 2) { results.classList.add('hidden'); results.innerHTML = ''; return; }

                debounceTimer = setTimeout(async () => {
                    try {
                        const res  = await fetch(`/api/Search/suggest?q=${encodeURIComponent(q)}`);
                        const data = await res.json();

                        if (!data.length) {
                            results.innerHTML = '<div class="p-4 text-sm text-gray-400 text-center">Sonuç bulunamadı</div>';
                            results.classList.remove('hidden');
                            return;
                        }

                        results.innerHTML = data.map(item => `
                            <a href="/Car/Details/${item.id}"
                               class="flex items-center justify-between px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 border-b border-gray-100 dark:border-gray-700 last:border-0 transition group">
                                <div>
                                    <p class="text-sm font-semibold text-gray-800 dark:text-gray-200 group-hover:text-primary">${item.label}</p>
                                    <p class="text-xs text-gray-400">${item.segment} Segmenti</p>
                                </div>
                                <span class="text-xs font-bold text-yellow-600 bg-yellow-50 dark:bg-yellow-900/20 px-2 py-0.5 rounded">
                                    ⭐ ${item.score}
                                </span>
                            </a>`).join('');
                        results.classList.remove('hidden');
                    } catch (e) { results.classList.add('hidden'); }
                }, 250);
            });

            // Dışarı tıklanınca kapat
            document.addEventListener('click', (e) => {
                if (!document.getElementById('navbar-search-wrap')?.contains(e.target)) {
                    results.classList.add('hidden');
                }
            });

            // Enter tuşu — ilk sonuca git
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    const first = results.querySelector('a');
                    if (first) first.click();
                }
            });
        })();

        // PWA Service Worker Registration
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('/service-worker.js').then(function(registration) {
                    console.log('ServiceWorker registration successful with scope: ', registration.scope);
                }, function(err) {
                    console.log('ServiceWorker registration failed: ', err);
                });
            });
        }
    </script>
</body>
</html>
