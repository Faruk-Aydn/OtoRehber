                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-content-muted text-sm pointer-events-none" aria-hidden="true"></i>
                        <input id="navbar-search-input" type="search" placeholder="Araç ara..." autocomplete="off"
                               aria-label="Araç ara" role="combobox" aria-expanded="false" aria-controls="navbar-search-results" aria-autocomplete="list"
