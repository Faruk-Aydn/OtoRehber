                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="w-full text-left px-4 py-2.5 text-sm text-content hover:bg-surface-3 transition-colors"><i class="fa-solid fa-arrow-right-from-bracket w-4 text-content-muted"></i> Çıkış</button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="@linkCls text-sm">Giriş</a>
                        <a asp-controller="Account" asp-action="Register" class="btn-primary btn-sm">Kayıt Ol</a>
                    }
                </div>

                <!-- MOBİL/TABLET: tema + hamburger -->
                <div class="flex lg:hidden items-center gap-1">
                    <button id="theme-toggle-m" type="button" aria-label="Karanlık/aydınlık tema değiştir" class="text-content-muted hover:text-content hover:bg-surface-3 rounded-lg p-2.5 focus:ring-2 focus:ring-brand-500 outline-none">
                        <i class="theme-dark-icon fa-solid fa-moon hidden text-lg" aria-hidden="true"></i>
                        <i class="theme-light-icon fa-solid fa-sun hidden text-lg" aria-hidden="true"></i>
                    </button>
                    <button id="mobile-menu-btn" type="button" aria-label="Menü" aria-expanded="false" aria-controls="mobile-menu" class="text-content hover:bg-surface-3 rounded-lg p-2.5 focus:ring-2 focus:ring-brand-500 outline-none">
                        <i class="fa-solid fa-bars text-xl" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <!-- MOBİL menü paneli -->
            @{
                var mLink = "block px-3 py-2.5 rounded-lg text-content-muted hover:text-content hover:bg-surface-3 font-medium transition-colors";
            }
            <div id="mobile-menu" class="hidden lg:hidden mt-3 pb-2 space-y-1 border-t border-border pt-3">
                <div class="relative mb-2">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-content-muted text-sm pointer-events-none"></i>
                    <input id="navbar-search-input-m" type="text" placeholder="Araç ara..." autocomplete="off"
                           class="w-full bg-surface-3 border border-border rounded-lg pl-9 pr-3 py-2.5 text-sm text-content placeholder:text-content-muted/70 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 outline-none" />
                    <div id="navbar-search-results-m" class="hidden mt-1 bg-surface rounded-lg shadow-lg border border-border overflow-hidden"></div>
                </div>
                <a asp-controller="Home" asp-action="Index" class="@mLink">Ana Sayfa</a>
                <a href="/araclar" class="@mLink">Tüm Araçlar</a>
                <a asp-controller="Compare" asp-action="Index" class="@mLink">Karşılaştırma</a>
                <a asp-controller="AiWizard" asp-action="Index" class="@mLink">AI Sihirbaz</a>
                <a href="/ilan-analizi" class="@mLink">İlan Analizi</a>
                <a asp-controller="Stats" asp-action="Index" class="@mLink">İstatistikler</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Garage" asp-action="Index" class="@mLink">Garajım</a>
                    <a asp-controller="Manage" asp-action="Index" class="@mLink">Hesabım</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="AdminCar" asp-action="Index" class="@mLink">Admin Panel</a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="w-full text-left @mLink">Çıkış</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="@mLink">Giriş Yap</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-primary w-full mt-1">Kayıt Ol</a>
                }
            </div>
        </nav>
    </header>
    
    @Html.AntiForgeryToken()

    <main id="main-content" role="main" tabindex="-1" class="container mx-auto px-4 py-8 flex-grow outline-none">
        @RenderBody()
    </main>

    <!-- ===== GLOBAL TOAST BİLDİRİM SİSTEMİ ===== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="toast-success" class="fixed top-4 right-4 left-4 sm:left-auto z-[200] flex items-center gap-3 bg-surface border border-border border-l-4 border-l-emerald-500 shadow-lg rounded-xl px-5 py-4 sm:max-w-sm transition-all duration-500" role="alert">
            <div class="flex-shrink-0 w-9 h-9 bg-emerald-50 dark:bg-emerald-500/15 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-circle-check text-emerald-600 dark:text-emerald-400"></i>
            </div>
            <div>
                <p class="text-sm font-semibold text-content">Başarılı!</p>
                <p class="text-xs text-content-muted mt-0.5">@TempData["SuccessMessage"]</p>
            </div>
            <button onclick="closeToast('toast-success')" class="ml-auto text-content-muted hover:text-content">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="toast-error" class="fixed top-4 right-4 left-4 sm:left-auto z-[200] flex items-center gap-3 bg-surface border border-border border-l-4 border-l-red-500 shadow-lg rounded-xl px-5 py-4 sm:max-w-sm transition-all duration-500" role="alert">
            <div class="flex-shrink-0 w-9 h-9 bg-red-50 dark:bg-red-500/15 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-circle-xmark text-red-600 dark:text-red-400"></i>
            </div>
            <div>
                <p class="text-sm font-semibold text-content">Hata!</p>
                <p class="text-xs text-content-muted mt-0.5">@TempData["ErrorMessage"]</p>
            </div>
            <button onclick="closeToast('toast-error')" class="ml-auto text-content-muted hover:text-content">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div id="toast-info" class="fixed top-4 right-4 left-4 sm:left-auto z-[200] flex items-center gap-3 bg-surface border border-border border-l-4 border-l-brand-500 shadow-lg rounded-xl px-5 py-4 sm:max-w-sm transition-all duration-500" role="alert">
            <div class="flex-shrink-0 w-9 h-9 bg-brand-50 dark:bg-brand-500/15 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-circle-info text-brand-600 dark:text-brand-400"></i>
            </div>
            <div>
                <p class="text-sm font-semibold text-content">Bilgi</p>
                <p class="text-xs text-content-muted mt-0.5">@TempData["InfoMessage"]</p>
            </div>
            <button onclick="closeToast('toast-info')" class="ml-auto text-content-muted hover:text-content">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <footer class="bg-surface border-t border-border py-8 mt-auto">
        <div class="container mx-auto px-4 text-center text-content-muted text-sm">
            @await Component.InvokeAsync("CatalogMenu")
            <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2 mb-4">
                <a asp-controller="Home" asp-action="Hakkimizda" class="hover:text-content transition-colors">Hakkımızda</a>
                <a asp-controller="Home" asp-action="Iletisim" class="hover:text-content transition-colors">İletişim</a>
                <a asp-controller="Home" asp-action="Privacy" class="hover:text-content transition-colors">Gizlilik Politikası</a>
                <a asp-controller="Home" asp-action="Kvkk" class="hover:text-content transition-colors">KVKK Aydınlatma Metni</a>
                <a asp-controller="Home" asp-action="KullanimKosullari" class="hover:text-content transition-colors">Kullanım Koşulları</a>
                <a asp-controller="Home" asp-action="Cerez" class="hover:text-content transition-colors">Çerez Politikası</a>
            </nav>
            <p>&copy; @DateTime.UtcNow.Year OtoRehber. İçerikler bilgilendirme amaçlıdır, bağlayıcı değildir.</p>
        </div>
    </footer>

    <!-- Çerez onay bildirimi -->
    <div id="cookie-banner" class="hidden fixed bottom-0 inset-x-0 z-[150] bg-gray-900 text-gray-100 text-sm">
        <div class="container mx-auto px-4 py-3 flex flex-col sm:flex-row items-center gap-3">
            <p class="flex-1 text-center sm:text-left">
                Yalnızca sitenin çalışması için gerekli çerezleri kullanıyoruz.
                <a asp-controller="Home" asp-action="Cerez" class="underline hover:text-white">Detaylı bilgi</a>.
            </p>
            <button onclick="acceptCookies()" class="bg-primary hover:bg-blue-700 text-white font-semibold px-4 py-1.5 rounded-lg whitespace-nowrap">Tamam</button>
        </div>
    </div>
    <script>
        (function () {
            try {
                if (localStorage.getItem('cookie-consent') !== 'ok') {
                    document.getElementById('cookie-banner').classList.remove('hidden');
                }
            } catch (e) { }
        })();
        function acceptCookies() {
            try { localStorage.setItem('cookie-consent', 'ok'); } catch (e) { }
            document.getElementById('cookie-banner').classList.add('hidden');
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- AOS Animation Script (self-hosted) -->
    <script src="~/lib/aos/aos.js" asp-append-version="true"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true,
            offset: 50
        });

        // ===== TOAST SİSTEMİ =====
        function closeToast(id) {
            const el = document.getElementById(id);
            if (el) {
                el.style.opacity = '0';
                el.style.transform = 'translateX(120%)';
                setTimeout(() => el.remove(), 500);
            }
        }

        // Sayfada toast varsa 4 saniye sonra otomatik kapat
        document.addEventListener('DOMContentLoaded', function () {
            ['toast-success', 'toast-error', 'toast-info'].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) {
                    // Slide-in animasyonu
                    el.style.transform = 'translateX(120%)';
                    el.style.transition = 'all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                    setTimeout(() => { el.style.transform = 'translateX(0)'; }, 50);
                    // 4 saniye sonra kapat
                    setTimeout(() => closeToast(id), 4000);
                }
            });
        });
    </script>

    <!-- AI Chatbot Asistanı -->
    <div id="aiChatWidget" class="fixed bottom-4 right-4 z-[100]">
        <!-- Chat Butonu -->
        <button id="aiChatBtn" type="button" onclick="toggleChat()" aria-label="Yapay zeka asistanını aç" aria-expanded="false" aria-controls="aiChatWindow" class="bg-brand-600 hover:bg-brand-700 text-white rounded-full w-14 h-14 flex items-center justify-center shadow-lg transition-colors focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 focus:ring-offset-surface-2 outline-none">
            <i class="fa-solid fa-robot text-2xl" aria-hidden="true"></i>
        </button>

        <!-- Chat Penceresi -->
        <div id="aiChatWindow" class="hidden absolute bottom-16 right-0 w-[calc(100vw-2rem)] max-w-sm bg-surface rounded-xl shadow-xl border border-border overflow-hidden flex flex-col origin-bottom-right h-[70vh] max-h-[500px] min-h-[360px]">
            <!-- Header -->
            <div class="bg-brand-600 p-4 flex justify-between items-center text-white">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-sm">OtoRehber AI</h3>
                        <p class="text-xs text-brand-100">Araç Öneri Asistanı</p>
                    </div>
                </div>
                <button onclick="toggleChat()" class="text-white/80 hover:text-white focus:outline-none">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Messages Box -->
            <div id="aiChatMessages" class="flex-1 p-4 overflow-y-auto bg-surface-2 space-y-4">
                <!-- Karşılama Mesajı -->
                <div class="flex items-start gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-brand-50 dark:bg-brand-500/15 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-robot text-brand-600 dark:text-brand-400 text-xs"></i>
                    </div>
                    <div class="flex flex-col gap-1 w-full max-w-[85%]">
                        <div class="bg-surface border border-border text-content p-3 rounded-e-xl rounded-es-xl text-sm">
                            Merhaba! Ben OtoRehber AI Asistanı. OtoRehber verilerine dayanarak araçlar hakkındaki sorularını yanıtlarım (kronik sorunlar, bakım maliyeti, skorlar). Bütçene göre araç önerisi için <a href="/AiWizard" class="text-brand-600 hover:underline">AI Sihirbaz</a>'ı kullanabilirsin.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Input Box -->
            <div class="p-3 bg-surface border-t border-border">
                <form id="aiChatForm" onsubmit="sendAiMessage(event)" class="flex gap-2">
                    <input type="text" id="aiChatInput" autocomplete="off" placeholder="Mesajınızı yazın..." class="flex-1 bg-surface-3 border border-border text-content placeholder:text-content-muted/70 text-sm rounded-full px-4 py-2 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 outline-none">
                    <button type="submit" id="aiChatSubmit" class="w-10 h-10 rounded-full bg-brand-600 hover:bg-brand-700 text-white flex items-center justify-center transition-colors shrink-0">
                        <i class="fa-solid fa-paper-plane text-sm"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Markdown (AI yanıtları) — self-host -->
    <script src="~/lib/marked/marked.min.js" asp-append-version="true"></script>
    <script src="~/lib/dompurify/purify.min.js" asp-append-version="true"></script>

    <!-- AI Chatbot Javascript -->
    @{
        var _isCarDetails = string.Equals(ViewContext.RouteData.Values["controller"] as string, "Car", StringComparison.OrdinalIgnoreCase)
            && string.Equals(ViewContext.RouteData.Values["action"] as string, "Details", StringComparison.OrdinalIgnoreCase);
        var _chatCarId = _isCarDetails && int.TryParse(ViewContext.RouteData.Values["id"] as string, out var _cid) ? _cid.ToString() : "null";
    }
    <script>
        // Araç detay sayfasındaysak chat'e o aracın bağlamını taşı (PRD v5 §4.8).
        window.__otoChatCarId = @Html.Raw(_chatCarId);
    </script>
    <script>
        // ===== ANTIFORGERY YARDIMCISI =====
        // Sunucudaki AutoValidateAntiforgeryToken filtresi tüm POST'larda token bekler.
        function antiForgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }
        function postJson(url, bodyObj) {
            return fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': antiForgeryToken()
                },
                body: JSON.stringify(bodyObj)
            });
        }

        function toggleChat() {
            const chatWindow = document.getElementById('aiChatWindow');
            chatWindow.classList.toggle('hidden');
            const open = !chatWindow.classList.contains('hidden');
            document.getElementById('aiChatBtn')?.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open) {
                document.getElementById('aiChatInput').focus();
            } else {
                document.getElementById('aiChatBtn')?.focus();
            }
        }

        async function sendAiMessage(e) {
            e.preventDefault();
            const input = document.getElementById('aiChatInput');
            const message = input.value.trim();
            if (!message) return;

            appendMessage('user', message);
            input.value = '';
            
            // Yükleniyor animasyonu göster
            const loadingId = 'loading-' + Date.now();
            appendLoading(loadingId);
            scrollToBottom();

            try {
                const carId = window.__otoChatCarId || null;
                const response = await postJson('/api/AiChat/send', carId ? { message: message, carId: carId } : { message: message });

                const data = await response.json();
                
                // Yükleniyor animasyonunu kaldır
                removeElement(loadingId);

                if (response.ok) {
                    appendMessage('ai', data.response);
                } else {
                    appendMessage('ai', "Hata: " + (data.error || "Sunucuya ulaşılamadı."));
                }
            } catch (error) {
                removeElement(loadingId);
                appendMessage('ai', "Bağlantı hatası oluştu. Lütfen tekrar deneyin.");
            }
            scrollToBottom();
        }

        function renderMarkdown(text) {
            // marked ile markdown -> HTML, ardından DOMPurify ile temizle (XSS koruması).
            try {
                return DOMPurify.sanitize(marked.parse(text ?? '', { breaks: true }));
            } catch (e) {
                const div = document.createElement('div');
                div.textContent = text ?? '';
                return div.innerHTML;
            }
        }

        function appendMessage(sender, text) {
            const msgBox = document.getElementById('aiChatMessages');
            let html = '';
            if (sender === 'user') {
                const div = document.createElement('div');
                div.textContent = text ?? '';
                html = `
                <div class="flex items-start gap-2.5 justify-end">
                    <div class="flex flex-col gap-1 w-full max-w-[85%] items-end">
                        <div class="bg-brand-600 text-white p-3 rounded-s-xl rounded-ee-xl text-sm whitespace-pre-wrap">
                            ${div.innerHTML}
                        </div>
                    </div>
                </div>`;
            } else {
                html = `
                <div class="flex items-start gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-brand-50 dark:bg-brand-500/15 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-robot text-brand-600 dark:text-brand-400 text-xs"></i>
                    </div>
                    <div class="flex flex-col gap-1 w-full max-w-[85%]">
                        <div class="prose-oto prose-sm bg-surface border border-border p-3 rounded-e-xl rounded-es-xl text-sm">
                            ${renderMarkdown(text)}
                        </div>
                    </div>
                </div>`;
            }
            msgBox.insertAdjacentHTML('beforeend', html);
        }

        function appendLoading(id) {
            const msgBox = document.getElementById('aiChatMessages');
            const html = `
            <div id="${id}" class="flex items-start gap-2.5">
                <div class="w-8 h-8 rounded-full bg-brand-50 dark:bg-brand-500/15 flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-robot text-brand-600 dark:text-brand-400 text-xs"></i>
                </div>
                <div class="bg-surface border border-border p-3 rounded-e-xl rounded-es-xl flex gap-1 items-center h-10">
                    <div class="w-2 h-2 bg-content-muted rounded-full animate-bounce"></div>
                    <div class="w-2 h-2 bg-content-muted rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
                    <div class="w-2 h-2 bg-content-muted rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                </div>
            </div>`;
            msgBox.insertAdjacentHTML('beforeend', html);
        }

        function removeElement(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
        }

        function scrollToBottom() {
            const msgBox = document.getElementById('aiChatMessages');
            msgBox.scrollTop = msgBox.scrollHeight;
        }

        async function toggleGarageHome(carId, btnElement) {
            try {
                const response = await postJson('/Garage/Toggle', carId);

                if (response.ok) {
                    const data = await response.json();
                    const icon = btnElement.querySelector('i');
                    if (data.added) {
                        icon.classList.remove('text-gray-400');
                        icon.classList.add('text-red-500');
                    } else {
                        icon.classList.remove('text-red-500');
                        icon.classList.add('text-gray-400');
                    }
                } else if (response.status === 401) {
                    window.location.href = '/Account/Login';
                }
            } catch (error) {
                console.error("Hata:", error);
            }
        }

        // ===== TEMA + MOBİL MENÜ =====
        document.addEventListener('DOMContentLoaded', () => {
            // Tema ikonlarını (masaüstü id + mobil class) güncelle
            function syncThemeIcons() {
                const dark = document.documentElement.classList.contains('dark');
                document.querySelectorAll('#theme-toggle-dark-icon, .theme-dark-icon')
                    .forEach(el => el.classList.toggle('hidden', dark));
                document.querySelectorAll('#theme-toggle-light-icon, .theme-light-icon')
                    .forEach(el => el.classList.toggle('hidden', !dark));
            }
            syncThemeIcons();

            function toggleTheme() {
                const nowDark = !document.documentElement.classList.contains('dark');
                document.documentElement.classList.toggle('dark', nowDark);
                try { localStorage.setItem('theme', nowDark ? 'dark' : 'light'); } catch (e) {}
                syncThemeIcons();
            }
            ['theme-toggle', 'theme-toggle-m'].forEach(id => {
                document.getElementById(id)?.addEventListener('click', toggleTheme);
            });

            // Mobil hamburger
            const menuBtn = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            function setMenu(open) {
                menu.classList.toggle('hidden', !open);
                menuBtn.querySelector('i').className = open ? 'fa-solid fa-xmark text-xl' : 'fa-solid fa-bars text-xl';
                menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
            }
            menuBtn?.addEventListener('click', () => setMenu(menu.classList.contains('hidden')));
            // Esc ile kapat
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !menu.classList.contains('hidden')) { setMenu(false); menuBtn.focus(); }
            });
            // Menüdeki bir bağlantıya tıklanınca kapat
            menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));

            // Hesap dropdown menüsü (masaüstü)
            const accBtn = document.getElementById('account-menu-btn');
            const accMenu = document.getElementById('account-menu');
            if (accBtn && accMenu) {
                const closeAcc = () => { accMenu.classList.add('hidden'); accBtn.setAttribute('aria-expanded', 'false'); };
                accBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const open = accMenu.classList.toggle('hidden');
                    accBtn.setAttribute('aria-expanded', open ? 'false' : 'true');
                });
                document.addEventListener('click', (e) => {
                    if (!document.getElementById('account-menu-wrap')?.contains(e.target)) closeAcc();
                });
                document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAcc(); });
            }
        });
    </script>

    <!-- ===== AUTOCOMPLETE ARAMA (masaüstü + mobil) ===== -->
    <script>
        function wireAutocomplete(inputId, resultsId) {
            const input = document.getElementById(inputId);
            const results = document.getElementById(resultsId);
            if (!input || !results) return;
            let debounceTimer;

            input.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const q = this.value.trim();
                if (q.length < 2) { results.classList.add('hidden'); results.innerHTML = ''; return; }
                debounceTimer = setTimeout(async () => {
                    try {
                        const res = await fetch(`/api/Search/suggest?q=${encodeURIComponent(q)}`);
                        const data = await res.json();
                        if (!data.length) {
                            results.innerHTML = '<div class="p-4 text-sm text-content-muted text-center">Sonuç bulunamadı</div>';
                            results.classList.remove('hidden'); return;
                        }
                        results.innerHTML = data.map(item => `
                            <a href="/Car/Details/${item.id}" role="option"
                               class="ac-item flex items-center justify-between px-4 py-3 hover:bg-surface-3 aria-selected:bg-surface-3 border-b border-border last:border-0 transition-colors group">
                                <div>
                                    <p class="text-sm font-semibold text-content group-hover:text-brand-600">${item.label}</p>
                                    <p class="text-xs text-content-muted">${item.segment} Segmenti</p>
                                </div>
                                ${item.score != null ? `<span class="text-xs font-semibold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/15 px-2 py-0.5 rounded">★ ${item.score}</span>` : ''}
                            </a>`).join('');
                        results.classList.remove('hidden');
                        input.setAttribute('aria-expanded', 'true');
                    } catch (e) { results.classList.add('hidden'); input.setAttribute('aria-expanded', 'false'); }
                }, 250);
            });

            // Klavye navigasyonu: ↑ ↓ Enter Esc
            let activeIdx = -1;
            input.addEventListener('keydown', (e) => {
                const items = [...results.querySelectorAll('.ac-item')];
                if (e.key === 'Escape') { results.classList.add('hidden'); input.setAttribute('aria-expanded', 'false'); activeIdx = -1; return; }
                if (!items.length) { if (e.key === 'Enter') { const f = results.querySelector('a'); if (f) f.click(); } return; }
                if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = (activeIdx + 1) % items.length; }
                else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = (activeIdx - 1 + items.length) % items.length; }
                else if (e.key === 'Enter') { e.preventDefault(); (items[activeIdx] || items[0]).click(); return; }
                else return;
                items.forEach((it, i) => it.setAttribute('aria-selected', i === activeIdx ? 'true' : 'false'));
                items[activeIdx]?.scrollIntoView({ block: 'nearest' });
            });
            input.addEventListener('blur', () => setTimeout(() => { results.classList.add('hidden'); input.setAttribute('aria-expanded', 'false'); }, 150));
        }
        wireAutocomplete('navbar-search-input', 'navbar-search-results');
        wireAutocomplete('navbar-search-input-m', 'navbar-search-results-m');

        document.addEventListener('click', (e) => {
            if (!document.getElementById('navbar-search-wrap')?.contains(e.target))
                document.getElementById('navbar-search-results')?.classList.add('hidden');
        });

        // PWA Service Worker Registration
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('/service-worker.js').then(function(registration) {
                    console.log('ServiceWorker registration successful with scope: ', registration.scope);
                }, function(err) {
                    console.log('ServiceWorker registration failed: ', err);
                });
            });
        }
    </script>
</body>
