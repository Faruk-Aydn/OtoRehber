                        <div id="navbar-search-results" role="listbox" class="hidden absolute top-full right-0 mt-1 w-72 bg-surface rounded-lg shadow-lg border border-border z-50 overflow-hidden"></div>
                    </div>

                    <button id="theme-toggle" type="button" aria-label="Karanlık/aydınlık tema değiştir" class="text-content-muted hover:text-content hover:bg-surface-3 rounded-lg p-2 transition-colors focus:ring-2 focus:ring-brand-500 outline-none">
