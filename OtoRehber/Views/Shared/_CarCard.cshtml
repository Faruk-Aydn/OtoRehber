@model OtoRehber.Domain.DTOs.CarListDto
@{
    var ratings = ViewData["Ratings"] as IDictionary<int, (double Avg, int Count)>;
    var showCompare = ViewData["ShowCompare"] as bool? ?? false;
    (double Avg, int Count) rt = default;
    var hasRating = ratings != null && ratings.TryGetValue(Model.Id, out rt);
}
<div class="card card-hover overflow-hidden flex flex-col h-full" data-aos="fade-up">
    <div class="relative h-44 bg-surface-3 flex items-center justify-center group border-b border-border">
        @if (showCompare)
        {
            <div class="absolute top-3 left-3 bg-surface/95 p-2 rounded-lg border border-border opacity-0 group-hover:opacity-100 transition-opacity focus-within:opacity-100 [&:has(:checked)]:opacity-100 z-10">
                <label class="flex items-center cursor-pointer gap-2">
                    <input type="checkbox" class="compare-checkbox w-4 h-4 accent-brand-600 rounded" value="@Model.Id" data-brand="@Model.Brand @Model.ModelName">
                    <span class="text-xs font-semibold text-content uppercase tracking-wide">Kıyasla</span>
                </label>
            </div>
        }
        <button type="button" onclick="toggleGarageHome(@Model.Id, this)" class="absolute top-3 right-3 bg-surface/95 p-2 w-9 h-9 rounded-full border border-border z-10 flex items-center justify-center text-content-muted hover:text-red-500 transition-colors focus:ring-2 focus:ring-brand-500 outline-none" title="Garaja Ekle" aria-label="@Model.Brand @Model.ModelName aracını garajıma ekle/çıkar">
            <i class="fa-solid fa-heart" aria-hidden="true"></i>
        </button>

        <div class="absolute bottom-3 left-3 badge bg-surface/95 border border-border text-content z-10" title="Uzman güvenilirlik puanı">
            <i class="fa-solid fa-star text-amber-500"></i> @Model.ReliabilityScore<span class="text-content-muted">/10</span>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Brand @Model.ModelName" class="absolute inset-0 w-full h-full object-cover" />
        }
        else
        {
            <i class="fa-solid fa-car-side text-6xl text-content-muted/40"></i>
        }
    </div>

    <div class="p-5 flex flex-col flex-grow">
        <h2 class="text-lg font-semibold text-content tracking-tight">@Model.Brand @Model.ModelName</h2>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-1.5 text-xs text-content-muted">
            <span><i class="fa-regular fa-calendar-days mr-1"></i>@Model.ProductionYears</span>
            <span class="text-border">·</span>
            <span class="uppercase tracking-wider font-medium">@Model.Segment</span>
            @if (!string.IsNullOrEmpty(Model.BodyType))
            {
                <span class="text-border">·</span><span>@Model.BodyType</span>
            }
        </div>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-1 text-xs text-content-muted">
            @if (!string.IsNullOrEmpty(Model.FuelType))
            {
                <span class="badge-muted">@Model.FuelType</span>
            }
            @if (!string.IsNullOrEmpty(Model.Transmission))
            {
                <span class="badge-muted">@Model.Transmission</span>
            }
            @if (Model.PowerHp is > 0)
            {
                <span class="badge-muted">@Model.PowerHp HP</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Model.Engine))
        {
            <p class="mt-1.5 text-xs text-content-muted line-clamp-1" title="@Model.Engine">@Model.Engine</p>
        }

        @if (hasRating)
        {
            <p class="text-xs text-content-muted mt-2 flex items-center gap-1">
                <i class="fa-solid fa-star text-amber-500"></i>
                <span class="font-semibold text-content">@rt.Avg.ToString("0.#")</span>
                <span>/ 10 · @rt.Count kullanıcı yorumu</span>
            </p>
        }

        <p class="text-content-muted text-sm mt-3 mb-4 line-clamp-3 leading-relaxed">@Model.ExpertSummary</p>

        <div class="mt-auto pt-4 border-t border-border flex justify-between items-end gap-3">
            <div class="flex flex-col">
                <span class="text-[10px] text-content-muted font-semibold uppercase tracking-widest">Piyasa</span>
                <span class="text-sm font-semibold text-content">@Model.MinPrice.ToString("N0") – @Model.MaxPrice.ToString("N0") ₺</span>
            </div>
            <a asp-controller="Car" asp-action="Details" asp-route-id="@Model.Id" class="btn-primary btn-sm shrink-0">
                İncele <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </div>
</div>
