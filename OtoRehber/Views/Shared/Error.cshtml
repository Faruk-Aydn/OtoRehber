@model ErrorViewModel
@{
    var is404 = Model.StatusCode == 404;
    ViewData["Title"] = is404 ? "Sayfa bulunamadı" : "Bir hata oluştu";

    var (icon, title, message) = Model.StatusCode switch
    {
        404 => ("fa-compass", "Sayfa bulunamadı", "Aradığınız sayfa taşınmış veya hiç var olmamış olabilir."),
        403 => ("fa-lock", "Erişim reddedildi", "Bu sayfayı görüntüleme yetkiniz yok."),
        429 => ("fa-hourglass-half", "Çok fazla istek", "Kısa sürede çok fazla istek gönderdiniz. Lütfen biraz bekleyin."),
        _   => ("fa-triangle-exclamation", "Bir şeyler ters gitti", "Beklenmeyen bir hata oluştu. Ekibimiz bilgilendirildi, lütfen daha sonra tekrar deneyin.")
    };
}

<div class="max-w-xl mx-auto text-center py-16">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-500 mb-6">
        <i class="fa-solid @icon text-3xl"></i>
    </div>

    @if (Model.StatusCode >= 400)
    {
        <p class="text-6xl font-black text-gray-200 dark:text-gray-700 mb-2">@Model.StatusCode</p>
    }

    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">@title</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">@message</p>

    <a asp-controller="Home" asp-action="Index"
       class="inline-flex items-center bg-primary hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl transition">
        <i class="fa-solid fa-house mr-2"></i> Ana sayfaya dön
    </a>

    @if (Model.ShowRequestId)
    {
        <p class="text-xs text-gray-400 dark:text-gray-600 mt-8">
            Hata referansı: <code>@Model.RequestId</code>
        </p>
    }
</div>
