@model IEnumerable<OtoRehber.Domain.Entities.Car>

@{
    ViewData["Title"] = "Araç Karşılaştırma";
    ViewData["Description"] = "İki aracı yan yana karşılaştırın: fiyat, güvenilirlik, kronik sorunlar ve yapay zeka hakem yorumu ile hangi araç sizin için daha uygun öğrenin.";
}

<div class="max-w-4xl mx-auto py-8">
    <div class="text-center mb-8" data-aos="fade-down">
        <h1 class="text-2xl sm:text-3xl font-bold text-content tracking-tight mb-3">Araç karşılaştırma</h1>
        <p class="text-content-muted max-w-xl mx-auto">
            İki modeli seçin; fiyat, güvenilirlik ve kronik sorunları yan yana görün, yapay zeka hakem yorumunu alın.
        </p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="card border-l-4 border-l-red-500 p-4 mb-6 flex items-center gap-3">
            <i class="fa-solid fa-circle-exclamation text-red-500 text-lg"></i>
            <p class="text-content text-sm">@TempData["ErrorMessage"]</p>
        </div>
    }

    <div class="card card-pad" data-aos="fade-up">
        <form asp-action="Result" method="get">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="label" for="car1">1. araç</label>
                    <select id="car1" name="car1Id" class="select" required>
                        <option value="" disabled selected>Bir araç seçin…</option>
                        @foreach (var car in Model)
                        {
                            <option value="@car.Id">@car.Brand @car.ModelName (@car.Segment)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="label" for="car2">2. araç</label>
                    <select id="car2" name="car2Id" class="select" required>
                        <option value="" disabled selected>Bir araç seçin…</option>
                        @foreach (var car in Model)
                        {
                            <option value="@car.Id">@car.Brand @car.ModelName (@car.Segment)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mt-8 text-center">
                <button type="submit" class="btn-primary btn-lg">
                    <i class="fa-solid fa-scale-balanced"></i> Kıyasla ve AI yorumunu al
                </button>
            </div>
        </form>
    </div>
</div>
