@model OtoRehber.Models.CarCompareViewModel
@{
    ViewData["Title"] = "Araç Karşılaştırma";
}

<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    
    <!-- Başlık -->
    <div class="text-center mb-10">
        <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight flex justify-center items-center gap-4">
            <span class="text-primary">@Model.Car1.Brand</span> vs <span class="text-secondary">@Model.Car2.Brand</span>
        </h1>
        <p class="mt-4 text-xl text-gray-500">
            Hangi araç sizin için daha uygun? Uzman görüşleri ve sanayi gerçekleriyle karşılaştırın.
        </p>
    </div>

    <!-- Karşılaştırma Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Araç 1 Kolonu -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden border-2 border-primary/20 hover:border-primary/50 transition-all duration-300">
            <!-- Araç 1 Başlık -->
            <div class="bg-primary text-white p-6 text-center">
                <h2 class="text-3xl font-bold">@Model.Car1.Brand @Model.Car1.ModelName</h2>
                <p class="text-primary-100 mt-2 font-medium">@Model.Car1.Engine &bull; @Model.Car1.Segment Segment</p>
            </div>
            
            <div class="p-6 space-y-6">
                <!-- Temel Veriler -->
                <div class="flex justify-between items-center bg-gray-50 p-4 rounded-xl">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Güvenilirlik Puanı</p>
                        <p class="text-2xl font-bold text-gray-900">@Model.Car1.ReliabilityScore / 10</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-500 font-medium">Tahmini Yıllık Bakım</p>
                        <p class="text-2xl font-bold text-red-500">~@Model.Car1.EstimatedMaintenanceCostEUR €</p>
                    </div>
                </div>

                <!-- Uzman Özeti -->
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2 border-b pb-2"><i class="fa-solid fa-quote-left text-primary mr-2"></i>Uzman Özeti</h3>
                    <p class="text-gray-700 leading-relaxed text-sm">@Model.Car1.ExpertSummary</p>
                </div>

                <!-- Artılar & Eksiler -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <h4 class="font-bold text-green-600 mb-2"><i class="fa-solid fa-plus-circle mr-1"></i>Artılar</h4>
                        <ul class="text-sm text-gray-600 space-y-1 list-disc list-inside">
                            @foreach(var pro in Model.Car1.ProsConsList.Where(p => p.Type == "Pro")) {
                                <li>@pro.Description</li>
                            }
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-bold text-red-500 mb-2"><i class="fa-solid fa-minus-circle mr-1"></i>Eksiler</h4>
                        <ul class="text-sm text-gray-600 space-y-1 list-disc list-inside">
                            @foreach(var con in Model.Car1.ProsConsList.Where(p => p.Type == "Con")) {
                                <li>@con.Description</li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Kronik Sorunlar -->
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2"><i class="fa-solid fa-wrench text-orange-500 mr-2"></i>Kronik Sorunlar</h3>
                    @if(Model.Car1.ChronicIssues.Any()) {
                        <div class="space-y-3">
                            @foreach(var issue in Model.Car1.ChronicIssues) {
                                <div class="bg-orange-50 border border-orange-100 rounded-lg p-3">
                                    <div class="flex justify-between items-start">
                                        <h4 class="font-bold text-gray-900 text-sm">@issue.IssueTitle</h4>
                                        <span class="text-xs font-bold text-red-500 ml-2">~@issue.EstimatedCostEUR €</span>
                                    </div>
                                    <p class="text-xs text-gray-600 mt-1">@issue.Description</p>
                                </div>
                            }
                        </div>
                    } else {
                        <p class="text-sm text-gray-500 italic">Bilinen kronik sorun kaydedilmemiş.</p>
                    }
                </div>
            </div>
        </div>


        <!-- Araç 2 Kolonu -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden border-2 border-secondary/20 hover:border-secondary/50 transition-all duration-300">
            <!-- Araç 2 Başlık -->
            <div class="bg-secondary text-white p-6 text-center">
                <h2 class="text-3xl font-bold">@Model.Car2.Brand @Model.Car2.ModelName</h2>
                <p class="text-indigo-100 mt-2 font-medium">@Model.Car2.Engine &bull; @Model.Car2.Segment Segment</p>
            </div>
            
            <div class="p-6 space-y-6">
                <!-- Temel Veriler -->
                <div class="flex justify-between items-center bg-gray-50 p-4 rounded-xl">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Güvenilirlik Puanı</p>
                        <p class="text-2xl font-bold text-gray-900">@Model.Car2.ReliabilityScore / 10</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-gray-500 font-medium">Tahmini Yıllık Bakım</p>
                        <p class="text-2xl font-bold text-red-500">~@Model.Car2.EstimatedMaintenanceCostEUR €</p>
                    </div>
                </div>

                <!-- Uzman Özeti -->
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2 border-b pb-2"><i class="fa-solid fa-quote-left text-secondary mr-2"></i>Uzman Özeti</h3>
                    <p class="text-gray-700 leading-relaxed text-sm">@Model.Car2.ExpertSummary</p>
                </div>

                <!-- Artılar & Eksiler -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <h4 class="font-bold text-green-600 mb-2"><i class="fa-solid fa-plus-circle mr-1"></i>Artılar</h4>
                        <ul class="text-sm text-gray-600 space-y-1 list-disc list-inside">
                            @foreach(var pro in Model.Car2.ProsConsList.Where(p => p.Type == "Pro")) {
                                <li>@pro.Description</li>
                            }
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-bold text-red-500 mb-2"><i class="fa-solid fa-minus-circle mr-1"></i>Eksiler</h4>
                        <ul class="text-sm text-gray-600 space-y-1 list-disc list-inside">
                            @foreach(var con in Model.Car2.ProsConsList.Where(p => p.Type == "Con")) {
                                <li>@con.Description</li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Kronik Sorunlar -->
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2"><i class="fa-solid fa-wrench text-orange-500 mr-2"></i>Kronik Sorunlar</h3>
                    @if(Model.Car2.ChronicIssues.Any()) {
                        <div class="space-y-3">
                            @foreach(var issue in Model.Car2.ChronicIssues) {
                                <div class="bg-orange-50 border border-orange-100 rounded-lg p-3">
                                    <div class="flex justify-between items-start">
                                        <h4 class="font-bold text-gray-900 text-sm">@issue.IssueTitle</h4>
                                        <span class="text-xs font-bold text-red-500 ml-2">~@issue.EstimatedCostEUR €</span>
                                    </div>
                                    <p class="text-xs text-gray-600 mt-1">@issue.Description</p>
                                </div>
                            }
                        </div>
                    } else {
                        <p class="text-sm text-gray-500 italic">Bilinen kronik sorun kaydedilmemiş.</p>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- Geri Butonu -->
    <div class="mt-12 text-center">
        <a asp-controller="Home" asp-action="Index" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-full text-white bg-gray-900 hover:bg-gray-800 transition-colors shadow-lg hover:shadow-xl">
            <i class="fa-solid fa-arrow-left mr-2"></i> Vitrine Dön
        </a>
    </div>

</div>
