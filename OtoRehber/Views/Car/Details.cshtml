@model OtoRehber.Models.Car
@{
    ViewData["Title"] = $"{Model.Brand} {Model.ModelName} İncelemesi";
}

<!-- Hero Section -->
<div class="bg-white rounded-2xl shadow-md overflow-hidden mb-8 border border-gray-200">
    <div class="md:flex">
        <div class="md:shrink-0 bg-gray-200 md:w-1/3 flex items-center justify-center min-h-[250px] text-gray-400">
             <i class="fa-solid fa-car-side text-8xl"></i>
        </div>
        <div class="p-8 md:w-2/3 flex flex-col justify-center">
            <div class="uppercase tracking-wide text-sm text-primary font-semibold">@Model.Segment Segmenti</div>
            <h1 class="mt-1 text-3xl font-extrabold text-gray-900 leading-tight">@Model.Brand @Model.ModelName</h1>
            <p class="mt-2 text-gray-500 font-medium"><i class="fa-solid fa-gauge-high mr-2 text-gray-400"></i>@Model.Engine</p>
            
            <div class="mt-6 flex flex-wrap gap-4">
                <div class="bg-blue-50 border border-blue-100 rounded-lg p-4 flex-1 min-w-[150px]">
                    <div class="text-blue-500 text-sm font-semibold mb-1">Güvenilirlik Puanı</div>
                    <div class="text-2xl font-bold text-gray-900"><i class="fa-solid fa-star text-yellow-400 mr-2"></i>@Model.ReliabilityScore / 10</div>
                </div>
                <div class="bg-green-50 border border-green-100 rounded-lg p-4 flex-1 min-w-[150px]">
                    <div class="text-green-600 text-sm font-semibold mb-1">Piyasa Fiyatı</div>
                    <div class="text-xl font-bold text-gray-900"><i class="fa-solid fa-tag text-green-500 mr-2"></i>@Model.PriceRange</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Sol Kolon: Uzman Özeti & Artılar/Eksiler -->
    <div class="lg:col-span-2 space-y-8">
        
        <!-- Uzman Özeti -->
        <div class="bg-white rounded-2xl shadow-sm p-6 border border-gray-100">
            <h2 class="text-xl font-bold text-gray-900 mb-4 border-b pb-2"><i class="fa-solid fa-quote-left text-primary mr-2"></i>Uzman Özeti</h2>
            <p class="text-gray-700 leading-relaxed">
                @Model.ExpertSummary
            </p>
        </div>

        <!-- Artılar ve Eksiler Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Artılar -->
            <div class="bg-green-50/50 rounded-2xl shadow-sm p-6 border border-green-100">
                <h3 class="text-lg font-bold text-success mb-4 flex items-center"><i class="fa-solid fa-circle-check mr-2"></i>Artılar</h3>
                <ul class="space-y-3">
                    @if(Model.Pros != null && Model.Pros.Any())
                    {
                        foreach(var pro in Model.Pros)
                        {
                            <li class="flex items-start">
                                <i class="fa-solid fa-check text-success mt-1 mr-3"></i>
                                <span class="text-gray-700">@pro</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="text-gray-500 italic">Veri bulunamadı.</li>
                    }
                </ul>
            </div>
            
            <!-- Eksiler -->
            <div class="bg-red-50/50 rounded-2xl shadow-sm p-6 border border-red-100">
                <h3 class="text-lg font-bold text-danger mb-4 flex items-center"><i class="fa-solid fa-circle-xmark mr-2"></i>Eksiler</h3>
                <ul class="space-y-3">
                    @if(Model.Cons != null && Model.Cons.Any())
                    {
                        foreach(var con in Model.Cons)
                        {
                            <li class="flex items-start">
                                <i class="fa-solid fa-xmark text-danger mt-1 mr-3"></i>
                                <span class="text-gray-700">@con</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="text-gray-500 italic">Veri bulunamadı.</li>
                    }
                </ul>
            </div>
        </div>

    </div>

    <!-- Sağ Kolon: Kronik Sorunlar -->
    <div class="space-y-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="bg-gray-50 border-b border-gray-200 p-5">
                <h2 class="text-lg font-bold text-gray-900 flex items-center">
                    <i class="fa-solid fa-triangle-exclamation text-orange-500 mr-2"></i>Bilinen Kronik Sorunlar
                </h2>
                <p class="text-sm text-gray-500 mt-1">Tahmini tamir maliyetleri: <span class="font-bold text-gray-700">~@Model.EstimatedMaintenanceCostEUR € / Yıl</span></p>
            </div>
            
            <div class="divide-y divide-gray-100 p-2">
                @if (Model.ChronicIssues != null && Model.ChronicIssues.Any())
                {
                    foreach (var issue in Model.ChronicIssues)
                    {
                        var severityColor = issue.Severity.ToLower() == "kritik" ? "text-red-600 bg-red-100 border-red-200" :
                                          issue.Severity.ToLower() == "orta" ? "text-orange-600 bg-orange-100 border-orange-200" :
                                          "text-yellow-600 bg-yellow-100 border-yellow-200";
                        
                        <div class="p-4 hover:bg-gray-50 transition rounded-lg m-1">
                            <div class="flex justify-between items-start mb-2">
                                <h4 class="font-semibold text-gray-900">@issue.IssueTitle</h4>
                                <span class="text-xs font-bold px-2 py-1 rounded border @severityColor">@issue.Severity</span>
                            </div>
                            <p class="text-sm text-gray-600 mb-3">@issue.Description</p>
                            
                            <div class="flex items-center justify-between text-xs font-medium bg-gray-50 p-2 rounded border border-gray-100">
                                <span class="text-gray-500"><i class="fa-regular fa-calendar mr-1"></i>Riskli Yıllar: <span class="text-gray-700">@issue.AffectedYears</span></span>
                                <span class="text-red-500"><i class="fa-solid fa-screwdriver-wrench mr-1"></i>~@issue.EstimatedCostEUR €</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-8 text-center text-gray-500">
                        <i class="fa-solid fa-clipboard-check text-3xl mb-2 text-green-400"></i>
                        <p>Bilinen kritik bir sorun raporlanmamış.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-8 text-center">
    <a asp-action="Index" class="inline-flex items-center text-gray-500 hover:text-primary font-medium transition">
        <i class="fa-solid fa-arrow-left mr-2"></i> Vitrine Dön
    </a>
</div>