@model OtoRehber.Domain.DTOs.CarDetailDto
@{
    ViewData["Title"] = $"{Model.Brand} {Model.ModelName} İncelemesi";

    var _plainSummary = System.Text.RegularExpressions.Regex.Replace(Model.ExpertSummary ?? "", "<.*?>|[#*_`>]", " ").Trim();
    if (_plainSummary.Length > 300) _plainSummary = _plainSummary.Substring(0, 297).TrimEnd() + "…";
    ViewData["Description"] = string.IsNullOrWhiteSpace(_plainSummary)
        ? $"{Model.Brand} {Model.ModelName}: güvenilirlik puanı {Model.ReliabilityScore:0.#}/10, kronik sorunlar, bakım maliyetleri ve kullanıcı yorumları."
        : _plainSummary;
    ViewData["OgType"] = "article";
    if (!string.IsNullOrEmpty(Model.ImageUrl)) ViewData["OgImage"] = Model.ImageUrl;

    var _reviews = Model.Reviews ?? new List<OtoRehber.Domain.Entities.CarReview>();
    var _ratedCount = _reviews.Count;
    var _avgRating = _ratedCount > 0 ? System.Math.Round(_reviews.Average(r => r.Rating), 1) : 0d;

    var _req = Context.Request;
    var _pageUrl = $"{_req.Scheme}://{_req.Host}{_req.Path}";
    var _imgAbs = string.IsNullOrEmpty(Model.ImageUrl) ? null
        : (Model.ImageUrl.StartsWith("http") ? Model.ImageUrl : $"{_req.Scheme}://{_req.Host}{Model.ImageUrl}");

    var _jsonLd = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Car",
        ["name"] = $"{Model.Brand} {Model.ModelName}",
        ["brand"] = new Dictionary<string, object> { ["@type"] = "Brand", ["name"] = Model.Brand },
        ["model"] = Model.ModelName,
        ["vehicleConfiguration"] = Model.Segment,
        ["description"] = ViewData["Description"] as string ?? "",
        ["url"] = _pageUrl,
        ["offers"] = new Dictionary<string, object>
        {
            ["@type"] = "AggregateOffer",
            ["priceCurrency"] = "TRY",
            ["lowPrice"] = Model.MinPrice,
            ["highPrice"] = Model.MaxPrice
        }
    };
    if (_imgAbs != null) _jsonLd["image"] = _imgAbs;
    if (_ratedCount > 0)
    {
        _jsonLd["aggregateRating"] = new Dictionary<string, object>
        {
            ["@type"] = "AggregateRating",
            ["ratingValue"] = _avgRating,
            ["bestRating"] = 10,
            ["worstRating"] = 1,
            ["ratingCount"] = _ratedCount
        };
    }
    var _jsonLdString = System.Text.Json.JsonSerializer.Serialize(_jsonLd);
    var _gallery = (ViewBag.Gallery as List<string>) ?? new List<string>();
}

<script type="application/ld+json">@Html.Raw(_jsonLdString)</script>

<!-- Hero -->
<div class="card overflow-hidden mb-8" data-aos="fade-down">
    <div class="md:flex">
        <div class="md:shrink-0 bg-surface-3 md:w-1/3 min-h-[250px] text-content-muted relative overflow-hidden">
            @if (_gallery.Count > 0)
            {
                <img id="gallery-main" src="@_gallery[0]" alt="@Model.Brand @Model.ModelName" class="absolute inset-0 w-full h-full object-cover" />
                @if (_gallery.Count > 1)
                {
                    <div class="absolute bottom-2 left-2 right-2 flex gap-2 overflow-x-auto pb-1">
                        @foreach (var g in _gallery)
                        {
                            <button type="button" onclick="document.getElementById('gallery-main').src=this.dataset.src" data-src="@g"
                                    class="flex-shrink-0 w-14 h-10 rounded-md overflow-hidden border-2 border-white/70 hover:border-white focus:border-brand-500 outline-none">
                                <img src="@g" alt="" class="w-full h-full object-cover" />
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="absolute inset-0 flex items-center justify-center"><i class="fa-solid fa-car-side text-8xl text-content-muted/40"></i></div>
            }
        </div>
        <div class="p-6 sm:p-8 md:w-2/3 flex flex-col justify-center">
            <div class="flex justify-between items-start gap-3">
                <div>
                    <div class="flex items-center flex-wrap gap-2 mb-2">
                        <a href="/marka/@OtoRehber.Controllers.CatalogController.Slugify(Model.Brand)" class="badge-muted uppercase tracking-wide hover:text-content transition-colors">@Model.Brand</a>
                        <a href="/segment/@OtoRehber.Controllers.CatalogController.Slugify(Model.Segment)" class="badge-brand uppercase tracking-wide">@Model.Segment segmenti</a>
                        <span class="badge-muted uppercase tracking-wide"><i class="fa-regular fa-calendar-days"></i> @Model.ProductionYears</span>
                    </div>
                    <h1 class="mt-1 text-2xl sm:text-3xl font-bold text-content leading-tight tracking-tight">@Model.Brand @Model.ModelName</h1>
                </div>
                <button type="button" onclick="toggleGarageHome(@Model.Id, this)" class="bg-surface-3 p-3 w-12 h-12 rounded-full border border-border flex items-center justify-center text-content-muted hover:text-red-500 transition-colors focus:ring-2 focus:ring-brand-500 outline-none shrink-0" title="Garaja Ekle" aria-label="Bu aracı garajıma ekle/çıkar">
                    <i class="fa-solid fa-heart text-xl" aria-hidden="true"></i>
                </button>
            </div>

            <div class="mt-4 rounded-lg bg-surface-2 p-4 border border-border">
                <div class="flex items-start gap-3">
                    <div class="mt-0.5 bg-surface p-2 rounded-lg border border-border text-content-muted">
                        <i class="fa-solid fa-gears text-lg"></i>
                    </div>
                    <div>
                        <div class="text-xs text-content-muted font-semibold uppercase mb-1">Motor &amp; şanzıman</div>
                        <p class="text-content font-medium text-sm leading-relaxed">@Model.Engine</p>
                    </div>
                </div>
            </div>

            <div class="mt-6 grid grid-cols-2 @(_ratedCount > 0 ? "sm:grid-cols-3" : "sm:grid-cols-2") gap-3">
                <div class="rounded-lg border border-border bg-surface-2 p-4">
                    <div class="text-content-muted text-xs font-semibold uppercase mb-1">Uzman puanı</div>
                    <div class="text-xl font-bold text-content"><i class="fa-solid fa-star text-amber-500 mr-1.5"></i>@Model.ReliabilityScore<span class="text-content-muted text-sm">/10</span></div>
                </div>
                @if (_ratedCount > 0)
                {
                    <div class="rounded-lg border border-border bg-surface-2 p-4">
                        <div class="text-content-muted text-xs font-semibold uppercase mb-1">Kullanıcı (@_ratedCount)</div>
                        <div class="text-xl font-bold text-content"><i class="fa-solid fa-users text-content-muted mr-1.5"></i>@_avgRating.ToString("0.#")<span class="text-content-muted text-sm">/10</span></div>
                    </div>
                }
                <div class="rounded-lg border border-border bg-surface-2 p-4 col-span-2 sm:col-span-1">
                    <div class="text-content-muted text-xs font-semibold uppercase mb-1">Piyasa fiyatı</div>
                    <div class="text-base font-bold text-content"><i class="fa-solid fa-tag text-content-muted mr-1.5"></i>@Model.MinPrice.ToString("N0") – @Model.MaxPrice.ToString("N0") ₺</div>
                </div>
            </div>

            @{
                var _priceHistory = ViewBag.PriceHistory as System.Collections.IList;
            }
            @if (_priceHistory != null && _priceHistory.Count >= 2)
            {
                <div class="mt-6 rounded-lg bg-surface-2 p-4 border border-border">
                    <div class="text-xs text-content-muted font-semibold uppercase mb-3"><i class="fa-solid fa-chart-line mr-1"></i> Fiyat geçmişi</div>
                    <div class="h-56"><canvas id="priceHistoryChart"></canvas></div>
                </div>
            }
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-8">
        <div class="card card-pad" data-aos="fade-up" data-aos-delay="100">
            <h2 class="section-title mb-4 border-b border-border pb-2"><i class="fa-solid fa-quote-left text-content-muted mr-2"></i>Uzman özeti</h2>
            <p class="text-content-muted leading-relaxed">@Model.ExpertSummary</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.UserFeedbackSummary))
        {
            <div class="card card-pad" data-aos="fade-up" data-aos-delay="200">
                <h2 class="section-title mb-4 border-b border-border pb-2"><i class="fa-solid fa-users text-content-muted mr-2"></i>Kullanıcı yorumları &amp; forum özeti</h2>
                <p class="text-content-muted leading-relaxed italic">"@Model.UserFeedbackSummary"</p>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="card card-pad" data-aos="fade-up" data-aos-delay="300">
                <h3 class="text-base font-semibold text-emerald-600 dark:text-emerald-400 mb-4 flex items-center"><i class="fa-solid fa-circle-check mr-2"></i>Artılar</h3>
                <ul class="space-y-3">
                    @if (Model.ProsConsList != null && Model.ProsConsList.Any(p => p.Type == "Pro"))
                    {
                        foreach (var pro in Model.ProsConsList.Where(p => p.Type == "Pro"))
                        {
                            <li class="flex items-start gap-3">
                                <i class="fa-solid fa-check text-emerald-500 mt-1"></i>
                                <span class="text-content-muted text-sm">@pro.Description</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="text-content-muted italic text-sm">Veri bulunamadı.</li>
                    }
                </ul>
            </div>

            <div class="card card-pad" data-aos="fade-up" data-aos-delay="300">
                <h3 class="text-base font-semibold text-red-600 dark:text-red-400 mb-4 flex items-center"><i class="fa-solid fa-circle-xmark mr-2"></i>Eksiler</h3>
                <ul class="space-y-3">
                    @if (Model.ProsConsList != null && Model.ProsConsList.Any(p => p.Type == "Con"))
                    {
                        foreach (var con in Model.ProsConsList.Where(p => p.Type == "Con"))
                        {
                            <li class="flex items-start gap-3">
                                <i class="fa-solid fa-xmark text-red-500 mt-1"></i>
                                <span class="text-content-muted text-sm">@con.Description</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="text-content-muted italic text-sm">Veri bulunamadı.</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="space-y-6">
        <div class="card overflow-hidden" data-aos="fade-up" data-aos-delay="200">
            <div class="bg-surface-2 border-b border-border p-5">
                <h2 class="section-title flex items-center"><i class="fa-solid fa-triangle-exclamation text-amber-500 mr-2"></i>Bilinen kronik sorunlar</h2>
                <p class="text-sm text-content-muted mt-1">Tahmini tamir maliyeti: <span class="font-semibold text-content">~@Model.EstimatedMaintenanceCostEUR € / yıl</span></p>
            </div>
            <div class="divide-y divide-border p-2">
                @if (Model.ChronicIssues != null && Model.ChronicIssues.Any())
                {
                    foreach (var issue in Model.ChronicIssues)
                    {
                        var sev = issue.Severity.ToLowerInvariant();
                        var severityCls = sev == "kritik" ? "badge bg-red-50 text-red-700 dark:bg-red-500/15 dark:text-red-300"
                            : sev == "orta" ? "badge bg-amber-50 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300"
                            : "badge bg-surface-3 text-content-muted";
                        <div class="p-4 rounded-lg m-1">
                            <div class="flex justify-between items-start gap-2 mb-2">
                                <h4 class="font-semibold text-content text-sm">@issue.IssueTitle</h4>
                                <span class="@severityCls shrink-0">@issue.Severity</span>
                            </div>
                            <p class="text-sm text-content-muted mb-3">@issue.Description</p>
                            <div class="flex items-center justify-between text-xs font-medium bg-surface-2 p-2 rounded border border-border">
                                <span class="text-content-muted"><i class="fa-regular fa-calendar mr-1"></i>Riskli yıllar: <span class="text-content">@issue.AffectedYears</span></span>
                                <span class="text-red-500"><i class="fa-solid fa-screwdriver-wrench mr-1"></i>~@issue.EstimatedCostEUR €</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-8 text-center text-content-muted">
                        <i class="fa-solid fa-clipboard-check text-3xl mb-2 text-emerald-500"></i>
                        <p>Bilinen kritik bir sorun raporlanmamış.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.MileageMilestones != null && Model.MileageMilestones.Any())
{
    <div class="card overflow-hidden mt-8" data-aos="fade-up">
        <div class="bg-surface-2 border-b border-border p-5">
            <h2 class="section-title flex items-center"><i class="fa-solid fa-route text-content-muted mr-2"></i>Kritik kilometre bakım barajları</h2>
        </div>
        <div class="p-6">
            <div class="relative border-l-2 border-brand-500 ml-3 space-y-8">
                @foreach (var ms in Model.MileageMilestones)
                {
                    <div class="relative pl-6">
                        <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-brand-500 ring-4 ring-surface"></div>
                        <div class="rounded-lg bg-surface-2 border border-border p-4">
                            <div class="flex justify-between items-start gap-2 mb-2">
                                <h3 class="text-base font-semibold text-content">@ms.Mileage</h3>
                                <span class="badge bg-red-50 text-red-700 dark:bg-red-500/15 dark:text-red-300 shrink-0">~@ms.EstimatedCostEUR €</span>
                            </div>
                            <p class="text-content-muted text-sm">@ms.ExpectedIssues</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Kullanıcı yorumları -->
<div class="card overflow-hidden mt-8" data-aos="fade-up">
    <div class="bg-surface-2 border-b border-border p-5">
        <h2 class="section-title flex items-center"><i class="fa-solid fa-star text-amber-500 mr-2"></i>Senin puanın ne?</h2>
    </div>

    <div class="p-6">
        @{
            var _currentUserId = ViewBag.CurrentUserId as string;
            var _myReview = _currentUserId != null
                ? (Model.Reviews ?? new List<OtoRehber.Domain.Entities.CarReview>()).FirstOrDefault(r => r.UserId == _currentUserId)
                : null;
        }

        @if (User.Identity?.IsAuthenticated == true && _myReview == null)
        {
            <form asp-controller="Car" asp-action="AddReview" method="post" class="space-y-4 mb-8">
                <input type="hidden" name="carId" value="@Model.Id" />
                <div>
                    <label class="label">Araca puanınız (1-10)</label>
                    <select name="rating" required class="select">
                        <option value="">Puan seçin</option>
                        @for (int i = 10; i >= 1; i--)
                        {
                            <option value="@i">@i / 10</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="label">Yorumunuz (kronik sorun tecrübeleriniz, artı/eksileriniz)</label>
                    <textarea name="comment" required minlength="10" rows="3" class="textarea" placeholder="Bu aracı X yıldır kullanıyorum, şanzımanı ile ilgili..."></textarea>
                </div>
                <button type="submit" class="btn-primary"><i class="fa-solid fa-paper-plane"></i> Yorumu gönder</button>
            </form>
        }
        else if (_myReview != null)
        {
            <div id="my-review" class="mb-8 rounded-lg border border-border bg-surface-2 p-4">
                <div class="flex items-center justify-between mb-2">
                    <p class="font-semibold text-content text-sm"><i class="fa-solid fa-user-pen text-content-muted mr-1"></i> Senin yorumun</p>
                    <div class="flex gap-3">
                        <button type="button" onclick="document.getElementById('my-review-display').classList.toggle('hidden');document.getElementById('my-review-edit').classList.toggle('hidden');"
                                class="text-sm text-brand-600 hover:underline"><i class="fa-solid fa-pen"></i> Düzenle</button>
                        <form asp-controller="Car" asp-action="DeleteReview" method="post" onsubmit="return confirm('Yorumunuz silinsin mi?');" class="inline">
                            <input type="hidden" name="reviewId" value="@_myReview.Id" />
                            <button type="submit" class="text-sm text-red-600 hover:underline"><i class="fa-solid fa-trash-can"></i> Sil</button>
                        </form>
                    </div>
                </div>
                <div id="my-review-display">
                    <p class="text-sm text-content-muted mb-1">Puan: <strong class="text-content">@_myReview.Rating/10</strong></p>
                    <p class="text-content text-sm">@_myReview.Comment</p>
                </div>
                <form id="my-review-edit" asp-controller="Car" asp-action="EditReview" method="post" class="hidden space-y-3 mt-2">
                    <input type="hidden" name="reviewId" value="@_myReview.Id" />
                    <select name="rating" required class="select">
                        @for (int i = 10; i >= 1; i--)
                        {
                            <option value="@i" selected="@(i == _myReview.Rating)">@i / 10</option>
                        }
                    </select>
                    <textarea name="comment" required minlength="10" rows="3" class="textarea">@_myReview.Comment</textarea>
                    <button type="submit" class="btn-primary btn-sm">Kaydet</button>
                </form>
            </div>
        }
        else
        {
            <div class="mb-8 text-center py-6 rounded-lg border border-dashed border-border bg-surface-2">
                <p class="text-content-muted mb-3">Yorum yapabilmek için giriş yapmalısınız.</p>
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Car", new { id = Model.Id })" class="btn-primary btn-sm">
                    <i class="fa-solid fa-lock"></i> Giriş yap
                </a>
            </div>
        }

        <div class="border-t border-border pt-6 mt-6">
            @{
                var _rsort = (Context.Request.Query["rsort"].ToString() ?? "new").ToLowerInvariant();
                var _allOther = (Model.Reviews ?? new List<OtoRehber.Domain.Entities.CarReview>())
                    .Where(r => _myReview == null || r.Id != _myReview.Id);
                var _otherReviews = (_rsort switch
                {
                    "rating_desc" => _allOther.OrderByDescending(r => r.Rating).ThenByDescending(r => r.CreatedAt),
                    "rating_asc" => _allOther.OrderBy(r => r.Rating).ThenByDescending(r => r.CreatedAt),
                    _ => _allOther.OrderByDescending(r => r.CreatedAt).ThenBy(r => r.Id),
                }).ToList();
                const int _revPageSize = 5;
            }

            <div class="flex items-center justify-between flex-wrap gap-2 mb-4">
                <h3 class="section-title">Topluluk yorumları (@Model.Reviews?.Count)</h3>
                @if (_otherReviews.Count > 1)
                {
                    <select onchange="location.href='?rsort=' + this.value" class="select w-auto text-sm py-1.5">
                        <option value="new" selected="@(_rsort == "new")">En yeni</option>
                        <option value="rating_desc" selected="@(_rsort == "rating_desc")">En yüksek puan</option>
                        <option value="rating_asc" selected="@(_rsort == "rating_asc")">En düşük puan</option>
                    </select>
                }
            </div>

            @if (_otherReviews.Any())
            {
                var _revI = 0;
                <div class="space-y-4" id="review-list">
                    @foreach (var review in _otherReviews)
                    {
                        <div class="review-item rounded-lg bg-surface-2 p-4 border border-border flex gap-4 @(_revI++ >= _revPageSize ? "hidden" : "")">
                            <div class="flex-shrink-0">
                                <div class="w-10 h-10 rounded-full bg-brand-50 dark:bg-brand-500/15 flex items-center justify-center text-brand-700 dark:text-brand-300 font-semibold">
                                    @review.UserName.Substring(0, 1).ToUpper()
                                </div>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center justify-between mb-1">
                                    <h4 class="font-semibold text-content text-sm">@review.UserName</h4>
                                    <span class="text-xs text-content-muted">@review.CreatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="flex items-center mb-2">
                                    <div class="flex text-amber-500 text-sm">
                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                            <i class="fa-solid fa-star"></i>
                                        }
                                        @for (int i = review.Rating; i < 10; i++)
                                        {
                                            <i class="fa-regular fa-star text-content-muted/40"></i>
                                        }
                                    </div>
                                    <span class="ml-2 text-sm font-medium text-content-muted">@review.Rating/10</span>
                                </div>
                                <p class="text-content text-sm">@review.Comment</p>
                                @{
                                    var _rl = ViewBag.ReviewLikes as IDictionary<int, (int Count, bool Voted)>;
                                    (int Count, bool Voted) _rlv = _rl != null && _rl.TryGetValue(review.Id, out var _v) ? _v : (0, false);
                                    var _ownReview = _currentUserId != null && review.UserId == _currentUserId;
                                }
                                @if (!_ownReview)
                                {
                                    <button type="button" onclick="toggleReviewLike(this, @review.Id)"
                                            class="review-like-btn mt-2 inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full border transition-colors @(_rlv.Voted ? "bg-brand-50 border-brand-500 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300" : "border-border text-content-muted hover:border-brand-400 hover:text-brand-600")"
                                            aria-pressed="@(_rlv.Voted ? "true" : "false")">
                                        <i class="fa-regular fa-thumbs-up"></i>
                                        <span>Faydalı</span>
                                        <span class="review-like-count">@(_rlv.Count > 0 ? $"({_rlv.Count})" : "")</span>
                                    </button>
                                }
                                else if (_rlv.Count > 0)
                                {
                                    <p class="mt-2 text-xs text-content-muted"><i class="fa-regular fa-thumbs-up mr-1"></i>@_rlv.Count kişi faydalı buldu</p>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (_otherReviews.Count > _revPageSize)
                {
                    <button type="button" id="show-more-reviews" onclick="document.querySelectorAll('#review-list .review-item.hidden').forEach(e=>e.classList.remove('hidden')); this.remove();"
                            class="btn-secondary w-full mt-4">
                        @(_otherReviews.Count - _revPageSize) yorum daha göster
                    </button>
                }
            }
            else
            {
                <div class="text-center py-6 text-content-muted rounded-lg bg-surface-2 border border-dashed border-border">
                    <i class="fa-regular fa-comments text-3xl mb-2"></i>
                    <p>@(_myReview != null ? "Bu araca başka yorum yapılmamış." : "Henüz yorum yapılmamış. İlk yorumu siz yapın!")</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-8 text-center">
    <a asp-controller="Home" asp-action="Index" class="inline-flex items-center text-content-muted hover:text-content font-medium transition-colors">
        <i class="fa-solid fa-arrow-left mr-2"></i> Vitrine dön
    </a>
</div>

@{
    var _phJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.PriceHistory ?? new List<object>());
}
@if (ViewBag.PriceHistory != null && ((System.Collections.IList)ViewBag.PriceHistory).Count >= 2)
{
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script>
        (function () {
            var data = @Html.Raw(_phJson);
            var ctx = document.getElementById('priceHistoryChart');
            if (!ctx || !window.Chart) return;
            var dark = document.documentElement.classList.contains('dark');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.map(function (x) { return x.d; }),
                    datasets: [{
                        label: 'Fiyat (TL)',
                        data: data.map(function (x) { return x.p; }),
                        borderColor: '#2563eb',
                        backgroundColor: 'rgba(37,99,235,0.1)',
                        fill: true, tension: 0.3, pointRadius: 4
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { ticks: { color: dark ? '#94a3b8' : '#64748b', callback: function (v) { return (v / 1000) + 'K'; } }, grid: { color: dark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)' } },
                        x: { ticks: { color: dark ? '#94a3b8' : '#64748b' }, grid: { display: false } }
                    }
                }
            });
        })();
    </script>
}

<script>
    async function toggleReviewLike(btn, reviewId) {
        btn.disabled = true;
        try {
            const res = await postJson('/Car/ToggleReviewLike', { reviewId: reviewId });
            if (res.status === 401) { window.location.href = '/Account/Login'; return; }
            if (!res.ok) return;
            const data = await res.json();
            const countEl = btn.querySelector('.review-like-count');
            countEl.textContent = data.count > 0 ? `(${data.count})` : '';
            btn.setAttribute('aria-pressed', data.voted ? 'true' : 'false');
            btn.classList.toggle('bg-brand-50', data.voted);
            btn.classList.toggle('border-brand-500', data.voted);
            btn.classList.toggle('text-brand-600', data.voted);
            btn.classList.toggle('border-border', !data.voted);
            btn.classList.toggle('text-content-muted', !data.voted);
        } catch (e) { /* yoksay */ }
        finally { btn.disabled = false; }
    }
</script>
