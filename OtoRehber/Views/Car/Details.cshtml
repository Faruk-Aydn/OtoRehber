@model OtoRehber.Domain.DTOs.CarDetailDto
@{
    ViewData["Title"] = $"{Model.Brand} {Model.ModelName} İncelemesi";

    var _plainSummary = System.Text.RegularExpressions.Regex.Replace(Model.ExpertSummary ?? "", "<.*?>|[#*_`>]", " ").Trim();
    if (_plainSummary.Length > 300) _plainSummary = _plainSummary.Substring(0, 297).TrimEnd() + "…";
    ViewData["Description"] = string.IsNullOrWhiteSpace(_plainSummary)
        ? $"{Model.Brand} {Model.ModelName}: güvenilirlik puanı {Model.ReliabilityScore:0.#}/10, kronik sorunlar, bakım maliyetleri ve kullanıcı yorumları."
        : _plainSummary;
    ViewData["OgType"] = "article";
    if (!string.IsNullOrEmpty(Model.ImageUrl)) ViewData["OgImage"] = Model.ImageUrl;

    var _reviews = Model.Reviews ?? new List<OtoRehber.Domain.Entities.CarReview>();
    var _ratedCount = _reviews.Count;
    var _avgRating = _ratedCount > 0 ? System.Math.Round(_reviews.Average(r => r.Rating), 1) : 0d;

    var _req = Context.Request;
    var _pageUrl = $"{_req.Scheme}://{_req.Host}{_req.Path}";
    var _imgAbs = string.IsNullOrEmpty(Model.ImageUrl) ? null
        : (Model.ImageUrl.StartsWith("http") ? Model.ImageUrl : $"{_req.Scheme}://{_req.Host}{Model.ImageUrl}");

    var _jsonLd = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Car",
        ["name"] = $"{Model.Brand} {Model.ModelName}",
        ["brand"] = new Dictionary<string, object> { ["@type"] = "Brand", ["name"] = Model.Brand },
        ["model"] = Model.ModelName,
        ["vehicleConfiguration"] = Model.Segment,
        ["description"] = ViewData["Description"] as string ?? "",
        ["url"] = _pageUrl,
        ["offers"] = new Dictionary<string, object>
        {
            ["@type"] = "AggregateOffer",
            ["priceCurrency"] = "TRY",
            ["lowPrice"] = Model.MinPrice,
            ["highPrice"] = Model.MaxPrice
        }
    };
    if (_imgAbs != null) _jsonLd["image"] = _imgAbs;
    if (_ratedCount > 0)
    {
        _jsonLd["aggregateRating"] = new Dictionary<string, object>
        {
            ["@type"] = "AggregateRating",
            ["ratingValue"] = _avgRating,
            ["bestRating"] = 10,
            ["worstRating"] = 1,
            ["ratingCount"] = _ratedCount
        };
    }
    var _jsonLdString = System.Text.Json.JsonSerializer.Serialize(_jsonLd);
}

<script type="application/ld+json">@Html.Raw(_jsonLdString)</script>


<!-- Hero Section -->
<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md overflow-hidden mb-8 border border-gray-200 dark:border-gray-700" data-aos="fade-down">
    <div class="md:flex">
        <div class="md:shrink-0 bg-gray-200 dark:bg-gray-700 md:w-1/3 flex items-center justify-center min-h-[250px] text-gray-400 dark:text-gray-500 relative overflow-hidden group">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Brand @Model.ModelName" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors"></div>
            }
            else
            {
                <i class="fa-solid fa-car-side text-8xl"></i>
            }
        </div>
        <div class="p-8 md:w-2/3 flex flex-col justify-center">
            <div class="flex justify-between items-start">
                <div>
                    <div class="flex items-center flex-wrap gap-2 mb-2">
                        <a href="/marka/@OtoRehber.Controllers.CatalogController.Slugify(Model.Brand)" class="uppercase tracking-wide text-xs px-2 py-1 rounded bg-gray-900 text-white font-bold hover:bg-primary transition">
                            @Model.Brand
                        </a>
                        <a href="/segment/@OtoRehber.Controllers.CatalogController.Slugify(Model.Segment)" class="uppercase tracking-wide text-xs px-2 py-1 rounded bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300 font-bold border border-blue-200 dark:border-blue-800 hover:bg-blue-200 transition">
                            @Model.Segment segmenti
                        </a>
                        <span class="uppercase tracking-wide text-xs px-2 py-1 rounded bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300 font-bold border border-gray-200 dark:border-gray-600 flex items-center">
                            <i class="fa-regular fa-calendar-days mr-1"></i> @Model.ProductionYears
                        </span>
                    </div>
                    <h1 class="mt-1 text-3xl font-extrabold text-gray-900 dark:text-white leading-tight">@Model.Brand @Model.ModelName</h1>
                </div>
                <button type="button" onclick="toggleGarageHome(@Model.Id, this)" class="bg-gray-100 p-3 w-12 h-12 rounded-full shadow-sm border border-gray-200 z-10 flex items-center justify-center text-gray-400 hover:text-red-500 hover:scale-110 transition-all focus:ring-2 focus:ring-primary outline-none" title="Garaja Ekle" aria-label="Bu aracı garajıma ekle/çıkar">
                    <i class="fa-solid fa-heart text-xl" aria-hidden="true"></i>
                </button>
            </div>
            
            <div class="mt-4 bg-gray-50 dark:bg-gray-900/50 rounded-xl p-4 border border-gray-100 dark:border-gray-700">
                <div class="flex items-start gap-3">
                    <div class="mt-1 bg-white dark:bg-gray-800 p-2 rounded-lg shadow-sm border border-gray-200 dark:border-gray-600 text-gray-500 dark:text-gray-400">
                        <i class="fa-solid fa-engine text-lg"></i>
                    </div>
                    <div>
                        <div class="text-xs text-gray-500 dark:text-gray-400 font-semibold uppercase mb-1">Motor & Şanzıman Kombinasyonu</div>
                        <p class="text-gray-800 dark:text-gray-200 font-medium text-sm leading-relaxed">@Model.Engine</p>
                    </div>
                </div>
            </div>
            
            <div class="mt-6 flex flex-wrap gap-4">
                <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800/50 rounded-lg p-4 flex-1 min-w-[150px]">
                    <div class="text-blue-500 dark:text-blue-400 text-sm font-semibold mb-1">Uzman Güvenilirlik Puanı</div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-white"><i class="fa-solid fa-star text-yellow-400 mr-2"></i>@Model.ReliabilityScore / 10</div>
                </div>
                @if (_ratedCount > 0)
                {
                    <div class="bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-100 dark:border-indigo-800/50 rounded-lg p-4 flex-1 min-w-[150px]">
                        <div class="text-indigo-500 dark:text-indigo-400 text-sm font-semibold mb-1">Kullanıcı Puanı (@_ratedCount)</div>
                        <div class="text-2xl font-bold text-gray-900 dark:text-white"><i class="fa-solid fa-users text-indigo-400 mr-2"></i>@_avgRating.ToString("0.#") / 10</div>
                    </div>
                }
                <div class="bg-green-50 dark:bg-green-900/20 border border-green-100 dark:border-green-800/50 rounded-lg p-4 flex-1 min-w-[150px]">
                    <div class="text-green-600 dark:text-green-400 text-sm font-semibold mb-1">Piyasa Fiyatı</div>
                    <div class="text-xl font-bold text-gray-900 dark:text-white"><i class="fa-solid fa-tag text-green-500 mr-2"></i>@Model.MinPrice.ToString("N0") - @Model.MaxPrice.ToString("N0") TL</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Sol Kolon: Uzman Özeti & Artılar/Eksiler -->
    <div class="lg:col-span-2 space-y-8">
        
        <!-- Uzman Özeti -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm p-6 border border-gray-100 dark:border-gray-700" data-aos="fade-up" data-aos-delay="100">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 border-b dark:border-gray-700 pb-2"><i class="fa-solid fa-quote-left text-primary mr-2"></i>Uzman Özeti</h2>
            <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                @Model.ExpertSummary
            </p>
        </div>

        <!-- Kullanıcı Geri Bildirimleri -->
        @if(!string.IsNullOrEmpty(Model.UserFeedbackSummary))
        {
            <div class="bg-indigo-50/50 rounded-2xl shadow-sm p-6 border border-indigo-100 mt-6" data-aos="fade-up" data-aos-delay="200">
                <h2 class="text-xl font-bold text-gray-900 mb-4 border-b border-indigo-100 pb-2 flex items-center">
                    <i class="fa-solid fa-users text-indigo-500 mr-2"></i>Kullanıcı Yorumları & Forum Özeti
                </h2>
                <p class="text-gray-700 leading-relaxed italic">
                    "@Model.UserFeedbackSummary"
                </p>
            </div>
        }

        <!-- Artılar ve Eksiler Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Artılar -->
            <div class="bg-green-50/50 rounded-2xl shadow-sm p-6 border border-green-100" data-aos="fade-up" data-aos-delay="300">
                <h3 class="text-lg font-bold text-success mb-4 flex items-center"><i class="fa-solid fa-circle-check mr-2"></i>Artılar</h3>
                <ul class="space-y-3">
                    @if(Model.ProsConsList != null && Model.ProsConsList.Any(p => p.Type == "Pro"))
                    {
                        foreach(var pro in Model.ProsConsList.Where(p => p.Type == "Pro"))
                        {
                            <li class="flex items-start">
                                <i class="fa-solid fa-check text-success mt-1 mr-3"></i>
                                <span class="text-gray-700">@pro.Description</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="text-gray-500 italic">Veri bulunamadı.</li>
                    }
                </ul>
            </div>
            
            <!-- Eksiler -->
            <div class="bg-red-50/50 rounded-2xl shadow-sm p-6 border border-red-100" data-aos="fade-up" data-aos-delay="300">
                <h3 class="text-lg font-bold text-danger mb-4 flex items-center"><i class="fa-solid fa-circle-xmark mr-2"></i>Eksiler</h3>
                <ul class="space-y-3">
                    @if(Model.ProsConsList != null && Model.ProsConsList.Any(p => p.Type == "Con"))
                    {
                        foreach(var con in Model.ProsConsList.Where(p => p.Type == "Con"))
                        {
                            <li class="flex items-start">
                                <i class="fa-solid fa-xmark text-danger mt-1 mr-3"></i>
                                <span class="text-gray-700">@con.Description</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="text-gray-500 italic">Veri bulunamadı.</li>
                    }
                </ul>
            </div>
        </div>

    </div>

    <!-- Sağ Kolon: Kronik Sorunlar -->
    <div class="space-y-6">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden" data-aos="fade-up" data-aos-delay="200">
            <div class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 p-5">
                <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center">
                    <i class="fa-solid fa-triangle-exclamation text-orange-500 mr-2"></i>Bilinen Kronik Sorunlar
                </h2>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Tahmini tamir maliyetleri: <span class="font-bold text-gray-700 dark:text-gray-300">~@Model.EstimatedMaintenanceCostEUR € / Yıl</span></p>
            </div>
            
            <div class="divide-y divide-gray-100 dark:divide-gray-700 p-2">
                @if (Model.ChronicIssues != null && Model.ChronicIssues.Any())
                {
                    foreach (var issue in Model.ChronicIssues)
                    {
                        var severityColor = issue.Severity.ToLower() == "kritik" ? "text-red-600 bg-red-100 border-red-200 dark:bg-red-900/30 dark:border-red-800" :
                                          issue.Severity.ToLower() == "orta" ? "text-orange-600 bg-orange-100 border-orange-200 dark:bg-orange-900/30 dark:border-orange-800" :
                                          "text-yellow-600 bg-yellow-100 border-yellow-200 dark:bg-yellow-900/30 dark:border-yellow-800";
                        
                        <div class="p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition rounded-lg m-1">
                            <div class="flex justify-between items-start mb-2">
                                <h4 class="font-semibold text-gray-900 dark:text-gray-100">@issue.IssueTitle</h4>
                                <span class="text-xs font-bold px-2 py-1 rounded border @severityColor">@issue.Severity</span>
                            </div>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">@issue.Description</p>
                            
                            <div class="flex items-center justify-between text-xs font-medium bg-gray-50 dark:bg-gray-900 p-2 rounded border border-gray-100 dark:border-gray-700">
                                <span class="text-gray-500 dark:text-gray-400"><i class="fa-regular fa-calendar mr-1"></i>Riskli Yıllar: <span class="text-gray-700 dark:text-gray-300">@issue.AffectedYears</span></span>
                                <span class="text-red-500"><i class="fa-solid fa-screwdriver-wrench mr-1"></i>~@issue.EstimatedCostEUR €</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-8 text-center text-gray-500 dark:text-gray-400">
                        <i class="fa-solid fa-clipboard-check text-3xl mb-2 text-green-400"></i>
                        <p>Bilinen kritik bir sorun raporlanmamış.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Kilometre Bakım Çizelgesi (Mileage Milestones) -->
@if(Model.MileageMilestones != null && Model.MileageMilestones.Any())
{
<div class="mt-8 bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden" data-aos="fade-up">
    <div class="bg-gray-50 border-b border-gray-200 p-5">
        <h2 class="text-xl font-bold text-gray-900 flex items-center">
            <i class="fa-solid fa-route text-primary mr-2"></i>Kritik Kilometre Bakım Barajları
        </h2>
    </div>
    <div class="p-6">
        <div class="relative border-l-2 border-primary ml-3 space-y-8">
            @foreach(var ms in Model.MileageMilestones)
            {
                <div class="relative pl-6">
                    <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-primary ring-4 ring-white"></div>
                    <div class="bg-gray-50 border border-gray-100 rounded-lg p-4 shadow-sm hover:shadow-md transition">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="text-lg font-bold text-gray-900">@ms.Mileage</h3>
                            <span class="text-sm font-bold text-red-500 bg-red-50 px-2 py-1 rounded border border-red-100">
                                ~@ms.EstimatedCostEUR €
                            </span>
                        </div>
                        <p class="text-gray-700">@ms.ExpectedIssues</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
}

<!-- Kullanıcı Yorumları ve Puanlama Alanı -->
<div class="mt-8 bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden" data-aos="fade-up">
    <div class="bg-indigo-50 border-b border-indigo-100 p-5">
        <h2 class="text-xl font-bold text-gray-900 flex items-center">
            <i class="fa-solid fa-star text-yellow-400 mr-2"></i>Senin Puanın Ne?
        </h2>
    </div>
    
    <div class="p-6">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4" role="alert">
                <span class="block sm:inline">@TempData["SuccessMessage"]</span>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
                <span class="block sm:inline">@TempData["ErrorMessage"]</span>
            </div>
        }

        @{
            var _currentUserId = ViewBag.CurrentUserId as string;
            var _myReview = _currentUserId != null
                ? (Model.Reviews ?? new List<OtoRehber.Domain.Entities.CarReview>()).FirstOrDefault(r => r.UserId == _currentUserId)
                : null;
        }

        @if (User.Identity?.IsAuthenticated == true && _myReview == null)
        {
            <form asp-controller="Car" asp-action="AddReview" method="post" class="space-y-4 mb-8">
                <input type="hidden" name="carId" value="@Model.Id" />

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Araca Puanınız (1-10)</label>
                    <select name="rating" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none transition bg-white">
                        <option value="">Puan Seçin</option>
                        @for (int i = 10; i >= 1; i--)
                        {
                            <option value="@i">@i Yıldız</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Yorumunuz (Kronik sorun tecrübeleriniz, artı/eksileriniz)</label>
                    <textarea name="comment" required minlength="10" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none transition" placeholder="Bu aracı X yıldır kullanıyorum, şanzımanı ile ilgili..."></textarea>
                </div>

                <button type="submit" class="bg-primary hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg transition duration-200 shadow-md">
                    <i class="fa-solid fa-paper-plane mr-2"></i> Yorumu Gönder
                </button>
            </form>
        }
        else if (_myReview != null)
        {
            <div id="my-review" class="mb-8 bg-indigo-50/60 border border-indigo-100 rounded-xl p-4">
                <div class="flex items-center justify-between mb-2">
                    <p class="font-semibold text-gray-800"><i class="fa-solid fa-user-pen text-indigo-500 mr-1"></i> Senin yorumun</p>
                    <div class="flex gap-2">
                        <button type="button" onclick="document.getElementById('my-review-display').classList.toggle('hidden');document.getElementById('my-review-edit').classList.toggle('hidden');"
                                class="text-sm text-indigo-600 hover:underline"><i class="fa-solid fa-pen"></i> Düzenle</button>
                        <form asp-controller="Car" asp-action="DeleteReview" method="post" onsubmit="return confirm('Yorumunuz silinsin mi?');" class="inline">
                            <input type="hidden" name="reviewId" value="@_myReview.Id" />
                            <button type="submit" class="text-sm text-red-600 hover:underline"><i class="fa-solid fa-trash-can"></i> Sil</button>
                        </form>
                    </div>
                </div>
                <div id="my-review-display">
                    <p class="text-sm text-gray-600 mb-1">Puan: <strong>@_myReview.Rating/10</strong></p>
                    <p class="text-gray-700 text-sm">@_myReview.Comment</p>
                </div>
                <form id="my-review-edit" asp-controller="Car" asp-action="EditReview" method="post" class="hidden space-y-3 mt-2">
                    <input type="hidden" name="reviewId" value="@_myReview.Id" />
                    <select name="rating" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
                        @for (int i = 10; i >= 1; i--)
                        {
                            <option value="@i" selected="@(i == _myReview.Rating)">@i Yıldız</option>
                        }
                    </select>
                    <textarea name="comment" required minlength="10" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">@_myReview.Comment</textarea>
                    <button type="submit" class="bg-primary hover:bg-blue-700 text-white font-semibold py-1.5 px-4 rounded-lg text-sm">Kaydet</button>
                </form>
            </div>
        }
        else
        {
            <div class="mb-8 text-center py-6 bg-gray-50 rounded-xl border border-dashed border-gray-300">
                <p class="text-gray-600 mb-3">Yorum yapabilmek için giriş yapmalısınız.</p>
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Car", new { id = Model.Id })"
                   class="inline-flex items-center bg-primary hover:bg-blue-700 text-white font-semibold py-2 px-5 rounded-lg transition">
                    <i class="fa-solid fa-lock mr-2"></i> Giriş Yap
                </a>
            </div>
        }

        <div class="border-t border-gray-200 pt-6 mt-6">
            @{
                var _rsort = (Context.Request.Query["rsort"].ToString() ?? "new").ToLowerInvariant();
                var _allOther = (Model.Reviews ?? new List<OtoRehber.Domain.Entities.CarReview>())
                    .Where(r => _myReview == null || r.Id != _myReview.Id);
                var _otherReviews = (_rsort switch
                {
                    "rating_desc" => _allOther.OrderByDescending(r => r.Rating).ThenByDescending(r => r.CreatedAt),
                    "rating_asc" => _allOther.OrderBy(r => r.Rating).ThenByDescending(r => r.CreatedAt),
                    _ => _allOther.OrderByDescending(r => r.CreatedAt).ThenBy(r => r.Id),
                }).ToList();
                const int _revPageSize = 5;
            }

            <div class="flex items-center justify-between flex-wrap gap-2 mb-4">
                <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100">Topluluk Yorumları (@Model.Reviews?.Count)</h3>
                @if (_otherReviews.Count > 1)
                {
                    <select onchange="location.href='?rsort=' + this.value" class="text-sm border border-gray-300 dark:border-gray-600 dark:bg-gray-900 rounded-lg px-2 py-1.5">
                        <option value="new" selected="@(_rsort == "new")">En yeni</option>
                        <option value="rating_desc" selected="@(_rsort == "rating_desc")">En yüksek puan</option>
                        <option value="rating_asc" selected="@(_rsort == "rating_asc")">En düşük puan</option>
                    </select>
                }
            </div>

            @if (_otherReviews.Any())
            {
                var _revI = 0;
                <div class="space-y-4" id="review-list">
                    @foreach (var review in _otherReviews)
                    {
                        <div class="review-item bg-gray-50 dark:bg-gray-900/40 rounded-xl p-4 border border-gray-100 dark:border-gray-700 flex gap-4 @(_revI++ >= _revPageSize ? "hidden" : "")">
                            <div class="flex-shrink-0">
                                <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold text-lg">
                                    @review.UserName.Substring(0, 1).ToUpper()
                                </div>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center justify-between mb-1">
                                    <h4 class="font-bold text-gray-900 dark:text-gray-100">@review.UserName</h4>
                                    <span class="text-xs text-gray-500">@review.CreatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="flex items-center mb-2">
                                    <div class="flex text-yellow-400 text-sm">
                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                            <i class="fa-solid fa-star"></i>
                                        }
                                        @for (int i = review.Rating; i < 10; i++)
                                        {
                                            <i class="fa-regular fa-star text-gray-300"></i>
                                        }
                                    </div>
                                    <span class="ml-2 text-sm font-medium text-gray-600 dark:text-gray-400">@review.Rating/10</span>
                                </div>
                                <p class="text-gray-700 dark:text-gray-300 text-sm">@review.Comment</p>
                                @{
                                    var _rl = ViewBag.ReviewLikes as IDictionary<int, (int Count, bool Voted)>;
                                    (int Count, bool Voted) _rlv = _rl != null && _rl.TryGetValue(review.Id, out var _v) ? _v : (0, false);
                                    var _ownReview = _currentUserId != null && review.UserId == _currentUserId;
                                }
                                @if (!_ownReview)
                                {
                                    <button type="button" onclick="toggleReviewLike(this, @review.Id)"
                                            class="review-like-btn mt-2 inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full border transition @(_rlv.Voted ? "bg-primary/10 border-primary text-primary" : "border-gray-300 dark:border-gray-600 text-gray-500 hover:border-primary hover:text-primary")"
                                            aria-pressed="@(_rlv.Voted ? "true" : "false")">
                                        <i class="fa-regular fa-thumbs-up"></i>
                                        <span>Faydalı</span>
                                        <span class="review-like-count">@(_rlv.Count > 0 ? $"({_rlv.Count})" : "")</span>
                                    </button>
                                }
                                else if (_rlv.Count > 0)
                                {
                                    <p class="mt-2 text-xs text-gray-400"><i class="fa-regular fa-thumbs-up mr-1"></i>@_rlv.Count kişi faydalı buldu</p>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (_otherReviews.Count > _revPageSize)
                {
                    <button type="button" id="show-more-reviews" onclick="document.querySelectorAll('#review-list .review-item.hidden').forEach(e=>e.classList.remove('hidden')); this.remove();"
                            class="mt-4 w-full py-2.5 text-sm font-semibold text-primary bg-blue-50 dark:bg-blue-900/20 rounded-xl hover:bg-blue-100 dark:hover:bg-blue-900/40 transition">
                        @(_otherReviews.Count - _revPageSize) yorum daha göster
                    </button>
                }
            }
            else
            {
                <div class="text-center py-6 text-gray-500 bg-gray-50 rounded-xl border border-dashed border-gray-300">
                    <i class="fa-regular fa-comments text-3xl mb-2 text-gray-400"></i>
                    <p>@(_myReview != null ? "Bu araca başka yorum yapılmamış." : "Henüz yorum yapılmamış. İlk yorumu siz yapın!")</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-8 text-center">
    <a asp-controller="Home" asp-action="Index" class="inline-flex items-center text-gray-500 hover:text-primary font-medium transition">
        <i class="fa-solid fa-arrow-left mr-2"></i> Vitrine Dön
    </a>
</div>

<script>
    async function toggleReviewLike(btn, reviewId) {
        btn.disabled = true;
        try {
            const res = await postJson('/Car/ToggleReviewLike', { reviewId: reviewId });
            if (res.status === 401) { window.location.href = '/Account/Login'; return; }
            if (!res.ok) return;
            const data = await res.json();
            const countEl = btn.querySelector('.review-like-count');
            countEl.textContent = data.count > 0 ? `(${data.count})` : '';
            btn.setAttribute('aria-pressed', data.voted ? 'true' : 'false');
            btn.classList.toggle('bg-primary/10', data.voted);
            btn.classList.toggle('border-primary', data.voted);
            btn.classList.toggle('text-primary', data.voted);
            btn.classList.toggle('border-gray-300', !data.voted);
            btn.classList.toggle('text-gray-500', !data.voted);
        } catch (e) { /* yoksay */ }
        finally { btn.disabled = false; }
    }
</script>
