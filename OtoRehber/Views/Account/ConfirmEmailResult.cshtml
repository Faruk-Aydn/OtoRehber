@model bool
@{
    ViewData["Title"] = Model ? "E-posta doğrulandı" : "Doğrulama başarısız";
}
<div class="max-w-md mx-auto text-center py-16">
    @if (Model)
    {
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-50 dark:bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 mb-6">
            <i class="fa-solid fa-circle-check text-2xl"></i>
        </div>
        <h1 class="text-2xl font-bold text-content tracking-tight mb-3">E-posta adresin doğrulandı</h1>
        <p class="text-content-muted mb-8">Artık hesabına giriş yapabilirsin.</p>
        <a asp-controller="Account" asp-action="Login" class="btn-primary">Giriş yap</a>
    }
    else
    {
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-50 dark:bg-red-500/15 text-red-600 dark:text-red-400 mb-6">
            <i class="fa-solid fa-circle-xmark text-2xl"></i>
        </div>
        <h1 class="text-2xl font-bold text-content tracking-tight mb-3">Doğrulama bağlantısı geçersiz</h1>
        <p class="text-content-muted mb-8">
            Bağlantının süresi dolmuş veya hatalı olabilir. Lütfen tekrar kayıt olmayı ya da
            şifre sıfırlama akışını deneyin.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn-primary">Ana sayfa</a>
    }
</div>
