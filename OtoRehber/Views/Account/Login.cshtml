@model OtoRehber.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null; // Giriş sayfasında normal navbar istemiyoruz
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@ViewData["Title"] - OtoRehber</title>
    <link rel="preload" href="~/lib/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/lib/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.min.css" asp-append-version="true" />
    <script>if(localStorage.theme==='dark'||(!('theme' in localStorage)&&matchMedia('(prefers-color-scheme:dark)').matches))document.documentElement.classList.add('dark');</script>
</head>
<body class="bg-surface-2 text-content font-sans flex items-center justify-center min-h-screen p-4">
    <div class="card card-pad max-w-md w-full">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-content tracking-tight mb-1">
                <i class="fa-solid fa-car-side text-brand-600 mr-2"></i>OtoRehber
            </h1>
            <p class="text-content-muted text-sm">Hesabınıza giriş yapın</p>
        </div>

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>

            <div>
                <label asp-for="Email" class="label">E-posta adresi</label>
                <input asp-for="Email" class="input" placeholder="ornek@eposta.com" required>
                <span asp-validation-for="Email" class="form-error"></span>
            </div>

            <div>
                <label asp-for="Password" class="label">Şifre</label>
                <input asp-for="Password" type="password" class="input" placeholder="••••••••" required>
                <span asp-validation-for="Password" class="form-error"></span>
            </div>

            <div class="flex items-center justify-between">
                <label class="flex items-center gap-2 text-sm text-content-muted">
                    <input asp-for="RememberMe" class="w-4 h-4 accent-brand-600 rounded">
                    Beni hatırla
                </label>
                <a asp-controller="Account" asp-action="ForgotPassword" class="text-sm text-brand-600 hover:underline">Şifremi unuttum</a>
            </div>

            <button type="submit" class="btn-primary w-full">Giriş yap <i class="fa-solid fa-arrow-right-to-bracket"></i></button>
        </form>

        <div class="mt-6 text-center text-sm text-content-muted space-y-2">
            <p>Hesabın yok mu? <a asp-controller="Account" asp-action="Register" class="text-brand-600 font-medium hover:underline">Kayıt ol</a></p>
            <a asp-controller="Home" asp-action="Index" class="hover:text-content transition-colors flex items-center justify-center">
                <i class="fa-solid fa-arrow-left mr-2"></i> Siteye dön
            </a>
        </div>
    </div>
</body>
</html>
