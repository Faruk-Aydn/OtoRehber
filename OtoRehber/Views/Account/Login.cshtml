@model OtoRehber.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null; // Giriş sayfasında normal navbar istemiyoruz
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OtoRehber</title>
    <link rel="stylesheet" href="~/css/app.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg max-w-md w-full border border-gray-200">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-extrabold text-gray-900 mb-2">
                <i class="fa-solid fa-car-side text-primary mr-2"></i>OtoRehber
            </h1>
            <p class="text-gray-500">Hesabınıza giriş yapın</p>
        </div>

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-4"></div>
            
            <div class="mb-4">
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">E-posta Adresi</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-envelope text-gray-400"></i>
                    </div>
                    <input asp-for="Email" class="pl-10 w-full p-2.5 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" placeholder="admin@otorehber.com" required>
                </div>
                <span asp-validation-for="Email" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div class="mb-6">
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1">Şifre</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-lock text-gray-400"></i>
                    </div>
                    <input asp-for="Password" type="password" class="pl-10 w-full p-2.5 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary text-sm" placeholder="••••••••" required>
                </div>
                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div class="flex items-center justify-between mb-6">
                <div class="flex items-center">
                    <input asp-for="RememberMe" class="w-4 h-4 text-primary bg-gray-100 border-gray-300 rounded focus:ring-primary">
                    <label asp-for="RememberMe" class="ml-2 text-sm text-gray-600">Beni Hatırla</label>
                </div>
                <a asp-controller="Account" asp-action="ForgotPassword" class="text-sm text-primary hover:underline">Şifremi unuttum</a>
            </div>

            <button type="submit" class="w-full text-white bg-primary hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-bold rounded-lg text-sm px-5 py-3 text-center transition">
                Giriş Yap <i class="fa-solid fa-arrow-right-to-bracket ml-2"></i>
            </button>
        </form>
        
        <div class="mt-6 text-center text-sm text-gray-500 space-y-2">
            <p>Hesabın yok mu? <a asp-controller="Account" asp-action="Register" class="text-primary font-medium hover:underline">Kayıt ol</a></p>
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition flex items-center justify-center">
                <i class="fa-solid fa-arrow-left mr-2"></i> Siteye Dön
            </a>
        </div>
    </div>
</body>
</html>
