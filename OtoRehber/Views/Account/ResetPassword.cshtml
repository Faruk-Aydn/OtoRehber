@model OtoRehber.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni şifre belirle";
}
<div class="max-w-md mx-auto py-12">
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-8">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Yeni şifre belirle</h1>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
            <input asp-for="Code" type="hidden" />

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
                <input asp-for="Email" class="w-full p-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900 rounded-lg focus:ring-primary focus:border-primary text-sm" />
                <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
                <input asp-for="Password" class="w-full p-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900 rounded-lg focus:ring-primary focus:border-primary text-sm" />
                <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
                <input asp-for="ConfirmPassword" class="w-full p-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900 rounded-lg focus:ring-primary focus:border-primary text-sm" />
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>
            </div>
            <button type="submit" class="w-full text-white bg-primary hover:bg-blue-700 font-bold rounded-lg text-sm px-5 py-3 transition">
                Şifreyi güncelle
            </button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
