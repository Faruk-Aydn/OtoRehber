@model OtoRehber.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni şifre belirle";
}
<div class="max-w-md mx-auto py-12">
    <div class="card card-pad">
        <h1 class="text-2xl font-bold text-content tracking-tight mb-6">Yeni şifre belirle</h1>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>
            <input asp-for="Code" type="hidden" />
            <div>
                <label asp-for="Email" class="label"></label>
                <input asp-for="Email" class="input" />
                <span asp-validation-for="Email" class="form-error"></span>
            </div>
            <div>
                <label asp-for="Password" class="label"></label>
                <input asp-for="Password" class="input" />
                <span asp-validation-for="Password" class="form-error"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="label"></label>
                <input asp-for="ConfirmPassword" class="input" />
                <span asp-validation-for="ConfirmPassword" class="form-error"></span>
            </div>
            <button type="submit" class="btn-primary w-full">Şifreyi güncelle</button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
