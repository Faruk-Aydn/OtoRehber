@model OtoRehber.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi unuttum";
}
<div class="max-w-md mx-auto py-12">
    <div class="card card-pad">
        <h1 class="text-2xl font-bold text-content tracking-tight mb-2">Şifremi unuttum</h1>
        <p class="text-sm text-content-muted mb-6">E-posta adresini gir; hesabın varsa şifre sıfırlama bağlantısı göndereceğiz.</p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>
            <div>
                <label asp-for="Email" class="label"></label>
                <input asp-for="Email" class="input" placeholder="ornek@eposta.com" />
                <span asp-validation-for="Email" class="form-error"></span>
            </div>
            <button type="submit" class="btn-primary w-full">Sıfırlama bağlantısı gönder</button>
        </form>

        <div class="mt-6 text-center text-sm">
            <a asp-controller="Account" asp-action="Login" class="text-content-muted hover:text-content">Girişe dön</a>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
