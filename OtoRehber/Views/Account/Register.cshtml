@model OtoRehber.Models.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "_Layout";
}

<div class="min-h-[70vh] flex items-center justify-center py-12">
    <div class="max-w-md w-full card card-pad" data-aos="fade-up">
        <div class="text-center mb-6">
            <div class="mx-auto h-14 w-14 bg-brand-600 rounded-full flex items-center justify-center">
                <i class="fa-solid fa-user-plus text-xl text-white"></i>
            </div>
            <h1 class="mt-4 text-2xl font-bold text-content tracking-tight">OtoRehber'e katıl</h1>
            <p class="mt-1 text-sm text-content-muted">Favori araçlarını garajına ekle, AI asistanından faydalan.</p>
        </div>

        <form class="space-y-4" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="form-error text-center bg-red-50 dark:bg-red-500/10 rounded-lg p-3"></div>
            <div>
                <label asp-for="Email" class="label">E-posta adresi</label>
                <input asp-for="Email" type="email" autocomplete="email" required class="input" placeholder="ornek@eposta.com">
                <span asp-validation-for="Email" class="form-error"></span>
            </div>
            <div>
                <label asp-for="Password" class="label">Şifre</label>
                <input asp-for="Password" type="password" autocomplete="new-password" required class="input" placeholder="En az 8 karakter, büyük/küçük harf + rakam">
                <span asp-validation-for="Password" class="form-error"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="label">Şifre tekrar</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required class="input" placeholder="Şifrenizi tekrar girin">
                <span asp-validation-for="ConfirmPassword" class="form-error"></span>
            </div>
            <button type="submit" class="btn-primary w-full">Kayıt ol ve başla</button>
        </form>

        <p class="mt-6 text-center text-sm text-content-muted">
            Zaten üye misin? <a asp-action="Login" class="font-medium text-brand-600 hover:underline">Buradan giriş yap</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
