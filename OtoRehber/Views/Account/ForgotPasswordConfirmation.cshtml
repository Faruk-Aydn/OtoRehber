@{
    ViewData["Title"] = "Bağlantı gönderildi";
}
<div class="max-w-md mx-auto text-center py-16">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-50 dark:bg-brand-500/15 text-brand-600 dark:text-brand-400 mb-6">
        <i class="fa-solid fa-paper-plane text-2xl"></i>
    </div>
    <h1 class="text-2xl font-bold text-content tracking-tight mb-3">Kontrol et bakalım</h1>
    <p class="text-content-muted mb-8">
        Girdiğin adrese kayıtlı bir hesap varsa, şifre sıfırlama bağlantısını e-posta ile gönderdik.
    </p>
    <a asp-controller="Account" asp-action="Login" class="btn-primary">Girişe dön</a>
</div>
