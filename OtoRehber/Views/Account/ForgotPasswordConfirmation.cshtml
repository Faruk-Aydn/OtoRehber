@{
    ViewData["Title"] = "Bağlantı gönderildi";
}
<div class="max-w-md mx-auto text-center py-16">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-100 text-primary mb-6">
        <i class="fa-solid fa-paper-plane text-2xl"></i>
    </div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Kontrol et bakalım</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
        Girdiğin adrese kayıtlı bir hesap varsa, şifre sıfırlama bağlantısını e-posta ile gönderdik.
    </p>
    <a asp-controller="Account" asp-action="Login" class="inline-flex items-center bg-primary hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl transition">
        Girişe dön
    </a>
</div>
