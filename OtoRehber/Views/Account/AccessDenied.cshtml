@{
    ViewData["Title"] = "Erişim Reddedildi";
}

<div class="max-w-2xl mx-auto py-16 text-center" data-aos="fade-up">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-50 dark:bg-red-500/15 text-red-600 dark:text-red-400 mb-8">
        <i class="fa-solid fa-shield-halved text-4xl"></i>
    </div>

    <h1 class="text-2xl sm:text-3xl font-bold text-content tracking-tight mb-4">Yetkisiz erişim</h1>
    <p class="text-content-muted max-w-xl mx-auto mb-10">
        Bu sayfayı görüntülemek için gerekli yetkilere sahip değilsiniz. Sadece sistem yöneticileri bu alana girebilir.
    </p>

    <div class="flex flex-wrap justify-center gap-3">
        <a asp-controller="Home" asp-action="Index" class="btn-primary"><i class="fa-solid fa-house"></i> Ana sayfaya dön</a>
        <a asp-controller="Garage" asp-action="Index" class="btn-secondary"><i class="fa-solid fa-heart"></i> Garajım</a>
    </div>
</div>
