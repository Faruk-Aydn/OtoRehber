@using OtoRehber.Domain.Ai
@{
    ViewData["Title"] = "AI Önerileri";
    var candidates = (ViewBag.Candidates as IEnumerable<dynamic>)?.ToList() ?? new List<dynamic>();
    var nearMisses = (ViewBag.NearMisses as IEnumerable<dynamic>)?.ToList() ?? new List<dynamic>();
    var explanation = ViewBag.Explanation as AiExplanation;
    int totalPassed = ViewBag.TotalPassed ?? 0;
}

<div class="max-w-4xl mx-auto py-8">
    <div class="flex items-center justify-between gap-3 mb-6" data-aos="fade-down">
        <div class="flex items-center gap-3">
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-brand-600 text-white">
                <i class="fa-solid fa-robot text-lg"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-content tracking-tight">Sana uygun araçlar</h1>
                <p class="text-content-muted text-sm">Filtre + OtoRehber Skoru ile seçildi, AI yorumladı</p>
            </div>
        </div>
        <a asp-action="Index" class="btn-secondary btn-sm shrink-0"><i class="fa-solid fa-rotate-left"></i> <span class="hidden sm:inline">Kriterleri değiştir</span></a>
    </div>

    @if (candidates.Count == 0)
    {
        <div class="card card-pad text-center py-12" data-aos="fade-up">
            <i class="fa-solid fa-filter-circle-xmark text-3xl text-content-muted mb-3"></i>
            <h2 class="text-lg font-semibold text-content mb-2">Kriterlerine tam uyan araç bulunamadı</h2>
            <p class="text-content-muted text-sm mb-4">Bütçe, yakıt, vites veya kasa tipi filtrelerinden birini gevşetmeyi dene.</p>
            <a asp-action="Index" class="btn-primary btn-sm">Kriterleri düzenle</a>
        </div>
    }
    else
    {
        <div class="space-y-4 mb-8" data-aos="fade-up">
            @foreach (var c in candidates)
            {
                var dto = (OtoRehber.Domain.DTOs.CarListDto)c.Dto;
                <div class="card card-pad flex flex-col sm:flex-row sm:items-center gap-4">
                    <div class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-50 dark:bg-brand-500/15 text-brand-700 dark:text-brand-300 font-bold shrink-0">@c.Rank</div>
                    <div class="flex-1 min-w-0">
                        <a asp-controller="Car" asp-action="Details" asp-route-id="@dto.Id" class="font-semibold text-content hover:text-brand-600">@dto.Brand @dto.ModelName</a>
                        <p class="text-xs text-content-muted mt-0.5">@dto.Engine</p>
                        <p class="text-xs text-content-muted">@dto.MinPrice.ToString("N0") – @dto.MaxPrice.ToString("N0") ₺</p>
                    </div>
                    <div class="text-right shrink-0">
                        <div class="text-xs text-content-muted uppercase font-semibold">OtoRehber Skoru</div>
                        <div class="text-lg font-bold text-content">@(c.Score != null ? ((double)c.Score).ToString("0.#") : "—")<span class="text-xs text-content-muted">/10</span></div>
                    </div>
                    <a asp-controller="Car" asp-action="Details" asp-route-id="@dto.Id" class="btn-primary btn-sm shrink-0">İncele</a>
                </div>
            }
        </div>

        @if (totalPassed > candidates.Count)
        {
            <p class="text-xs text-content-muted mb-6 -mt-4">Kriterlerine uyan toplam @totalPassed araçtan en yüksek OtoRehber Skoru'na sahip @candidates.Count tanesi gösteriliyor.</p>
        }

        <div class="card card-pad mb-8" data-aos="fade-up">
            <h2 class="section-title mb-3"><i class="fa-solid fa-comment-dots text-content-muted mr-2"></i>AI yorumu</h2>
            @if (explanation is { Ok: true } && !string.IsNullOrWhiteSpace(explanation.Summary))
            {
                <div id="ai-content" class="hidden">@explanation.Summary</div>
                <div id="formatted-content" class="prose-oto"></div>
                @if (explanation.RejectedClaims > 0)
                {
                    <p class="mt-3 text-xs text-content-muted"><i class="fa-solid fa-shield-halved mr-1"></i>@explanation.RejectedClaims doğrulanamayan iddia yanıttan çıkarıldı.</p>
                }
            }
            else
            {
                <p class="text-sm text-content-muted">@(explanation?.ErrorMessage ?? "AI yorumu şu anda üretilemedi. Araçlar yukarıda OtoRehber Skoru sırasıyla listelendi.")</p>
            }
        </div>
    }

    @if (nearMisses.Count > 0)
    {
        <div class="card card-pad" data-aos="fade-up">
            <h2 class="section-title mb-3"><i class="fa-solid fa-circle-minus text-content-muted mr-2"></i>Kriterlerine çok yakın ama elenen araçlar</h2>
            <ul class="space-y-2.5">
                @foreach (var n in nearMisses)
                {
                    <li class="text-sm">
                        <a asp-controller="Car" asp-action="Details" asp-route-id="@n.Id" class="font-medium text-content hover:text-brand-600">@n.Label</a>
                        <span class="text-content-muted"> — @string.Join("; ", (List<string>)n.Reasons)</span>
                    </li>
                }
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const el = document.getElementById('ai-content');
            if (!el) return;
            const raw = el.innerText || el.textContent;
            document.getElementById('formatted-content').innerHTML = DOMPurify.sanitize(marked.parse(raw || ''));
        });
    </script>
}
