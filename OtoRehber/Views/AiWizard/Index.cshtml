@{
    ViewData["Title"] = "AI Araç Sihirbazı";
    ViewData["Description"] = "Bütçenizi ve ihtiyaçlarınızı söyleyin, yapay zeka size en uygun 3 aracı gerekçeleriyle önersin.";

    var bodyTypes = new[] { "Hatchback", "Sedan", "SUV", "Station Wagon", "Farketmez" };
    var transmissions = new[] { "Otomatik", "Manuel", "Farketmez" };
    var fuels = new[] { "Benzin", "Dizel", "Hibrit", "Elektrik", "Farketmez" };
    var families = new[] { "Bekar / Çift (1-2 kişi)", "Çekirdek aile (3-4 kişi)", "Geniş aile (5+ kişi)" };
    var usages = new[] { "Ağırlıklı şehir içi", "Ağırlıklı uzun yol", "Karma (şehir + uzun yol)", "Arazi / zorlu şartlar" };
    var priorityOpts = new[]
    {
        "Ekonomi & yakıt", "Sorunsuzluk / düşük arıza", "Performans", "Konfor & teknoloji",
        "Güvenlik", "Bagaj & iç hacim", "2. el değeri", "Prestij"
    };
}

<div class="max-w-3xl mx-auto py-8">
    <div class="text-center mb-8" data-aos="fade-down">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-brand-600 text-white mb-4">
            <i class="fa-solid fa-wand-magic-sparkles text-2xl"></i>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-content tracking-tight mb-2">Sana en uygun aracı bulalım</h1>
        <p class="text-content-muted max-w-xl mx-auto">
            Birkaç soruyu yanıtla; yapay zeka profiline göre 3 araç önersin. Sadece bütçe zorunlu, gerisi opsiyonel.
        </p>
    </div>

    <div class="card card-pad" data-aos="fade-up">
        <form id="wizardForm" asp-controller="AiWizard" asp-action="Analyze" method="post" class="space-y-8" onsubmit="showLoading()">
            @if (ViewBag.Error != null)
            {
                <div class="card border-l-4 border-l-red-500 p-4 flex items-center gap-3">
                    <i class="fa-solid fa-triangle-exclamation text-red-500"></i>
                    <p class="text-sm text-content">@ViewBag.Error</p>
                </div>
            }

            <fieldset class="space-y-3">
                <legend class="section-title">Bütçe <span class="text-red-500">*</span></legend>
                <div class="flex items-center gap-3">
                    <div class="flex-1">
                        <label class="label" for="budgetMin">En az (₺)</label>
                        <input id="budgetMin" type="number" name="budgetMin" min="0" step="50000" placeholder="500.000" class="input" />
                    </div>
                    <span class="text-content-muted pt-6">–</span>
                    <div class="flex-1">
                        <label class="label" for="budgetMax">En fazla (₺)</label>
                        <input id="budgetMax" type="number" name="budgetMax" min="0" step="50000" placeholder="1.500.000" class="input" />
                    </div>
                </div>
            </fieldset>

            @{
                void ChipRadio(string name, string[] opts)
                {
                    <div class="flex flex-wrap gap-2">
                        @foreach (var o in opts)
                        {
                            <label class="cursor-pointer">
                                <input type="radio" name="@name" value="@o" class="peer sr-only" @(o == "Farketmez" ? "checked" : "") />
                                <span class="chip peer-checked:bg-brand-600 peer-checked:text-white peer-checked:border-brand-600 transition-colors">@o</span>
                            </label>
                        }
                    </div>
                }
            }

            <fieldset class="space-y-3">
                <legend class="section-title">Kasa tipi</legend>
                @{ ChipRadio("bodyType", bodyTypes); }
            </fieldset>

            <fieldset class="space-y-3">
                <legend class="section-title">Vites</legend>
                @{ ChipRadio("transmission", transmissions); }
            </fieldset>

            <fieldset class="space-y-3">
                <legend class="section-title">Yakıt</legend>
                @{ ChipRadio("fuel", fuels); }
            </fieldset>

            <div>
                <label class="label" for="familySize">Aile durumu</label>
                <select id="familySize" name="familySize" class="select">
                    <option value="">Farketmez</option>
                    @foreach (var f in families)
                    {
                        <option value="@f">@f</option>
                    }
                </select>
            </div>

            <div>
                <label class="label" for="usageType">Kullanım</label>
                <select id="usageType" name="usageType" class="select">
                    <option value="">Farketmez</option>
                    @foreach (var u in usages)
                    {
                        <option value="@u">@u</option>
                    }
                </select>
            </div>

            <fieldset class="space-y-3">
                <legend class="section-title">Öncelikler <span class="text-content-muted font-normal text-sm">(birden fazla seçebilirsin)</span></legend>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    @foreach (var opt in priorityOpts)
                    {
                        <label class="flex items-center gap-2.5 rounded-lg border border-border bg-surface px-3 py-2.5 text-sm text-content cursor-pointer hover:border-brand-300 transition-colors">
                            <input type="checkbox" name="priorities" value="@opt" class="w-4 h-4 accent-brand-600 rounded" />
                            @opt
                        </label>
                    }
                </div>
            </fieldset>

            <div>
                <label class="label" for="notes">Eklemek istediğin başka bir şey?</label>
                <textarea id="notes" name="notes" rows="3" maxlength="400" class="textarea" placeholder="Örn: kışın kar lastiğiyle dağ yolu kullanıyorum, LPG'li de olabilir, çocuk koltuğu sığmalı…"></textarea>
            </div>

            <div class="pt-4 border-t border-border flex justify-end">
                <button type="submit" id="submitBtn" class="btn-primary btn-lg">
                    <i class="fa-solid fa-bolt"></i> Sihirbazı çalıştır
                </button>
            </div>
        </form>

        <div id="loadingState" class="hidden text-center py-16">
            <div class="inline-block relative w-16 h-16 mb-6">
                <div class="absolute inset-0 rounded-full border-4 border-border"></div>
                <div class="absolute inset-0 rounded-full border-4 border-brand-600 border-t-transparent animate-spin"></div>
            </div>
            <h3 class="text-lg font-semibold text-content mb-2">Yapay zeka analiz ediyor…</h3>
            <p class="text-content-muted">Profiline uygun araçlar değerlendiriliyor. Bu işlem 10-15 saniye sürebilir.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showLoading() {
            document.getElementById('wizardForm').classList.add('hidden');
            document.getElementById('loadingState').classList.remove('hidden');
            document.getElementById('loadingState').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    </script>
}
