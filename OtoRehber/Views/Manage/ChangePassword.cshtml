@model OtoRehber.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre değiştir";
}
<div class="max-w-md mx-auto py-12">
    <div class="card card-pad">
        <h1 class="text-2xl font-bold text-content tracking-tight mb-6">Şifre değiştir</h1>

        <form asp-action="ChangePassword" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>
            <div>
                <label asp-for="CurrentPassword" class="label"></label>
                <input asp-for="CurrentPassword" class="input" />
                <span asp-validation-for="CurrentPassword" class="form-error"></span>
            </div>
            <div>
                <label asp-for="NewPassword" class="label"></label>
                <input asp-for="NewPassword" class="input" />
                <span asp-validation-for="NewPassword" class="form-error"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="label"></label>
                <input asp-for="ConfirmPassword" class="input" />
                <span asp-validation-for="ConfirmPassword" class="form-error"></span>
            </div>
            <button type="submit" class="btn-primary w-full">Güncelle</button>
        </form>

        <div class="mt-6 text-center text-sm">
            <a asp-action="Index" class="text-content-muted hover:text-content">Hesabıma dön</a>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
