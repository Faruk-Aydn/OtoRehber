@model OtoRehber.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre değiştir";
}
<div class="max-w-md mx-auto py-12">
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-8">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Şifre değiştir</h1>

        <form asp-action="ChangePassword" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

            <div>
                <label asp-for="CurrentPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
                <input asp-for="CurrentPassword" class="w-full p-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900 rounded-lg focus:ring-primary focus:border-primary text-sm" />
                <span asp-validation-for="CurrentPassword" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label asp-for="NewPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
                <input asp-for="NewPassword" class="w-full p-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900 rounded-lg focus:ring-primary focus:border-primary text-sm" />
                <span asp-validation-for="NewPassword" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
                <input asp-for="ConfirmPassword" class="w-full p-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900 rounded-lg focus:ring-primary focus:border-primary text-sm" />
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>
            </div>

            <button type="submit" class="w-full text-white bg-primary hover:bg-blue-700 font-bold rounded-lg text-sm px-5 py-3 transition">Güncelle</button>
        </form>

        <div class="mt-6 text-center text-sm">
            <a asp-action="Index" class="text-gray-500 hover:text-primary">Hesabıma dön</a>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
