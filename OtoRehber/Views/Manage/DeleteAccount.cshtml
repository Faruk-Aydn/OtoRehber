@model OtoRehber.Models.DeleteAccountViewModel
@{
    ViewData["Title"] = "Hesabı sil";
}
<div class="max-w-md mx-auto py-12">
    <div class="bg-white dark:bg-gray-800 border border-red-200 dark:border-red-900/40 rounded-2xl shadow-sm p-8">
        <h1 class="text-2xl font-bold text-red-600 dark:text-red-400 mb-2">Hesabı sil</h1>
        <p class="text-sm text-gray-600 dark:text-gray-300 mb-6">
            Bu işlem <strong>geri alınamaz</strong>. Hesabınız, yorumlarınız ve garajınızdaki araçlar
            kalıcı olarak silinir.
        </p>

        <form asp-action="DeleteAccount" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
                <input asp-for="Password" class="w-full p-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900 rounded-lg focus:ring-red-500 focus:border-red-500 text-sm" />
                <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
            </div>
            <label class="flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
                <input asp-for="Confirm" type="checkbox" class="mt-0.5 w-4 h-4 text-red-600 border-gray-300 rounded focus:ring-red-500" />
                <span>Hesabımın ve tüm verilerimin kalıcı olarak silineceğini anlıyorum.</span>
            </label>
            <span asp-validation-for="Confirm" class="text-red-500 text-xs block"></span>

            <button type="submit" class="w-full text-white bg-red-600 hover:bg-red-700 font-bold rounded-lg text-sm px-5 py-3 transition">
                Hesabımı kalıcı olarak sil
            </button>
        </form>

        <div class="mt-6 text-center text-sm">
            <a asp-action="Index" class="text-gray-500 hover:text-primary">Vazgeç, hesabıma dön</a>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
