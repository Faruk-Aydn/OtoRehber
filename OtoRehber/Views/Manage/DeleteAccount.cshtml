@model OtoRehber.Models.DeleteAccountViewModel
@{
    ViewData["Title"] = "Hesabı sil";
}
<div class="max-w-md mx-auto py-12">
    <div class="card card-pad border-red-200 dark:border-red-900/40">
        <h1 class="text-2xl font-bold text-red-600 dark:text-red-400 tracking-tight mb-2">Hesabı sil</h1>
        <p class="text-sm text-content-muted mb-6">
            Bu işlem <strong class="text-content">geri alınamaz</strong>. Hesabınız, yorumlarınız ve garajınızdaki araçlar kalıcı olarak silinir.
        </p>

        <form asp-action="DeleteAccount" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>
            <div>
                <label asp-for="Password" class="label"></label>
                <input asp-for="Password" class="input focus:border-red-500 focus:ring-red-500/30" />
                <span asp-validation-for="Password" class="form-error"></span>
            </div>
            <label class="flex items-start gap-2 text-sm text-content">
                <input asp-for="Confirm" type="checkbox" class="mt-0.5 w-4 h-4 accent-red-600 rounded" />
                <span>Hesabımın ve tüm verilerimin kalıcı olarak silineceğini anlıyorum.</span>
            </label>
            <span asp-validation-for="Confirm" class="form-error block"></span>

            <button type="submit" class="btn-danger w-full">Hesabımı kalıcı olarak sil</button>
        </form>

        <div class="mt-6 text-center text-sm">
            <a asp-action="Index" class="text-content-muted hover:text-content">Vazgeç, hesabıma dön</a>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
