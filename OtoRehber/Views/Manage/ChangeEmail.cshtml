@model OtoRehber.Models.ChangeEmailViewModel
@{
    ViewData["Title"] = "E-posta değiştir";
}
<div class="max-w-md mx-auto py-12">
    <div class="card card-pad">
        <h1 class="text-2xl font-bold text-content tracking-tight mb-2">E-posta değiştir</h1>
        <p class="text-sm text-content-muted mb-6">
            Yeni adresinize bir doğrulama bağlantısı göndereceğiz. Bağlantıya tıklayana kadar mevcut adresiniz geçerli kalır.
        </p>

        <form asp-action="ChangeEmail" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>
            <div>
                <label asp-for="NewEmail" class="label"></label>
                <input asp-for="NewEmail" class="input" placeholder="yeni@eposta.com" />
                <span asp-validation-for="NewEmail" class="form-error"></span>
            </div>
            <button type="submit" class="btn-primary w-full">Doğrulama bağlantısı gönder</button>
        </form>

        <div class="mt-6 text-center text-sm">
            <a asp-action="Index" class="text-content-muted hover:text-content">Hesabıma dön</a>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
