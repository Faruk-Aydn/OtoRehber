@model OtoRehber.Models.ChangeEmailViewModel
@{
    ViewData["Title"] = "E-posta değiştir";
}
<div class="max-w-md mx-auto py-12">
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-sm p-8">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">E-posta değiştir</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
            Yeni adresinize bir doğrulama bağlantısı göndereceğiz. Bağlantıya tıklayana kadar mevcut adresiniz geçerli kalır.
        </p>

        <form asp-action="ChangeEmail" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
            <div>
                <label asp-for="NewEmail" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"></label>
                <input asp-for="NewEmail" class="w-full p-2.5 border border-gray-300 dark:border-gray-600 dark:bg-gray-900 rounded-lg focus:ring-primary focus:border-primary text-sm" placeholder="yeni@eposta.com" />
                <span asp-validation-for="NewEmail" class="text-red-500 text-xs"></span>
            </div>
            <button type="submit" class="w-full text-white bg-primary hover:bg-blue-700 font-bold rounded-lg text-sm px-5 py-3 transition">Doğrulama bağlantısı gönder</button>
        </form>

        <div class="mt-6 text-center text-sm">
            <a asp-action="Index" class="text-gray-500 hover:text-primary">Hesabıma dön</a>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
