<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OtoRehber.Domain\OtoRehber.Domain.csproj" />
  </ItemGroup>

  <!-- ASP.NET Core API'leri (Identity, DataProtection vb.) shared framework'ten gelir.
       Böylece runtime ile aynı sürüm kullanılır; uygulama klasörüne sürüm uyumsuz
       kopyalar konmaz (bu, DataProtection'da MissingMethodException'a yol açıyordu). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- IdentityDbContext + DataProtection key store — shared framework'te yok, ayrı paket (net8 ile aynı major). -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="YoutubeExplode" Version="6.6.0" />
    <!-- Güvenlik: YoutubeExplode'un transitively getirdiği AngleSharp 1.4.0 mXSS → 1.5.0 -->
    <PackageReference Include="AngleSharp" Version="1.5.0" />
  </ItemGroup>

</Project>
